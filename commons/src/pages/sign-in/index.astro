---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accountFromSession, requestSignIn, sameOrigin, SESSION_COOKIE } from '../../lib/auth';
import { getMailer, getStore, selfOrigin } from '../../lib/runtime';

/* Sign-in touches a database and sets a cookie, so it cannot be prerendered. */
export const prerender = false;

const store = getStore();
const origin = selfOrigin(Astro.request);
const existing = await accountFromSession(store, Astro.cookies.get(SESSION_COOKIE)?.value);
if (existing) return Astro.redirect('/account');

let sent = false;
let rejected = false;

if (Astro.request.method === 'POST') {
	/*
	 * Origin check first. SameSite=Lax already stops a cross-site POST in any
	 * browser that honours it; this is the defence that does not depend on the
	 * browser getting it right, and it costs one header read.
	 */
	if (!sameOrigin(Astro.request, origin)) {
		return new Response('Bad request', { status: 400 });
	}

	const form = await Astro.request.formData();
	const email = String(form.get('email') ?? '');

	/*
	 * A honeypot, not a captcha. A captcha is a third-party script that watches
	 * the reader, on a site whose proposition is that it collects nothing. This
	 * catches the automation that actually turns up to a form like this one, and
	 * costs a reader nothing.
	 */
	const trap = String(form.get('website') ?? '');

	if (!trap) {
		const request = await requestSignIn(store, email, origin);
		if (request) {
			try {
				await getMailer().sendSignInLink(request.email, request.url);
			} catch (error) {
				/* Never log the address or the link. */
				console.error('sign-in mail failed', error instanceof Error ? error.message : error);
				rejected = true;
			}
		}
	}

	/*
	 * The same page whether the address exists, is rate limited, is malformed,
	 * or tripped the honeypot. Anything else turns this form into an oracle for
	 * "does this person contribute here", which on a site about people's
	 * insurance problems is a real disclosure rather than a theoretical one.
	 * `rejected` is set only when our own mail provider failed, which is our
	 * fault and says nothing about the address.
	 */
	sent = !rejected;
}
---

<BaseLayout
	title="Sign in"
	eyebrow="Sign in"
	lede={sent ? undefined : 'One address, no password. We send a link that works once.'}
	crumbs={[{ name: 'Home', href: '/' }, { name: 'Sign in' }]}
>
	<section class="band band-tight">
		<div class="shell page-grid">
			<div class="prose">
				{
					sent ? (
						<>
							<h2>Check your email</h2>
							<p>
								If that address can sign in, a link is on its way. It works once and expires in
								fifteen minutes.
							</p>
							<p>
								Nothing has been created yet if this is your first visit — the account is made when
								you follow the link, not when you type the address.
							</p>
						</>
					) : (
						<>
							{rejected && (
								<div class="callout" data-tone="stop">
									<h3>That did not send</h3>
									<p>
										Our mail provider refused the message. That is a fault on our side and says
										nothing about the address you typed. Try again in a minute.
									</p>
								</div>
							)}

							<form method="post" style="max-width: 32rem">
								<label for="email" style="display: block; margin-bottom: var(--s-2)">
									<strong>Your email address</strong>
								</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									autocomplete="email"
									inputmode="email"
									style="width: 100%; padding: var(--s-3); font: inherit; border: var(--bw-hair) solid var(--line-strong); border-radius: var(--r-2); background: var(--white)"
								/>

								{/* Honeypot. Hidden from people, offered to automation. */}
								<div aria-hidden="true" style="position:absolute; left:-9999px" >
									<label for="website">Leave this empty</label>
									<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
								</div>

								<button
									type="submit"
									style="margin-top: var(--s-4); padding: var(--s-3) var(--s-5); font: inherit; color: var(--white); background: var(--link); border: 0; border-radius: var(--r-2); cursor: pointer"
								>
									Email me a link
								</button>
							</form>

							<h2>What signing in does and does not do</h2>
							<ul>
								<li>
									<strong>There is no password.</strong> A password is a second secret to store,
									leak and reset, and the email round trip verifies the same thing either way.
								</li>
								<li>
									<strong>The link works once</strong> and expires in fifteen minutes. Email gets
									forwarded and scanned; a link that still works the second time is one anybody
									downstream of your inbox can use.
								</li>
								<li>
									<strong>An account holds three things:</strong> your address, a display name you
									choose, and — if you are a licensed practitioner — a licence number we check
									against the regulator's public register.
								</li>
								<li>
									<strong>We only ever email sign-in links.</strong> No newsletter, no digest, no
									notification that somebody replied.
								</li>
							</ul>

							<p>
								<a href="/contribute">What is never collected</a>, in full, and why the fields do
								not exist rather than being switched off.
							</p>
						</>
					)
				}
			</div>

			<aside aria-label="About accounts">
				<div class="rail-block">
					<h2>Stored about you</h2>
					<ul>
						<li>Your email address</li>
						<li>A display name</li>
						<li>A licence number, if you have one</li>
					</ul>
				</div>
				<div class="rail-block">
					<h2>Never stored</h2>
					<ul>
						<li>A password</li>
						<li>Any document</li>
						<li>Policy or claim numbers</li>
						<li>Date of birth or government id</li>
						<li>A payment method</li>
					</ul>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
