---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SESSION_COOKIE, accountFromSession, sameOrigin } from '../lib/auth';
import { isModerator } from '../lib/moderators';
import { getStore, selfOrigin } from '../lib/runtime';
import { WITHDRAWABLE_IMMEDIATELY } from '../lib/store';

export const prerender = false;

const store = getStore();
const sessionId = Astro.cookies.get(SESSION_COOKIE)?.value;
let account = await accountFromSession(store, sessionId);

if (!account) return Astro.redirect('/sign-in', 303);

let saved = false;
let problem = '';

if (Astro.request.method === 'POST') {
	if (!sameOrigin(Astro.request, selfOrigin(Astro.request))) {
		return new Response('Bad request', { status: 400 });
	}
	const form = await Astro.request.formData();
	const displayName = String(form.get('displayName') ?? '').trim();

	if (displayName.length < 2 || displayName.length > 60) {
		problem = 'A display name needs to be between 2 and 60 characters.';
	} else {
		await store.setDisplayName(account.email, displayName);
		account = await store.getAccount(account.email);
		saved = true;
	}
}

const welcome = Astro.url.searchParams.get('welcome') === '1';
const submissions = account ? await store.submissionsBy(account.email) : [];
const moderates = isModerator(account?.email, process.env);

const STATE_TEXT: Record<string, string> = {
	pending: 'With a moderator. Nothing publishes until it has been read.',
	published: 'Published. It is live once the moderator has committed the file.',
	'needs-more': 'Sent back with questions. Read the note below.',
	declined: 'Not published. The note below says why.',
	'withdrawal-requested':
		'You have asked for this to be taken down. It stays up until a moderator removes the file, which is usually the same day.',
	withdrawn: 'Withdrawn at your request. It is no longer published.',
};

const notice = Astro.url.searchParams;
/* A published report can only be requested, not pulled on the spot, because it
   is a file somebody has to remove. Saying which is the difference between an
   honest confirmation and one that is not yet true. */
const canWithdraw = (state: string) => WITHDRAWABLE_IMMEDIATELY.includes(state as never) || state === 'published';
---

<BaseLayout
	title="Your account"
	eyebrow="Account"
	crumbs={[{ name: 'Home', href: '/' }, { name: 'Account' }]}
>
	<section class="band band-tight">
		<div class="shell page-grid">
			<div class="prose">
				{
					welcome && !account?.displayName && (
						<div class="callout">
							<h3>You are signed in</h3>
							<p>
								One thing to set before you can contribute anything: a display name. It is what
								appears on a report or a note, and it is the only part of your account anybody
								else ever sees.
							</p>
						</div>
					)
				}

				{saved && <div class="callout"><p>Saved.</p></div>}
				{notice.has('withdrawn') && (
					<div class="callout"><p>Withdrawn. It is no longer published and nothing more is needed from you.</p></div>
				)}
				{notice.has('withdrawal-requested') && (
					<div class="callout">
						<p>
							Asked for. The report stays up until a moderator removes the file, which is usually
							the same day. Its address will keep working afterwards and will say it was
							withdrawn, so anybody who cited it sees what happened rather than a dead link.
						</p>
					</div>
				)}
				{notice.has('withdrawal-noop') && (
					<div class="callout"><p>Nothing to withdraw — that one is not published.</p></div>
				)}
				{problem && <div class="callout" data-tone="stop"><p>{problem}</p></div>}

				<h2>Display name</h2>
				<form method="post" style="max-width: 32rem">
					<label for="displayName" style="display: block; margin-bottom: var(--s-2)">
						What should appear on anything you contribute
					</label>
					<input
						type="text"
						id="displayName"
						name="displayName"
						value={account?.displayName ?? ''}
						required
						minlength="2"
						maxlength="60"
						autocomplete="nickname"
						style="width: 100%; padding: var(--s-3); font: inherit; border: var(--bw-hair) solid var(--line-strong); border-radius: var(--r-2); background: var(--white)"
					/>
					<button
						type="submit"
						style="margin-top: var(--s-4); padding: var(--s-3) var(--s-5); font: inherit; color: var(--white); background: var(--link); border: 0; border-radius: var(--r-2); cursor: pointer"
					>
						Save
					</button>
				</form>
				<p style="font-size: var(--text-sm); color: var(--muted)">
					It does not have to be your legal name. It does have to be a name a reader can weigh —
					an account attributed to nobody in particular is one nobody can cite.
				</p>

				<h2>Everything this account holds</h2>
				<p>
					This is the whole of it. Not a summary of it, and not the fields we chose to show
					you — the record has no other columns, which is the only version of that promise
					worth making.
				</p>
				<dl class="fields">
					<div>
						<dt>Email</dt>
						<dd>{account?.email}</dd>
					</div>
					<div>
						<dt>Display name</dt>
						<dd>{account?.displayName || 'Not set'}</dd>
					</div>
					<div>
						<dt>Role</dt>
						<dd>{account?.kind}</dd>
					</div>
					<div>
						<dt>Account created</dt>
						<dd>{account?.createdAt?.slice(0, 10)}</dd>
					</div>
					{
						account?.license && (
							<div>
								<dt>Verified licence</dt>
								<dd>
									{account.license.number} ({account.license.authority}), checked against{' '}
									<a href={account.license.verifiedAgainst} rel="noopener">the public register</a>{' '}
									on {account.license.verifiedOn}
								</dd>
							</div>
						)
					}
				</dl>

				<h2>Contributing</h2>
				{
					account?.displayName ? (
						<p>
							<a href="/contribute/new">Write a case report</a>. It is worth reading{' '}
							<a href="/standards">what a published report has to contain</a> first — most of the
							work is in the fields rather than the prose.
						</p>
					) : (
						<p>Set a display name above first. A report is published under a name, and an unattributed account is not citable by anybody.</p>
					)
				}

				{
					submissions.length > 0 && (
						<>
							<h3>What you have sent</h3>
							<div class="rows">
								{submissions.map((submission) => (
									<div class="row">
										<h4 class="row-title">{submission.title}</h4>
										<div class="row-meta">
											<span class="label" data-group={submission.state === 'published' ? 'record' : 'note'}>
												{submission.state}
											</span>
											<span>sent {submission.submittedAt.slice(0, 10)}</span>
										</div>
										<p style="margin-top: var(--s-2); font-size: var(--text-sm); color: var(--muted)">
											{STATE_TEXT[submission.state]}
										</p>
										{/* Only where the note is the operative message. The note kept
										    from a publication decision is still on the record - it is
										    deliberately not overwritten by a later withdrawal - but
										    showing "Withdrawn at your request" above "From the
										    moderator: Published." reads as a contradiction. */}
										{submission.moderatorNote &&
											(submission.state === 'needs-more' || submission.state === 'declined') && (
												<p style="margin-top: var(--s-2); font-size: var(--text-sm)">
													<strong>From the moderator:</strong> {submission.moderatorNote}
												</p>
											)}
										{canWithdraw(submission.state) && (
											<form method="post" action="/contribute/withdraw" style="margin-top: var(--s-3)">
												<input type="hidden" name="id" value={submission.id} />
												<button
													type="submit"
													style="padding: var(--s-2) var(--s-4); font: inherit; font-size: var(--text-sm); color: var(--stop); background: var(--white); border: var(--bw-hair) solid var(--stop); border-radius: var(--r-2); cursor: pointer"
												>
													{submission.state === 'published' ? 'Ask for this to be taken down' : 'Withdraw this'}
												</button>
												<span class="meta" style="margin-left: var(--s-3)">No reason needed.</span>
											</form>
										)}
									</div>
								))}
							</div>
						</>
					)
				}

				{moderates && (
					<>
						<h2>Moderation</h2>
						<p>You are a moderator on this deployment. <a href="/moderate">Open the queue</a>.</p>
					</>
				)}

				<h2>Signing out</h2>
				<form method="post" action="/sign-out">
					<button
						type="submit"
						style="padding: var(--s-3) var(--s-5); font: inherit; color: var(--ink); background: var(--white); border: var(--bw-hair) solid var(--line-strong); border-radius: var(--r-2); cursor: pointer"
					>
						Sign out
					</button>
				</form>
			</div>

			<aside aria-label="Your account">
				<div class="rail-block">
					<h2>Never stored</h2>
					<ul>
						<li>A password</li>
						<li>Any document</li>
						<li>Policy or claim numbers</li>
						<li>Date of birth or government id</li>
						<li>Health information</li>
						<li>A payment method</li>
					</ul>
				</div>
				<div class="rail-block">
					<h2>Related</h2>
					<ul>
						<li><a href="/contribute">What contributing involves</a></li>
						<li><a href="/standards">Standards</a></li>
						<li><a href="/moderation">Moderation</a></li>
					</ul>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>
