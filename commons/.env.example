# Copy these names into the Vercel project environment settings. Do not commit
# real values. Production values belong in Vercel, not in a checked-in file.

COMMONS_ENV=production
PUBLIC_COMMONS_ORIGIN=https://commons.birch.insure
PUBLIC_RECORD_ORIGIN=https://birch.insure

# Provision a managed Postgres database, then apply schema.sql once.
COMMONS_DATABASE_URL=postgresql://user:password@host.example/commons

# Verify birch.insure (or the chosen sending domain) in Resend first.
RESEND_API_KEY=re_replace_me
COMMONS_MAIL_FROM=Birch <hello@birch.insure>

# At least one real moderator mailbox. Separate multiple addresses with commas.
COMMONS_MODERATORS=moderator@example.com
