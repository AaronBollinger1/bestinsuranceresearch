---
import { ArrowRight, BadgeCheck, BookOpen, Building2, Flag, LockKeyhole, Search, ShieldCheck, UserRound } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Design', path: '/design/commons-preview' },
];

const threads = [
	{
		type: 'Experience',
		tone: 'experience',
		title: 'The renewal notice arrived before I understood what changed',
		body: 'A first-person account can show the timeline, the question asked, and the documents that another reader may want to check.',
		byline: 'Reader · identity protected in specimen',
		context: 'California · homeowners',
		icon: UserRound,
	},
	{
		type: 'Professional note',
		tone: 'professional',
		title: 'What a “claims-made” date changes in the research record',
		body: 'A credentialed perspective is useful when it names its role, jurisdiction, sources, and conflicts without pretending to decide a specific policy.',
		byline: 'Licensed professional · verification pending in specimen',
		context: 'Professional liability · source attached',
		icon: BadgeCheck,
	},
	{
		type: 'Company response',
		tone: 'company',
		title: 'A published response can add context without deleting the account',
		body: 'Official replies belong in their own lane. They can identify a process or correction, but they do not rewrite a person’s experience or the citable record.',
		byline: 'Organization account · domain verification required in specimen',
		context: 'Company page · attributed response',
		icon: Building2,
	},
];

const rooms = [['All conversations',''], ['Homeowners','homeowners'], ['Auto','auto'], ['Business insurance','professional'], ['Life and health','health']];
const flow = [
	['01', 'Read', 'Open the cited research first.'],
	['02', 'Discuss', 'Ask what the record does not answer.'],
	['03', 'Verify', 'Attach role, company, or policy context only when needed.'],
	['04', 'Review', 'Moderation checks provenance, privacy, and conflicts.'],
];
---

<BaseLayout
	title="Community product specimen"
	description="Internal Birch Community design specimen showing the future forum, thread, professional, company response, and moderation experience."
	noindex
	pageType="editorial"
>
	<section class="band band-first band-paper commons-product-hero" aria-labelledby="commons-product-title">
		<div class="shell">
			<Breadcrumbs trail={trail} />
			<div class="commons-product-intro">
				<div>
					<div class="commons-product-kicker"><span class="eyebrow">Birch Community</span><span class="status status-plain">Private product preview</span></div>
					<h1 id="commons-product-title">Let's talk insurance.</h1>
					<p class="lede">Questions, first-hand experiences, and professional perspectives.</p>
					<div class="commons-preview-actions">
						<a class="btn btn-primary" href="/design/thread-preview">Open a thread <ArrowRight size={15} aria-hidden="true" /></a>
						<a class="btn btn-secondary" href="/ask">Read the research</a>
						<a class="btn btn-quiet" href="/professionals">For professionals</a>
					</div>
				</div>

			</div>
			<div class="commons-preview-boundary"><LockKeyhole size={16} aria-hidden="true" /><span><strong>No live activity.</strong> These are illustrative interface states, not posts, counts, endorsements, ratings, or company participation.</span></div>
		</div>
	</section>

	<section class="band band-tight band-paper" aria-labelledby="commons-preview-title">
		<div class="shell">
			<div class="commons-preview-shell">
				<aside class="commons-preview-sidebar" aria-label="Community room navigation">
					<div class="commons-preview-sidebar-head">
						<span class="eyebrow">Birch Community</span>
						<strong>Find the right room.</strong>
					</div>
					<label class="commons-preview-search">
						<Search size={15} aria-hidden="true" />
						<span class="u-visually-hidden">Search Community specimen</span>
						<input id="community-specimen-search" type="search" aria-label="Search Community specimen" placeholder="Search example threads" disabled />
					</label>
					<nav class="commons-preview-rooms" aria-label="Conversation rooms">
						{rooms.map(([label,query],index) => <button type="button" data-community-room={query} aria-pressed={index === 0} disabled>{label}</button>)}
					</nav>
					<div class="commons-preview-sidebar-note">
						<span class="meta">No popularity ranking</span>
						<p>Rooms sort by recency, evidence state, and moderation—not by a reputation score.</p>
					</div>
				</aside>

				<div class="commons-preview-main" id="threads" role="region" aria-labelledby="commons-preview-title">
					<div class="commons-preview-main-head">
						<div>
							<span class="eyebrow">Conversation room / specimen</span>
							<h2 id="commons-preview-title">Questions, experiences, and replies.</h2>
							<p>Every durable conversation carries a type, author context, moderation state, and a path back to research.</p>
						</div>
						<span class="status status-plain">Future / gated</span>
					</div>

					<div class="commons-preview-composer"><strong>Have a question or experience?</strong><a class="btn btn-secondary btn-sm" href="/contribute">Prepare a contribution <ArrowRight size={14} aria-hidden="true" /></a><p class="mono">Private draft only. No public posting is enabled.</p></div>

					<div class="community-feed-filters" role="group" aria-label="Filter example conversations" hidden>
						{[['all','All'],['experience','Experiences'],['professional','Professional notes'],['company','Company replies']].map(([value,label]) => <button type="button" data-community-filter={value} aria-pressed={value === 'all'}>{label}</button>)}
					</div>
					<p id="community-specimen-status" class="community-feed-status" role="status" aria-live="polite">Illustrative examples · not live posts</p>
					<div class="commons-preview-thread-list" aria-label="Illustrative conversation threads">
						{threads.map((thread) => {
							const Icon = thread.icon;
							return (
								<article class={`commons-preview-thread commons-preview-thread-${thread.tone}`} data-specimen-thread={thread.tone} data-specimen-search={`${thread.title} ${thread.body} ${thread.context}`}>
									<div class="commons-preview-thread-top">
										<span class={`commons-preview-type ${thread.tone}`}><Icon size={14} aria-hidden="true" /> {thread.type}</span>
										<span class="meta">Specimen state</span>
									</div>
									<h3><a href={`/design/thread-preview${thread.tone === 'professional' ? '#professional-reply' : thread.tone === 'company' ? '#company-response' : ''}`}>{thread.title}</a></h3>
									<p>{thread.body}</p>
									<div class="commons-preview-thread-foot">
										<span>{thread.byline}</span>
										<span>{thread.context}</span>
										<a href="/methodology">How this is handled <ArrowRight size={14} aria-hidden="true" /></a>
									</div>
								</article>
							);
						})}
					</div>
				</div>

				<aside class="commons-preview-context" aria-label="Conversation context rail">
					<div class="commons-preview-context-card">
						<span class="eyebrow">Research stays primary</span>
						<h3>Keep the answer and the conversation separate.</h3>
						<p>A thread can ask for clarification or add lived context. It cannot silently change a cited research page.</p>
						<a class="text-link" href="/methodology">Read the boundary <ArrowRight size={14} aria-hidden="true" /></a>
					</div>
					<div class="commons-preview-context-card">
						<span class="eyebrow">Contribution signals</span>
						<ul class="commons-preview-checks">
							<li><BookOpen size={15} aria-hidden="true" /><span>Source attached where a claim is made.</span></li>
							<li><ShieldCheck size={15} aria-hidden="true" /><span>Role and affiliation visible when relevant.</span></li>
							<li><Flag size={15} aria-hidden="true" /><span>Report, correction, and withdrawal paths stay available.</span></li>
						</ul>
					</div>
					<div class="commons-preview-context-card commons-preview-coverage-card">
						<span class="eyebrow">Future / Your Coverage</span>
						<h3>Ask about your setup privately.</h3>
						<p>When enabled, a private workspace can redact policy pages locally before a person chooses whether to request professional context.</p>
						<span class="meta">Canopy Connect or document verification · not enabled</span>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<section class="band band-tight" aria-labelledby="commons-flow-title">
		<div class="shell">
			<div class="band-head">
				<div>
					<span class="eyebrow">The conversation protocol</span>
					<h2 id="commons-flow-title">The path from a question to useful context.</h2>
					<p>Progressive disclosure keeps the social layer approachable while the backend enforces the hard parts: provenance, privacy, moderation, and attribution.</p>
				</div>
				<a class="btn btn-secondary btn-sm" href="/contribute">Contribution rules <ArrowRight size={14} aria-hidden="true" /></a>
			</div>
			<div class="commons-preview-flow">
				{flow.map(([number, title, detail]) => (
					<div class="commons-preview-flow-step">
						<span class="commons-preview-flow-number">{number}</span>
						<div><strong>{title}</strong><p>{detail}</p></div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band band-ink" aria-labelledby="commons-build-title">
		<div class="shell commons-preview-build">
			<div>
				<span class="eyebrow">Build gate</span>
				<h2 id="commons-build-title">The interface is ready before the community is.</h2>
				<p class="lede">This order lets Birch earn trust with the citable research core first, then add durable conversation only when the product can protect contributors and preserve the record.</p>
			</div>
			<div class="commons-preview-build-list">
				<div><span class="status status-established">Built</span><span>Research, citations, source ledger, tools</span></div>
				<div><span class="status status-plain">Next</span><span>Account, identity, moderation, notifications</span></div>
				<div><span class="status status-plain">Later</span><span>Policy verification, company response, reputation context</span></div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const feedSearch = document.querySelector<HTMLInputElement>('#community-specimen-search');
	const feedRows = [...document.querySelectorAll<HTMLElement>('[data-specimen-thread]')];
	const feedFilters = [...document.querySelectorAll<HTMLButtonElement>('[data-community-filter]')];
	const feedStatus = document.querySelector('#community-specimen-status');
	const roomButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-community-room]')];
	let feedType = 'all';
	function filterFeed() {
		const query = feedSearch?.value.trim().toLowerCase() || '';
		let count = 0;
		roomButtons.forEach(button => button.setAttribute('aria-pressed',String(button.dataset.communityRoom === query)));
		feedRows.forEach(row => {
			row.hidden = (feedType !== 'all' && row.dataset.specimenThread !== feedType) || !row.dataset.specimenSearch?.toLowerCase().includes(query);
			if (!row.hidden) count++;
		});
		feedFilters.forEach(button => button.setAttribute('aria-pressed',String(button.dataset.communityFilter === feedType)));
		if(feedStatus) feedStatus.textContent = count ? `${count} illustrative ${count === 1 ? 'example' : 'examples'} · not live posts` : 'No example matches. Clear the search or choose All.';
	}
	roomButtons.forEach(button => { button.disabled = false; button.addEventListener('click',() => { if(feedSearch) feedSearch.value = button.dataset.communityRoom || ''; feedType = 'all'; filterFeed(); }); });
	if(feedSearch) { feedSearch.disabled = false; feedSearch.addEventListener('input',filterFeed); }
	const filterGroup = document.querySelector<HTMLElement>('.community-feed-filters');
	if(filterGroup) filterGroup.hidden = false;
	feedFilters.forEach(button => button.addEventListener('click',() => { feedType = button.dataset.communityFilter || 'all'; filterFeed(); }));
</script>

<style>
	.community-feed-filters { display:flex; flex-wrap:wrap; gap:4px; margin-top:24px; border-bottom:1px solid var(--line); }
	.community-feed-filters[hidden], .commons-preview-thread[hidden] { display:none; }
	.community-feed-filters button { min-height:44px; border:0; border-bottom:2px solid transparent; background:transparent; padding:8px; color:var(--muted); font:500 var(--text-xs)/1.3 var(--font-sans); cursor:pointer; }
	.community-feed-filters button[aria-pressed="true"] { color:var(--brand-blue-text); border-bottom-color:var(--brand-blue); }
	.community-feed-status { color:var(--muted); font-size:var(--text-xs); margin:12px 0; }
	.commons-preview-search:focus-within { outline:2px solid var(--brand-blue); outline-offset:2px; }
	.commons-product-hero { padding-block: clamp(var(--s-5), 4vw, var(--s-8)) var(--s-5); }
	.commons-product-hero .crumbs { margin-bottom: var(--s-4); }
	.commons-product-hero .product-context-bar { margin-bottom: var(--s-5); }
	.commons-product-intro { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(var(--s-8), 6vw, var(--s-12)); align-items: center; }
	.commons-product-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
	.commons-product-kicker .eyebrow { margin: 0; }
	.commons-product-intro h1 { max-width: 24ch; margin: var(--s-3) 0; font: 600 clamp(2.1rem, 3.8vw, 3.2rem)/1.1 var(--font-sans); letter-spacing: -.045em; }
	.commons-product-intro .lede { max-width: 56ch; margin: 0; color: var(--body); }
	.commons-preview-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }
	.commons-product-rules { display: grid; gap: 1px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: var(--r-3); background: var(--line); box-shadow: var(--elev-1); }
	.commons-product-rules > div { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: var(--s-3); align-items: center; padding: var(--s-3) var(--s-4); background: var(--paper); }
	.commons-product-rules svg { color: var(--brand-blue-text); }
	.commons-product-rules strong, .commons-product-rules small { display: block; }
	.commons-product-rules strong { color: var(--ink); font-size: var(--text-sm); }
	.commons-product-rules small { margin-top: 2px; color: var(--muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
	.commons-preview-boundary { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-4); padding-top: var(--s-3); border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-xs); }
	.commons-preview-boundary svg { flex: 0 0 auto; color: var(--brand-blue-text); }
	.commons-preview-boundary strong { color: var(--ink); }
	.commons-preview-shell { display: grid; grid-template-columns: 190px minmax(0, 1fr) 260px; gap: 1px; border: 1px solid var(--line-strong); background: var(--line-strong); border-radius: var(--r-3); overflow: hidden; box-shadow: var(--elev-2); }
	.commons-preview-sidebar, .commons-preview-main, .commons-preview-context { min-width: 0; background: var(--paper); }
	.commons-preview-sidebar { padding: var(--s-4); }
	.commons-preview-sidebar-head { display: grid; gap: 3px; padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
	.commons-preview-sidebar-head .eyebrow { margin-bottom: 0; }
	.commons-preview-sidebar-head strong { color: var(--ink); font-size: var(--text-sm); }
	.commons-preview-search { display: flex; align-items: center; gap: 7px; margin-top: var(--s-4); padding: 7px 8px; border: 1px solid var(--line); border-radius: var(--r-2); color: var(--faint); background: var(--cream); }
	.commons-preview-search input { width: 100%; min-width: 0; padding: 0; border: 0; outline: 0; background: transparent; color: var(--muted); font-size: var(--text-xs); }
	.commons-preview-rooms { display: grid; gap: 3px; margin-top: var(--s-4); }
	.commons-preview-rooms button { min-height:44px; border:0; background:transparent; text-align:left; cursor:pointer; padding:8px; border-radius: var(--r-2); color: var(--muted); font-size: var(--text-sm); text-decoration: none; }
	.commons-preview-rooms button:hover, .commons-preview-rooms button:focus-visible, .commons-preview-rooms button[aria-pressed="true"] { background: var(--brand-blue-wash); color: var(--brand-blue-deep); }
	.commons-preview-sidebar-note { margin-top: var(--s-8); padding-top: var(--s-3); border-top: 1px solid var(--line); }
	.commons-preview-sidebar-note p { margin: var(--s-2) 0 0; color: var(--muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
	.commons-preview-main { padding: var(--s-5); }
	.commons-preview-main-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-4); padding-bottom: var(--s-5); border-bottom: 1px solid var(--line); }
	.commons-preview-main-head h2 { margin-bottom: var(--s-2); font-size: var(--text-2xl); }
	.commons-preview-main-head p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.commons-preview-composer { margin-top: var(--s-5); padding: var(--s-4); border: 1px dashed var(--line-strong); border-radius: var(--r-3); background: var(--cream); }
	.commons-preview-composer-top { display: flex; align-items: center; gap: var(--s-3); }
	.commons-preview-avatar { display: grid; place-items: center; width: 34px; height: 34px; flex: 0 0 auto; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: var(--font-mono); font-size: var(--text-sm); }
	.commons-preview-composer-top strong, .commons-preview-composer-top span { display: block; }
	.commons-preview-composer-top strong { color: var(--ink); font-size: var(--text-sm); }
	.commons-preview-composer-top span { margin-top: 2px; color: var(--muted); font-size: var(--text-xs); }
	.commons-preview-composer-controls { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
	.commons-preview-composer .mono { margin: var(--s-3) 0 0; font-size: var(--text-2xs); }
	.commons-preview-thread-list { display: grid; gap: var(--s-3); margin-top: var(--s-5); }
	.commons-preview-thread { padding: var(--s-4); border: 1px solid var(--line); border-left: 3px solid var(--line-strong); border-radius: var(--r-3); background: var(--paper); transition: transform var(--dur-2) var(--ease-soft), box-shadow var(--dur-2) var(--ease), border-color var(--dur-1) var(--ease); }
	.commons-preview-thread:hover { border-color: var(--brand-blue); background:var(--brand-blue-wash); }
	.commons-preview-thread-experience { border-left-color: var(--gold-edge); }
	.commons-preview-thread-professional { border-left-color: var(--brand-blue); }
	.commons-preview-thread-company { border-left-color: var(--green); }
	.commons-preview-thread-top, .commons-preview-thread-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2); }
	.commons-preview-type { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: var(--text-2xs); letter-spacing: .03em; text-transform: uppercase; }
	.commons-preview-type.experience { color: var(--gold-text); }
	.commons-preview-type.professional { color: var(--brand-blue-text); }
	.commons-preview-type.company { color: var(--green-text); }
	.commons-preview-thread h3 { margin: var(--s-3) 0 var(--s-2); font-family: var(--font-sans); font-size: var(--text-lg); font-weight: 600; line-height: var(--leading-snug); }
	.commons-preview-thread h3 a { color: inherit; text-decoration: none; }
	.commons-preview-thread h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
	.commons-preview-thread > p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.commons-preview-thread-foot { margin-top: var(--s-4); padding-top: var(--s-3); border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-2xs); }
	.commons-preview-thread-foot a { display: inline-flex; align-items: center; gap: 4px; color: var(--brand-blue-text); font-weight: 600; text-decoration: none; }
	.commons-preview-thread-foot a:hover { color: var(--ink); }
	.commons-preview-context { display: grid; align-content: start; gap: 1px; background: var(--line); }
	.commons-preview-context-card { padding: var(--s-5); background: var(--paper); }
	.commons-preview-context-card h3 { margin-bottom: var(--s-2); font-size: var(--text-lg); }
	.commons-preview-context-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.commons-preview-context-card .text-link { display: inline-flex; align-items: center; gap: 5px; margin-top: var(--s-4); color: var(--brand-blue-text); font-size: var(--text-sm); font-weight: 600; text-decoration: none; }
	.commons-preview-checks { display: grid; gap: var(--s-3); padding: 0; margin: var(--s-4) 0 0; list-style: none; }
	.commons-preview-checks li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: var(--s-2); color: var(--body); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.commons-preview-checks svg { color: var(--brand-blue-text); margin-top: 1px; }
	.commons-preview-coverage-card { border-top: 3px solid var(--gold-edge); }
	.commons-preview-coverage-card .meta { display: block; margin-top: var(--s-4); line-height: var(--leading-snug); }
	.commons-preview-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin-top: var(--s-6); border-top: 1px solid var(--line-strong); }
	.commons-preview-flow-step { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: var(--s-3); padding: var(--s-4) var(--s-4) 0 0; }
	.commons-preview-flow-step + .commons-preview-flow-step { padding-left: var(--s-4); border-left: 1px solid var(--line); }
	.commons-preview-flow-number { color: var(--gold-text); font-family: var(--font-mono); font-size: var(--text-xs); }
	.commons-preview-flow-step strong { color: var(--ink); font-size: var(--text-sm); }
	.commons-preview-flow-step p { margin: 3px 0 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.commons-preview-build { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 420px); gap: var(--s-12); align-items: center; }
	.commons-preview-build h2 { max-width: 18ch; }
	.commons-preview-build-list { display: grid; gap: var(--s-3); }
	.commons-preview-build-list div { display: flex; align-items: center; gap: var(--s-3); padding-bottom: var(--s-3); border-bottom: 1px solid var(--line-ink); color: #dce2e9; font-size: var(--text-sm); }
