---
import { ArrowRight, CircleDot, GitCompareArrows, MapPin } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import CorrectionControl from '../../components/CorrectionControl.astro';
import Handoff from '../../components/Handoff.astro';
import SourceLedger from '../../components/SourceLedger.astro';
import StatusChip from '../../components/StatusChip.astro';
import { createCiter, stripMarkers } from '../../lib/citations';
import { idsOf, ledgerFor, loadCorpus } from '../../lib/corpus';
import { longDate } from '../../lib/cite';
import { breadcrumbs, graph, organization, techArticle, website } from '../../lib/schema';
import { TODAY } from '../../lib/today';

export const getStaticPaths = (async () => {
	const corpus = await loadCorpus();
	return corpus.questions.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, corpus },
	}));
}) satisfies GetStaticPaths;

const { entry, corpus } = Astro.props;
const d = entry.data;
const path = `/questions/${entry.id}`;
const machinePath = `${path}.json`;

const sourceIds = idsOf(d.sourceIds);
const sources = ledgerFor(sourceIds, corpus.sourceById, `question "${entry.id}"`);
const cite = createCiter(sourceIds, `question "${entry.id}"`);

const related = d.related
	.map((ref) => corpus.questionBySlug.get(ref.id))
	.filter((q): q is NonNullable<typeof q> => Boolean(q));
const relatedCoverages = d.coverages
	.map((ref) => corpus.coverageBySlug.get(ref.id))
	.filter((c): c is NonNullable<typeof c> => Boolean(c));
const relatedCompanies = d.companies
	.map((ref) => corpus.companyBySlug.get(ref.id))
	.filter((c): c is NonNullable<typeof c> => Boolean(c));
const relatedStates = corpus.states.filter((s) => d.states.includes(s.data.code));

const description = stripMarkers(d.shortAnswer).slice(0, 300);

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Questions', path: '/questions' },
	{ name: d.question, path },
];

const sections = [
	{ id: 'assumes', label: 'What this assumes' },
	{ id: 'why', label: 'Why this is the answer' },
	{ id: 'changes', label: 'What changes the answer' },
	{ id: 'variability', label: 'Where it varies' },
	{ id: 'actions', label: 'Next actions' },
	{ id: 'source-ledger', label: 'Source ledger' },
	...(related.length ? [{ id: 'related', label: 'Related questions' }] : []),
];

const jsonLd = graph(
	organization(),
	website(),
	breadcrumbs(trail),
	techArticle({
		headline: d.question,
		path,
		description,
		datePublished: d.effectiveDate,
		dateModified: d.lastReviewed,
		author: d.author,
		reviewer: d.reviewer,
		sections: sections.map((s) => s.label),
		about: [...d.lines, ...d.topics],
		citations: sources.map((s) => ({ name: s.data.title, url: s.data.url, publisher: s.data.publisher })),
	}),
);

const author = corpus.personByName.get(d.author);
const reviewer = corpus.personByName.get(d.reviewer);
---

<BaseLayout
	title={d.question}
	description={description}
	jsonLd={jsonLd}
	pageType="question"
	machinePath={machinePath}
>
	<article>
		<header class="band band-first band-paper answer-head">
			<div class="shell">
				<div style="margin-bottom: var(--s-4)"><Breadcrumbs trail={trail} /></div>

				<div class="answer-flags">
					<StatusChip kind={d.confidence} />
					<StatusChip kind={d.reviewState} />
					<span class="meta">{d.family} lines</span>
					{d.states.length > 0 && (
						<span class="meta">
							<MapPin size={11} aria-hidden="true" style="display:inline-block;vertical-align:-1px" />{' '}
							{d.states.join(', ')}
						</span>
					)}
				</div>

				<h1>{d.question}</h1>

				<dl class="answer-dates">
					<div>
						<dt>Effective</dt>
						<dd><time datetime={d.effectiveDate}>{longDate(d.effectiveDate)}</time></dd>
					</div>
					<div>
						<dt>Last reviewed</dt>
						<dd><time datetime={d.lastReviewed}>{longDate(d.lastReviewed)}</time></dd>
					</div>
					<div>
						<dt>Author</dt>
						<dd>{author ? <a href={`/authors/${author.id}`}>{d.author}</a> : d.author}</dd>
					</div>
					<div>
						<dt>Reviewer</dt>
						<dd>{reviewer ? <a href={`/authors/${reviewer.id}`}>{d.reviewer}</a> : d.reviewer}</dd>
					</div>
					<div>
						<dt>Sources</dt>
						<dd><a href="#source-ledger">{sources.length} records</a></dd>
					</div>
				</dl>
			</div>
		</header>

		<div class="band band-tight">
			<div class="shell answer-grid">
				<div>
					<section aria-labelledby="direct-answer-title">
						<h2 id="direct-answer-title" class="u-visually-hidden">Direct answer</h2>
						<div class="direct-answer">
							<p set:html={cite.inline(d.shortAnswer)} />
						</div>
					</section>

					{
						d.reviewState === 'corrected' && d.correction && (
							<Callout tone="note" label="Correction">
								<p>
									<strong>Corrected {longDate(d.correction.date)}.</strong> This page previously said:{' '}
									{d.correction.was} It now says: {d.correction.now}
								</p>
							</Callout>
						)
					}

					{
						d.confidence === 'disputed' && (
							<Callout tone="warn">
								<p>
									Competent sources disagree on part of this answer, or the point is being litigated.
									Read the source ledger before you rely on it, and treat the outcome in a specific
									matter as unresolved.
								</p>
							</Callout>
						)
					}

					{
						d.confidence === 'changing' && (
							<Callout tone="warn">
								<p>
									A statute, regulation, or filing in this area is actively changing. Check the effective
									dates in the source ledger against your own timeline.
								</p>
							</Callout>
						)
					}

					<section class="answer-section" aria-labelledby="assumes">
						<h2 id="assumes">What this assumes</h2>
						<ul class="fact-list">
							{
								d.assumes.map((item) => (
									<li>
										<CircleDot size={14} aria-hidden="true" />
										<p set:html={cite.inline(item)} />
									</li>
								))
							}
						</ul>
					</section>

					<section class="answer-section prose" aria-labelledby="why">
						<h2 id="why">Why this is the answer</h2>
						<div set:html={cite.paragraphs(d.why)} />
					</section>

					<section class="answer-section" aria-labelledby="changes">
						<h2 id="changes">What changes the answer</h2>
						<ul class="fact-list">
							{
								d.whatChanges.map((item) => (
									<li>
										<GitCompareArrows size={14} aria-hidden="true" />
										<p set:html={cite.inline(item)} />
									</li>
								))
							}
						</ul>
					</section>

					<section class="answer-section" aria-labelledby="variability">
						<h2 id="variability">Where it varies by state, form, carrier, or fact</h2>
						<ul class="fact-list">
							{
								d.variability.map((item) => (
									<li>
										<MapPin size={14} aria-hidden="true" />
										<p set:html={cite.inline(item)} />
									</li>
								))
							}
						</ul>
					</section>

					<section class="answer-section" aria-labelledby="actions">
						<h2 id="actions">Next actions</h2>
						<ol class="action-list">
							{d.nextActions.map((item) => <li><p set:html={cite.inline(item)} /></li>)}
						</ol>
					</section>

					<SourceLedger sources={sources} today={TODAY} />

					<CorrectionControl path={path} title={d.question} pageType="question" />

					<CiteThisPage
						machinePath={machinePath}
						page={{
							title: d.question,
							path,
							published: d.effectiveDate,
							reviewed: d.lastReviewed,
							author: d.author,
							id: entry.id,
							pageType: 'question',
						}}
					/>

					{
						related.length > 0 && (
							<section class="answer-section" aria-labelledby="related">
								<h2 id="related">Related questions</h2>
								<div class="rows">
									{related.map((question) => (
										<a class="row" href={`/questions/${question.id}`}
											data-event="related_question_opened"
											data-insurance-family={question.data.family}
											data-page-type="question">
											<div>
												<h3 class="row-title">{question.data.question}</h3>
												<p>{stripMarkers(question.data.shortAnswer).slice(0, 180)}</p>
												<div class="row-meta">
													<StatusChip kind={question.data.confidence} />
													<span class="meta">Reviewed {longDate(question.data.lastReviewed)}</span>
												</div>
											</div>
											<div class="row-tail"><ArrowRight size={16} aria-hidden="true" /></div>
										</a>
									))}
								</div>
							</section>
						)
					}

					{
						d.handoff.recommended && (
							<div style="margin-top: var(--s-12)">
								<Handoff
									sourcePath={path}
									family={d.family}
									line={d.lines[0]}
									reason={cite.inline(d.handoff.reason)}
									pageType="question"
								/>
							</div>
						)
					}
				</div>

				<aside class="answer-rail" aria-label="Page contents and provenance">
					<nav class="rail-block" aria-labelledby="on-this-page">
						<h2 id="on-this-page">On this page</h2>
						<ol>
							{sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
						</ol>
					</nav>

					<div class="rail-block">
						<h2>Confidence</h2>
						<dl>
							<div>
								<dt>Status</dt>
								<dd><StatusChip kind={d.confidence} /></dd>
							</div>
							<div>
								<dt>Primary sources</dt>
								<dd>{sources.filter((s) => s.data.primary).length} of {sources.length}</dd>
							</div>
							<div>
								<dt>Audience</dt>
								<dd>{d.audience.replace('-', ' ')}</dd>
							</div>
						</dl>
					</div>

					{
						(relatedCoverages.length > 0 || relatedCompanies.length > 0 || relatedStates.length > 0) && (
							<nav class="rail-block" aria-labelledby="rail-entities">
								<h2 id="rail-entities">Related records</h2>
								<ul>
									{relatedCoverages.map((c) => (
										<li><a href={`/insurance/${c.id}`}>{c.data.name}</a></li>
									))}
									{relatedCompanies.map((c) => (
										<li><a href={`/companies/${c.id}`}>{c.data.shortName}</a></li>
									))}
									{relatedStates.map((s) => (
										<li><a href={`/states/${s.id}`}>{s.data.name}</a></li>
									))}
								</ul>
							</nav>
						)
					}

					<div class="rail-block no-print">
						<h2>Machine readable</h2>
						<ul>
							<li><a href={machinePath}>Page record (JSON)</a></li>
							<li><a href="/sources">Source registry</a></li>
							<li><a href="/methodology">How this was produced</a></li>
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</article>
</BaseLayout>
