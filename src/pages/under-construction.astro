---
/**
 * Public gate. The live domain must not expose unfinished research pages.
 * Vercel rewrites every public path here while SITE_PUBLIC_GATE is on.
 */
import '../styles/global.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import { siteConfig } from '../config/site';

const title = `Under construction | ${siteConfig.name}`;
const description =
	'BestInsurance Research is not open yet. This property is temporarily closed to the public while the work is finished.';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="canonical" href={`${siteConfig.origin}/`} />
		<style>
			:root {
				--ink: #1a1a1a;
				--muted: #5c5c5c;
				--line: #e6e2db;
				--paper: #f7f4ef;
				--accent: #1f4d3a;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 32px 20px;
				background: var(--paper);
				color: var(--ink);
				font-family: "Schibsted Grotesk", system-ui, sans-serif;
			}
			main {
				width: min(560px, 100%);
				border: 1px solid var(--line);
				background: #fff;
				padding: 40px 36px;
			}
			p.kicker {
				margin: 0 0 18px;
				font-size: 11px;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--muted);
				font-weight: 600;
			}
			h1 {
				margin: 0 0 14px;
				font-family: Newsreader, Georgia, serif;
				font-weight: 400;
				font-size: clamp(28px, 5vw, 36px);
				line-height: 1.2;
				letter-spacing: -0.02em;
			}
			p {
				margin: 0 0 14px;
				font-size: 15px;
				line-height: 1.65;
				color: var(--muted);
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				margin-top: 28px;
			}
			a.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 11px 16px;
				border: 1px solid var(--ink);
				background: var(--ink);
				color: #fff;
				text-decoration: none;
				font-size: 13px;
				font-weight: 600;
			}
			a.btn.secondary {
				background: transparent;
				color: var(--ink);
			}
			footer {
				margin-top: 28px;
				padding-top: 18px;
				border-top: 1px solid var(--line);
				font-size: 12px;
				line-height: 1.6;
				color: var(--muted);
			}
		</style>
	</head>
	<body>
		<main>
			<p class="kicker">BestInsurance Research</p>
			<h1>This site is under construction.</h1>
			<p>
				The public research library is not available yet. Pages, feeds, and machine-readable
				companions are held behind this gate until the owner opens the property.
			</p>
			<p>
				For licensed California insurance help today, contact Bollinsure Insurance Services.
			</p>
			<div class="actions">
				<a class="btn" href={siteConfig.bollinsureOrigin}>Go to Bollinsure</a>
				<a class="btn secondary" href={`tel:${siteConfig.contact.phoneE164}`}>{siteConfig.contact.phoneDisplay}</a>
			</div>
			<footer>
				Operated by {siteConfig.operator.legalName} dba {siteConfig.operator.dba}.
				CA DOI agency licence #{siteConfig.operator.agencyLicense}. Nothing on this gate is a
				quote, a recommendation, or a coverage determination.
			</footer>
		</main>
	</body>
</html>
