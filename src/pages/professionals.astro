---
import { ArrowRight, BadgeCheck, BookOpen, FileText, GitPullRequest, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Callout from '../components/Callout.astro';
import ProductContextBar from '../components/ProductContextBar.astro';
import { siteConfig } from '../config/site';
import { breadcrumbs, graph, organization, website } from '../lib/schema';

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'For professionals', path: '/professionals' },
];
const jsonLd = graph(organization(), website(), breadcrumbs(trail));
---

<BaseLayout
	title="For insurance and financial professionals"
	description="A transparent contribution path for California insurance and financial professionals who want to publish research, suggest corrections, and add context to Birch."
	jsonLd={jsonLd}
	pageType="editorial"
>
	<article>
		<section class="band band-tight band-first band-paper professional-hero">
			<div class="shell">
				<Breadcrumbs trail={trail} />
				<ProductContextBar active="contribute" />
				<div class="professional-hero-grid">
					<div><span class="eyebrow">Birch / Professional desk</span><h1>Make your expertise checkable.</h1><p class="page-lede">Birch gives licensed and credentialed professionals a place to publish useful insurance context without turning the research record into a marketing channel.</p><div class="professional-actions"><a class="btn btn-primary" href="/contribute?type=research">Prepare research <ArrowRight size={15} aria-hidden="true" /></a><a class="btn btn-secondary" href="/methodology">Read the method</a><a class="btn btn-quiet" href="/design/commons-preview">Preview the Commons workflow <ArrowRight size={15} aria-hidden="true" /></a></div></div>
					<div class="professional-profile-preview"><div class="professional-avatar">BB</div><div><span class="eyebrow">Profile preview</span><h2>Brian Bollinger</h2><p>Principal broker · California</p></div><div class="professional-profile-meta"><span><BadgeCheck size={15} aria-hidden="true" /> Credential verified</span><span><BookOpen size={15} aria-hidden="true" /> Research contributions</span><span><ShieldCheck size={15} aria-hidden="true" /> Conflicts disclosed</span></div></div>
				</div>
			</div>
		</section>

		<section class="band band-tight" aria-labelledby="professional-benefits-title">
			<div class="shell">
				<span class="eyebrow">What a professional can do</span><h2 id="professional-benefits-title">Contribute signal without controlling the answer.</h2>
				<div class="professional-card-grid">
					<div class="professional-card"><FileText size={19} aria-hidden="true" /><h3>Publish research</h3><p>Write a sourced explanation with your name, role, jurisdiction, affiliation, and conflict disclosure attached.</p></div>
					<div class="professional-card"><GitPullRequest size={19} aria-hidden="true" /><h3>Suggest a correction</h3><p>Point to a claim, a source, and a date. The editorial record retains what changed and why.</p></div>
					<div class="professional-card"><ShieldCheck size={19} aria-hidden="true" /><h3>Respond with context</h3><p>Answer a question or respond to an experience. A response is labeled as a response, never merged into research.</p></div>
				</div>
			</div>
		</section>

		<section class="band band-paper" aria-labelledby="professional-rules-title">
			<div class="shell professional-rules-grid">
				<div><span class="eyebrow">The professional standard</span><h2 id="professional-rules-title">Verification earns context, not editorial control.</h2><p class="lede">Credentials help readers understand who is speaking. They do not turn a professional’s opinion into a universal answer.</p></div>
				<Callout tone="limit" label="Required before publishing"><ul><li>Credential and jurisdiction.</li><li>Current role and affiliation.</li><li>Compensation and conflict disclosure.</li><li>Sources for material claims.</li><li>No individualized recommendation or claim outcome promise.</li></ul></Callout>
			</div>
		</section>

		<section class="band band-ink" aria-labelledby="professional-operator-title">
			<div class="shell professional-operator"><div><span class="eyebrow">California first</span><h2 id="professional-operator-title">Birch is operated by {siteConfig.operator.dba}, and says so.</h2><p class="lede">The operator’s insurance experience is part of the context. It is never a substitute for a source, and licensed help remains optional.</p></div><a class="btn btn-secondary" href={siteConfig.bollinsureOrigin + '/about'} rel="noopener">Read about the operator <ArrowRight size={15} aria-hidden="true" /></a></div>
		</section>
	</article>
</BaseLayout>

<style>
	.professional-hero { padding-bottom: var(--s-10); }
	.professional-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 360px); gap: var(--s-12); align-items: end; margin-top: var(--s-8); }
	.professional-hero h1 { max-width: 14ch; font-size: clamp(2.7rem, 6vw, 5rem); letter-spacing: -.045em; }
	.professional-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }
	.professional-profile-preview { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--s-3); padding: var(--s-5); border: 1px solid var(--line-strong); border-top: 3px solid var(--brand-blue); background: var(--cream); border-radius: var(--r-3); }
	.professional-avatar { display: grid; place-items: center; width: 52px; height: 52px; color: var(--paper); background: var(--brand-blue-deep); border-radius: 50%; font-family: var(--font-mono); font-size: var(--text-sm); }
	.professional-profile-preview h2 { margin-bottom: 0; font-size: var(--text-xl); }
	.professional-profile-preview p { margin: 0; color: var(--muted); font-size: var(--text-sm); }
	.professional-profile-meta { grid-column: 1 / -1; display: grid; gap: var(--s-2); padding-top: var(--s-4); border-top: 1px solid var(--line); color: var(--body); font-size: var(--text-sm); }
	.professional-profile-meta span { display: flex; gap: var(--s-2); align-items: center; }
	.professional-profile-meta svg { color: var(--brand-blue-text); }
	.professional-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); margin-top: var(--s-5); }
	.professional-card { padding: var(--s-5); border: 1px solid var(--line); background: var(--paper); border-radius: var(--r-3); }
	.professional-card > svg { color: var(--brand-blue-text); }
	.professional-card h3 { margin-top: var(--s-4); }
	.professional-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); }
	.professional-rules-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: var(--s-12); align-items: start; }
	.professional-operator { display: flex; justify-content: space-between; gap: var(--s-8); align-items: center; }
	.professional-operator h2 { max-width: 20ch; }
	@media (max-width: 900px) { .professional-hero-grid, .professional-rules-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); } .professional-card-grid { grid-template-columns: minmax(0, 1fr); } .professional-operator { align-items: flex-start; flex-direction: column; } }
	@media (max-width: 640px) { .professional-actions .btn { width: 100%; } }
</style>
