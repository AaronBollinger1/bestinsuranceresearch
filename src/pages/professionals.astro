---
import { ArrowRight, BookOpen, FileText, GitPullRequest, ShieldCheck, UserRound } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusPageHeader from '../components/FocusPageHeader.astro';
import { breadcrumbs, graph, organization, website } from '../lib/schema';

const contributions = [
  { icon: FileText, title: 'Explain something well.', description: 'Write original research with the sources, context, and limitations attached.', action: 'Prepare research', href: '/contribute?type=research' },
  { icon: GitPullRequest, title: 'Make the record better.', description: 'Point to a specific claim and the original document that needs checking.', action: 'Suggest a correction', href: '/contribute?type=correction' },
  { icon: BookOpen, title: 'Add your perspective.', description: 'Share useful professional context, clearly separate from published findings.', action: 'Explore the Community preview', href: '/design/commons-preview' },
];
const jsonLd = graph(organization(), website(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'For professionals', path: '/professionals' }]));
---
<BaseLayout title="For insurance and financial professionals" description="Make your expertise useful through attributed research, source corrections, and professional context. Contribution and credential verification remain in private preview." jsonLd={jsonLd} pageType="editorial">
  <section class="professional-page shell">
    <FocusPageHeader eyebrow="For insurance and financial professionals" title="Make your expertise useful." description="Help people understand insurance. Put your name, perspective, and sources behind work worth reading.">
      <a class="btn btn-primary" href="/contribute?type=research">Prepare research <ArrowRight size={16} aria-hidden="true" /></a>
      <a class="btn btn-quiet" href="/editorial-policy">How publishing works</a>
    </FocusPageHeader>
    <p class="professional-preview-note">Private preview. Prepare a local draft now; accounts and publishing are not open.</p>
    <div class="professional-work">
      <div class="professional-opportunities">
        <h2>Good work, with your name attached.</h2>
        <p>A useful explanation can outlast the conversation that started it.</p>
        {contributions.map(({icon: Icon,title,description,action,href}) => <a class="professional-opportunity" href={href}><Icon size={20} aria-hidden="true" /><div><h3>{title}</h3><p>{description}</p><span>{action} <ArrowRight size={14} aria-hidden="true" /></span></div></a>)}
      </div>
      <aside class="professional-profile" aria-label="Illustrative contributor profile">
        <div class="profile-status"><span>Contributor profile</span><span>Design example</span></div>
        <div class="profile-identity"><UserRound size={28} aria-hidden="true" /><div><h2>Your name</h2><p>Your specialty · Your jurisdiction</p></div></div>
        <dl><div><dt>Professional credential</dt><dd>Not yet verified</dd></div><div><dt>Affiliation and conflicts</dt><dd>Declared before publication</dd></div><div><dt>Published work</dt><dd>Only after editorial approval</dd></div></dl>
        <div class="profile-credit"><BookOpen size={18} aria-hidden="true" /><p>Your author page connects your original work, relevant expertise, and correction history.</p></div>
        <p class="profile-caption">Planned profile pattern, not a verified person or live publication record. No promised rankings or citations.</p>
      </aside>
    </div>
    <section class="professional-standards" aria-labelledby="professional-standard-title">
      <div><ShieldCheck size={22} aria-hidden="true" /><h2 id="professional-standard-title">Expertise adds context.<br/>Sources support the answer.</h2></div>
      <div><p>Declare your credential, jurisdiction, role, affiliation, and conflicts. Write within your specialty. A checked credential does not establish the accuracy of every statement or give anyone control over the editorial result.</p><details><summary>What is checked before publishing?</summary><ul><li>Credential scope and current status where applicable.</li><li>Original sources supporting material claims.</li><li>Privacy, affiliations, and conflicts.</li><li>Clear limits: no individualized coverage determination or claim outcome promise.</li></ul><a class="text-link" href="/methodology">Read the methodology <ArrowRight size={14} aria-hidden="true" /></a></details></div>
    </section>
  </section>
</BaseLayout>
<style>
  .professional-page { padding-bottom: 64px; }
  .professional-preview-note { text-align: center; font-size: var(--text-xs); color: var(--muted); margin: -12px auto 48px; line-height: 1.6; }
  .professional-work { max-width: 1040px; margin: auto; display: grid; grid-template-columns: minmax(0,1fr) 360px; gap: 64px; align-items: start; }
  h2 { font: 500 var(--text-2xl)/1.3 var(--font-sans); letter-spacing: -.03em; }
  .professional-opportunities > p { color: var(--muted); font-size: var(--text-sm); }
  .professional-opportunity { display: grid; grid-template-columns: 24px 1fr; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .professional-opportunity > svg { color: var(--brand-blue-text); margin-top: 3px; }
  h3 { font: 500 var(--text-md)/1.4 var(--font-sans); margin: 0 0 8px; }
  .professional-opportunity p { margin: 0 0 12px; color: var(--muted); font-size: var(--text-sm); line-height: 1.7; }
  .professional-opportunity span { display: flex; align-items: center; gap: 8px; font-size: var(--text-xs); color: var(--brand-blue-text); }
  .professional-opportunity:hover h3 { color: var(--brand-blue-text); }
  .professional-opportunity span svg { transition: transform var(--dur-2) var(--ease); }
  .professional-opportunity:is(:hover,:focus-visible) span svg { transform: translateX(3px); }
  .professional-profile { padding: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-4); box-shadow: var(--elev-2); }
  .profile-status { display: flex; justify-content: space-between; gap: 8px; font-size: var(--text-2xs); color: var(--muted); }
  .profile-status span:last-child { color: var(--brand-blue-text); }
  .profile-identity { display: flex; align-items: center; gap: 16px; margin: 32px 0 24px; }
  .profile-identity > svg { color: var(--brand-blue-text); }
  .profile-identity h2 { font-size: var(--text-xl); margin: 0 0 4px; }
  .profile-identity p { font-size: var(--text-xs); margin: 0; color: var(--muted); }
  dl { margin: 0; } dl > div { padding: 16px 0; border-top: 1px solid var(--line); }
  dt { color: var(--muted); font-size: var(--text-xs); } dd { margin: 5px 0 0; font-size: var(--text-sm); }
  .profile-credit { display: flex; align-items: flex-start; gap: 12px; background: var(--paper); padding: 16px; margin-top: 8px; border-radius: var(--r-3); }
  .profile-credit svg { flex-shrink: 0; color: var(--brand-blue-text); } .profile-credit p { margin: 0; font-size: var(--text-xs); line-height: 1.6; }
  .profile-caption { margin: 16px 0 0; color: var(--muted); font-size: var(--text-2xs); line-height: 1.6; }
  .professional-standards { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; max-width: 1040px; margin: 64px auto 0; padding-top: 40px; border-top: 1px solid var(--line); }
  .professional-standards svg { color: var(--brand-blue-text); } .professional-standards h2 { margin-top: 16px; }
  .professional-standards p, .professional-standards li { font-size: var(--text-sm); color: var(--muted); line-height: 1.7; }
  summary { min-height: var(--tap); padding-block: 12px; font-size: var(--text-sm); cursor: pointer; }
  @media (max-width: 850px) { .professional-work, .professional-standards { grid-template-columns: minmax(0,1fr); gap: 32px; } .professional-profile { max-width: 480px; width: 100%; } .professional-preview-note { margin-bottom: 32px; } .professional-standards { margin-top: 40px; } }
  @media (prefers-reduced-motion: reduce) { .professional-opportunity span svg { transition: none; transform: none !important; } }
</style>
