---
import {
	ArrowRight,
	Building2,
	FileStack,
	FlaskConical,
	Landmark,
	Layers,
	MapPin,
	Search,
	Wrench,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusChip from '../components/StatusChip.astro';
import { siteConfig } from '../config/site';
import { stripMarkers } from '../lib/citations';
import { isStale, loadCorpus, recentlyReviewed } from '../lib/corpus';
import { longDate } from '../lib/cite';
import { graph, organization, website } from '../lib/schema';
import { TODAY } from '../lib/today';

import { excerpt, shortList } from '../lib/excerpt';
const corpus = await loadCorpus();
const california = corpus.states.find((state) => state.id === 'california');
if (!california) throw new Error('California state record is missing.');
const caQuestions = corpus.questions.filter((question) => question.data.states.includes('CA'));
const caCoverages = corpus.coverages.filter((coverage) => coverage.data.stateVariations.some((variation) => variation.state === 'CA'));

/* Source-quality strip: counted from the registry, never asserted. */
const totalSources = corpus.sources.length;
const primarySources = corpus.sources.filter((s) => s.data.primary).length;
const staleSources = corpus.sources.filter((s) => isStale(s.data.lastChecked, TODAY)).length;
/* Of the source records, how many have been confirmed after the day they
   were added. accessedDate and lastChecked were identical on 260 of 263,
   so publishing a per-source freshness date without this ratio overstated
   what the date establishes. */
const rechecked = corpus.sources.filter((s) => s.data.lastCheckedBasis === 'recheck').length;
const correctedPages = corpus.questions.filter((q) => q.data.reviewState === 'corrected').length;

/*
 * Editorial selection, not a usage count. A reviewer decided these are the most
 * useful starting points. This site does not publish invented popularity data.
 */
const FEATURED = [
	'homeowners-earthquake-california',
	'replacement-cost-vs-market-value',
	'claims-made-retroactive-date',
	'workers-comp-class-codes',
	'lender-insurance-requirement',
	'surety-bond-vs-insurance',
];
const featured = FEATURED.map((slug) => corpus.questionBySlug.get(slug)).filter(
	(q): q is NonNullable<typeof q> => Boolean(q),
);
const featuredQuestions = featured.length >= 4 ? featured : corpus.questions.slice(0, 6);
const examples = featuredQuestions.slice(0, 5).map((q) => q.data.question);
const previewQuestion = featuredQuestions[0];

const recent = recentlyReviewed(corpus, 6);

const atlas = [
	{
		href: '/insurance',
		icon: Layers,
		label: 'Coverage library',
		count: corpus.coverages.length,
		unit: 'lines',
		blurb: 'What a line is designed to protect, what it commonly covers, and the policy-form caveats.',
	},
	{
		href: '/questions',
		icon: FileStack,
		label: 'Question library',
		count: corpus.questions.length,
		unit: 'questions',
		blurb: 'Every question with a direct answer, its assumptions, and what would change it.',
	},
	{
		href: '/companies',
		icon: Building2,
		label: 'Companies and regulators',
		count: corpus.companies.length,
		unit: 'organizations',
		blurb: 'Verified identity, regulator records, and official channels. No ratings summaries.',
	},
	{
		href: '/states',
		icon: MapPin,
		label: 'States',
		count: corpus.states.length,
		unit: 'jurisdictions',
		blurb: 'Regulator, rate mechanism, residual market, and current statutory minimums.',
	},
	{
		href: '/examples',
		icon: FlaskConical,
		label: 'Examples',
		count: corpus.examples.length,
		unit: 'labeled examples',
		blurb: 'Public records, composites, and hypotheticals, each labeled for exactly what it is.',
	},
	{
		href: '/tools',
		icon: Wrench,
		label: 'Tools',
		count: corpus.liveTools.length,
		unit: 'free tools',
		blurb: 'Organize a contract requirement, a renewal, or a policy comparison. Nothing is uploaded.',
	},
];

const jsonLd = graph(organization(), website());
---

<BaseLayout
	description="Free insurance research and community conversation from Birch. Start with a question, open the sources behind the answer, and share what happened without turning a person’s experience into a verdict."
	jsonLd={jsonLd}
	pageType="home"
>
	<!-- First viewport: the working surface, now with a clearer Birch entry point. -->
	<section class="band band-tight band-first band-paper" aria-labelledby="home-title">
		<div class="shell">
			<div class="home-hero">
			<div class="home-hero-copy">
				<div class="home-identity">
					<img src="/birch-bird-transparent.png" width="52" height="52" alt="" />
					<div>
						<span class="eyebrow">Birch / Research</span>
						<span class="home-identity-note">Insurance, with the source attached</span>
					</div>
					</div>
					<h1 id="home-title">Insurance answers with the source attached.</h1>
					<p class="lede">
						Birch is free, independent research for the moments when insurance gets hard to read. Ask a question,
						see the assumptions, and open the source behind the answer.
					</p>
					<p class="home-hero-boundary">No quotes. No rankings. No sales pitch. Just context you can check.</p>

				<form action="/ask" method="get" role="search" data-question-form class="home-search-form">
					<div class="field">
						<label for="home-q">Start with a question</label>
						<div class="home-search-row">
							<input
								id="home-q"
								name="q"
								type="search"
								autocomplete="off"
								enterkeyhint="search"
								placeholder={examples[0] ?? 'Ask an insurance question'}
								aria-describedby="home-q-hint"
							/>
							<button class="btn btn-primary" type="submit">
								<Search size={16} aria-hidden="true" /> Ask Birch
							</button>
						</div>
						<span class="hint" id="home-q-hint">
							Search stays on your device. Leave out names, addresses, policy or claim numbers, and health details.
						</span>
					</div>
				</form>

					<div class="home-quick-actions" aria-label="Explore Birch">
						<a class="btn btn-secondary" href="/insurance">Browse coverage</a>
						<a class="btn btn-quiet" href="/questions">Read the question library <ArrowRight size={15} aria-hidden="true" /></a>
					</div>
				</div>

				<aside class="home-compass" aria-label="How Birch works">
					<span class="eyebrow">How Birch works</span>
					<h2>A calmer way to get oriented.</h2>
					<ol class="home-entry-list">
						<li>
							<a href="/ask"><span>Ask a plain-language question</span><ArrowRight size={15} aria-hidden="true" /></a>
							<p>Start with the situation, not the product label.</p>
						</li>
						<li>
							<a href="/sources"><span>Read the evidence trail</span><ArrowRight size={15} aria-hidden="true" /></a>
							<p>See what the answer assumes and where it came from.</p>
						</li>
						<li>
							{
								siteConfig.communityReady ? (
									<a href={siteConfig.communityOrigin} rel="noopener"><span>Bring context to Commons</span><ArrowRight size={15} aria-hidden="true" /></a>
								) : (
									<span class="home-entry-list-status">Bring context to Commons · private preview</span>
								)
							}
							<p>
								{siteConfig.communityReady
									? 'Share an experience without turning it into a verdict.'
									: 'The separate Commons will open after its deployment and moderation systems are ready.'}
							</p>
						</li>
					</ol>
					<div class="home-boundary">
						<span class="meta">A note on trust</span>
						<p>Birch separates research from lived experience so you can tell what is documented, what is reported, and what still needs review.</p>
					{siteConfig.environment === 'preview' && (
						<div class="home-preview-note">
							<span class="status status-plain">Private review</span>
							<span>Only invited reviewers can access this build. Birch signup is not enabled.</span>
						</div>
					)}
				</div>
			</aside>
			</div>

			<section class="home-proof-band" aria-labelledby="proof-title">
				<div class="home-proof-head">
					<span class="eyebrow" id="proof-title">Built for clarity</span>
					<a class="text-link" href="/sources">Open the source registry <ArrowRight size={14} aria-hidden="true" /></a>
				</div>
				<div class="home-proof-grid">
					<div><strong>Source attached</strong><span>Open the record behind the answer.</span></div>
					<div><strong>Assumptions visible</strong><span>See what changes the answer.</span></div>
					<div><strong>Free to read</strong><span>No account or upload required.</span></div>
				</div>
			</section>

			<section class="home-corpus" aria-labelledby="corpus-title">
				<div class="home-corpus-head">
					<div>
						<span class="eyebrow">Research record</span>
						<h2 id="corpus-title">The current library, counted from its source registry.</h2>
					</div>
					<span class="home-corpus-note">{rechecked} of {totalSources} independently rechecked · updated as the corpus changes.</span>
				</div>
				<div class="home-corpus-grid">
					<a class="home-corpus-metric" href="/sources"><span class="meta">Source records</span><strong>{totalSources}</strong><span>Publisher, dates, and supported claims.</span></a>
					<a class="home-corpus-metric" href="/sources"><span class="meta">Primary sources</span><strong>{primarySources}<small> / {totalSources}</small></strong><span>Statutes, regulations, guidance, and official records.</span></a>
					<a class="home-corpus-metric" href="/sources"><span class="meta">Stale sources</span><strong>{staleSources}</strong><span>Past the review window and flagged.</span></a>
					<a class="home-corpus-metric" href="/corrections"><span class="meta">Pages corrected</span><strong>{correctedPages}</strong><span>Material changes logged publicly.</span></a>
				</div>
			</section>

			<div class="home-ca-launch" aria-labelledby="ca-launch-title">
				<div>
					<span class="eyebrow">California launch desk</span>
					<h2 id="ca-launch-title">Start with the questions California makes unusually hard.</h2>
					<p>
						Wildfire, earthquake, FAIR Plan, rate review, auto limits, and workers’ compensation each have a
						local context. Birch starts there, with the Bollinger family’s California insurance experience named
						as the operator—not hidden behind a generic information brand.
					</p>
				</div>
				<div class="home-ca-facts" aria-label="California launch desk counts">
					<span><b>{caQuestions.length}</b> CA questions</span>
					<span><b>{caCoverages.length}</b> CA coverage pages</span>
					<a class="btn btn-secondary btn-sm" href="/start">Open the California desk <ArrowRight size={15} aria-hidden="true" /></a>
				</div>
			</div>

			<section class="home-product-sequence" aria-labelledby="sequence-title">
				<div class="home-product-sequence-head">
					<div>
						<span class="eyebrow">The Birch loop</span>
						<h2 id="sequence-title">A better insurance answer has a next move.</h2>
					</div>
					<p>Birch turns uncertainty into a small, repeatable research path: ask plainly, inspect the evidence, then add context only when it can be labelled honestly.</p>
				</div>

				<div class="home-product-sequence-grid">
					<div class="home-sequence-list" aria-label="The Birch research loop">
						<a class="home-sequence-step" href="/ask">
							<span class="home-sequence-number">01</span>
							<span class="home-sequence-copy"><strong>Ask in plain language</strong><span>Begin with the question you would actually ask a person.</span></span>
							<ArrowRight size={15} aria-hidden="true" />
						</a>
						<a class="home-sequence-step" href="/sources">
							<span class="home-sequence-number">02</span>
							<span class="home-sequence-copy"><strong>Open the source</strong><span>See the publisher, date, and exact claims a record supports.</span></span>
							<ArrowRight size={15} aria-hidden="true" />
						</a>
						<a class="home-sequence-step" href="/contribute">
							<span class="home-sequence-number">03</span>
							<span class="home-sequence-copy"><strong>Improve the context</strong><span>Suggest a correction or draft an experience without turning it into a verdict.</span></span>
							<ArrowRight size={15} aria-hidden="true" />
						</a>
					</div>

					{
						previewQuestion && (
							<aside class="home-sequence-preview" aria-label="Cited Birch answer preview">
								<div class="home-sequence-preview-top">
									<span class="eyebrow">A Birch answer</span>
									<span class="status status-plain">{previewQuestion.data.sourceIds.length} sources</span>
								</div>
								<p class="home-sequence-question">{previewQuestion.data.question}</p>
								<p class="home-sequence-answer">{excerpt(stripMarkers(previewQuestion.data.shortAnswer), 235)}</p>
								<div class="home-sequence-preview-foot">
									<span class="meta">{shortList(previewQuestion.data.lines)} · {previewQuestion.data.states.join(', ') || 'U.S. context'}</span>
									<a href={`/questions/${previewQuestion.id}`}>Read the cited answer <ArrowRight size={14} aria-hidden="true" /></a>
								</div>
							</aside>
						)
					}
				</div>
			</section>
		</div>
	</section>

	<!-- Editorially selected starting points. -->
	<section class="band band-tight" aria-labelledby="featured-title">
		<div class="shell">
			<div class="band-head">
				<div>
					<span class="eyebrow">Editorial selection</span>
					<h2 id="featured-title">Useful places to start</h2>
					<p>
						Chosen by a reviewer for how often the underlying confusion causes a real problem. These
						are not usage counts.
					</p>
				</div>
				<a class="btn btn-secondary btn-sm" href="/questions">
					All {corpus.questions.length} questions <ArrowRight size={15} aria-hidden="true" />
				</a>
			</div>

			<div class="rows">
				{
					featuredQuestions.map((question) => (
						<a class="row" href={`/questions/${question.id}`}>
							<div>
								<h3 class="row-title">{question.data.question}</h3>
								<p>{excerpt(stripMarkers(question.data.shortAnswer), 190)}</p>
								<div class="row-meta">
									<StatusChip kind={question.data.confidence} />
									<span class="meta">{shortList(question.data.lines)}</span>
									{question.data.states.length > 0 && <span class="meta">{question.data.states.join(', ')}</span>}
									<span class="meta">{question.data.sourceIds.length} sources</span>
									<span class="meta">Reviewed {longDate(question.data.lastReviewed)}</span>
								</div>
							</div>
							<div class="row-tail"><ArrowRight size={16} aria-hidden="true" /></div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- Topic atlas: high-scan entry points. -->
	<section class="band band-paper" aria-labelledby="atlas-title">
		<div class="shell">
			<div class="band-head">
				<div>
					<span class="eyebrow">Browse the library</span>
					<h2 id="atlas-title">Organized around entities, not a blog chronology</h2>
					<p>
						The library is arranged by what a thing is, not when it was written. Every record links
						to the questions that depend on it.
					</p>
				</div>
			</div>

			<div class="card-grid">
				{
					atlas.map((entry) => {
						const Icon = entry.icon;
						return (
							<a class="card" href={entry.href}>
								<div class="card-top">
									<Icon size={20} aria-hidden="true" style="color: var(--gold-text)" />
									<span class="status status-plain">
										{entry.count} {entry.unit}
									</span>
								</div>
								<h3 class="card-title">{entry.label}</h3>
								<p>{entry.blurb}</p>
								<div class="card-foot">
									<span class="meta">Open</span>
									<ArrowRight size={15} aria-hidden="true" />
								</div>
							</a>
						);
					})
				}
			</div>
		</div>
	</section>

	<!-- Recently reviewed. -->
	<section class="band band-tight" aria-labelledby="recent-title">
		<div class="shell">
			<div class="band-head">
				<div>
					<span class="eyebrow">Review feed</span>
					<h2 id="recent-title">Recently reviewed</h2>
					<p>Sorted by the date a person last checked the page against its sources.</p>
				</div>
				<a class="btn btn-secondary btn-sm" href="/rss.xml">
					RSS feed <ArrowRight size={15} aria-hidden="true" />
				</a>
			</div>

			<div class="rows">
				{
					recent.map((item) => (
						<a class="row" href={item.path}>
							<div>
								<h3 class="row-title">{item.title}</h3>
								<p>{excerpt(stripMarkers(item.summary), 170)}</p>
								<div class="row-meta">
									<span class="status status-plain">{item.kind}</span>
									<span class="meta">Reviewed {longDate(item.date)}</span>
								</div>
							</div>
							<div class="row-tail"><ArrowRight size={16} aria-hidden="true" /></div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- Standards. -->
	<section class="band band-ink" aria-labelledby="standards-title">
		<div class="shell">
			<span class="eyebrow">Standards</span>
			<h2 id="standards-title">What this site will and will not do</h2>

			<div class="card-grid card-grid-2" style="margin-top: var(--s-6)">
				<div style="padding: var(--s-5); border: 1px solid var(--line-ink); border-radius: var(--r-4)">
					<h3 style="color: var(--paper)">It will</h3>
					<ul style="margin: var(--s-3) 0 0; font-size: var(--text-sm); line-height: var(--leading-normal)">
						<li>State the direct answer first, then the conditions.</li>
						<li>Map every material claim to a dated source you can open.</li>
						<li>Say when competent sources disagree, or when a rule is changing.</li>
						<li>Show the author, the reviewer, and the review date.</li>
						<li>Publish corrections with the prior wording intact.</li>
						<li>Say "insufficient evidence" rather than fill a gap.</li>
					</ul>
				</div>
				<div style="padding: var(--s-5); border: 1px solid var(--line-ink); border-radius: var(--r-4)">
					<h3 style="color: var(--paper)">It will not</h3>
					<ul style="margin: var(--s-3) 0 0; font-size: var(--text-sm); line-height: var(--leading-normal)">
						<li>Give legal, tax, medical, lending, investment, or claims advice.</li>
						<li>Decide whether a specific risk is eligible, bound, or uninsurable.</li>
						<li>Rank insurers, or publish a "best" or "cheapest" claim.</li>
						<li>Require an email, a phone number, or an account to read anything.</li>
						<li>Collect a declarations page, a document, or your contact details.</li>
						<li>Invent an example, a premium, a savings figure, or a claim outcome.</li>
					</ul>
				</div>
			</div>

			<div style="display:flex;flex-wrap:wrap;gap:var(--s-2);margin-top:var(--s-6)">
				<a class="btn btn-primary" href="/methodology">
					<Landmark size={16} aria-hidden="true" /> Read the methodology
				</a>
				<a class="btn btn-secondary" href="/sources">Open the source registry</a>
				<a class="btn btn-secondary" href="/corrections">See the correction log</a>
			</div>
		</div>
	</section>
</BaseLayout>
