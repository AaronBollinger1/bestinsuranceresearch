---
import { ArrowRight, Car, ExternalLink, HardHat, Landmark, LifeBuoy, Wrench } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import CorrectionControl from '../../components/CorrectionControl.astro';
import SourceLedger from '../../components/SourceLedger.astro';
import StatusChip from '../../components/StatusChip.astro';
import { createCiter, stripMarkers } from '../../lib/citations';
import { idsOf, ledgerFor, loadCorpus } from '../../lib/corpus';
import { longDate } from '../../lib/cite';
import { breadcrumbs, graph, organization, techArticle, website } from '../../lib/schema';
import { TODAY } from '../../lib/today';

export const getStaticPaths = (async () => {
	const corpus = await loadCorpus();
	return corpus.states.map((entry) => ({ params: { slug: entry.id }, props: { entry, corpus } }));
}) satisfies GetStaticPaths;

const { entry, corpus } = Astro.props;
const d = entry.data;
const path = `/states/${entry.id}`;
const machinePath = `${path}.json`;

const sourceIds = idsOf(d.sourceIds);
const sources = ledgerFor(sourceIds, corpus.sourceById, `state "${entry.id}"`);
const cite = createCiter(sourceIds, `state "${entry.id}"`);

const relatedQuestions = d.relatedQuestions
	.map((ref) => corpus.questionBySlug.get(ref.id))
	.filter((q): q is NonNullable<typeof q> => Boolean(q));
const stateQuestions = corpus.questions.filter(
	(q) => q.data.states.includes(d.code) && !relatedQuestions.some((r) => r.id === q.id),
);
const allRelated = [...relatedQuestions, ...stateQuestions];
const relatedCoverages = corpus.coverages.filter((c) => c.data.stateVariations.some((v) => v.state === d.code));

const description = stripMarkers(d.summary).slice(0, 300);

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'States', path: '/states' },
	{ name: d.name, path },
];

const sections = [
	{ id: 'overview', label: 'What is distinctive here' },
	{ id: 'mechanisms', label: 'Key mechanisms' },
	...(d.residualMarket ? [{ id: 'residual', label: 'Residual market' }] : []),
	...(d.autoRequirements.length ? [{ id: 'auto', label: 'Auto financial responsibility' }] : []),
	...(d.wcMechanism ? [{ id: 'wc', label: 'Workers compensation' }] : []),
	...(d.consumerTools.length ? [{ id: 'tools', label: 'Consumer tools' }] : []),
	{ id: 'source-ledger', label: 'Source ledger' },
];

const jsonLd = graph(
	organization(),
	website(),
	breadcrumbs(trail),
	techArticle({
		headline: `${d.name} insurance context`,
		path,
		description,
		datePublished: d.effectiveDate,
		dateModified: d.lastReviewed,
		author: d.author,
		reviewer: d.reviewer,
		sections: sections.map((s) => s.label),
		about: [d.name, 'insurance regulation'],
		citations: sources.map((s) => ({ name: s.data.title, url: s.data.url, publisher: s.data.publisher })),
	}),
);
---

<BaseLayout
	title={`${d.name} insurance context`}
	description={description}
	jsonLd={jsonLd}
	pageType="state"
	machinePath={machinePath}
>
	<article>
		<header class="band band-first band-paper answer-head">
			<div class="shell">
				<div style="margin-bottom: var(--s-4)"><Breadcrumbs trail={trail} /></div>
				<div class="answer-flags">
					<StatusChip kind={d.reviewState} />
					<span class="meta">Jurisdiction {d.code}</span>
				</div>
				<h1>{d.name}: insurance regulation and availability context</h1>
				<dl class="answer-dates">
					<div><dt>Effective</dt><dd><time datetime={d.effectiveDate}>{longDate(d.effectiveDate)}</time></dd></div>
					<div><dt>Last reviewed</dt><dd><time datetime={d.lastReviewed}>{longDate(d.lastReviewed)}</time></dd></div>
					<div><dt>Regulator</dt><dd><a href={d.regulator.url} rel="noopener nofollow" target="_blank">{d.regulator.name}</a></dd></div>
					{d.regulator.consumerPhone && <div><dt>Consumer line</dt><dd class="num">{d.regulator.consumerPhone}</dd></div>}
					<div><dt>Sources</dt><dd><a href="#source-ledger">{sources.length} records</a></dd></div>
				</dl>
			</div>
		</header>

		<div class="band band-tight">
			<div class="shell answer-grid">
				<div>
					<section aria-labelledby="overview">
						<h2 id="overview" class="u-visually-hidden">Overview</h2>
						<div class="direct-answer"><p set:html={cite.inline(d.summary)} /></div>
					</section>

					<Callout tone="warn">
						<p>
							<strong>Statutory minimums and program rules change.</strong> Check the effective dates
							in the source ledger against your own timeline before you rely on a number here, and
							open the regulator's own page for the current text.
						</p>
					</Callout>

					<section class="answer-section" aria-labelledby="mechanisms">
						<h2 id="mechanisms">Key mechanisms</h2>
						<ul class="fact-list">
							{
								d.keyMechanisms.map((mechanism) => (
									<li>
										<Landmark size={14} aria-hidden="true" />
										<p><strong>{mechanism.title}.</strong> <span set:html={cite.inline(mechanism.detail)} /></p>
									</li>
								))
							}
						</ul>
					</section>

					{
						d.residualMarket && (
							<section class="answer-section" aria-labelledby="residual">
								<h2 id="residual">Residual market</h2>
								<ul class="fact-list">
									<li>
										<LifeBuoy size={14} aria-hidden="true" />
										<p>
											<strong>
												<a href={d.residualMarket.url} rel="noopener nofollow" target="_blank">
													{d.residualMarket.name}
												</a>
											</strong>{' '}
											<span set:html={cite.inline(d.residualMarket.note)} />
										</p>
									</li>
								</ul>
								<Callout tone="limit">
									<p>
										A residual market mechanism is a last-resort option with its own eligibility rules,
										its own forms, and its own limits. This page describes what it is. It does not say
										whether any specific property or risk qualifies, and nothing here is a placement.
									</p>
								</Callout>
							</section>
						)
					}

					{
						d.autoRequirements.length > 0 && (
							<section class="answer-section" aria-labelledby="auto">
								<h2 id="auto">Auto financial responsibility</h2>
								<ul class="fact-list">
									{d.autoRequirements.map((requirement) => (
										<li>
											<Car size={14} aria-hidden="true" />
											<p><strong>{requirement.item}.</strong> <span set:html={cite.inline(requirement.detail)} /></p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					{
						d.wcMechanism && (
							<section class="answer-section" aria-labelledby="wc">
								<h2 id="wc">Workers compensation</h2>
								<ul class="fact-list">
									<li>
										<HardHat size={14} aria-hidden="true" />
										<p set:html={cite.inline(d.wcMechanism.detail)} />
									</li>
								</ul>
							</section>
						)
					}

					{
						d.consumerTools.length > 0 && (
							<section class="answer-section" aria-labelledby="tools">
								<h2 id="tools">Consumer tools published by this jurisdiction</h2>
								<ul class="fact-list">
									{d.consumerTools.map((tool) => (
										<li>
											<ExternalLink size={14} aria-hidden="true" />
											<p>
												<a href={tool.url} rel="noopener nofollow" target="_blank">{tool.label}</a>
												{tool.note && <> - <span set:html={cite.inline(tool.note)} /></>}
											</p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<SourceLedger sources={sources} today={TODAY} />

					<CorrectionControl path={path} title={`${d.name} insurance context`} pageType="state" />

					<CiteThisPage
						machinePath={machinePath}
						page={{
							title: `${d.name} insurance context`,
							path,
							published: d.effectiveDate,
							reviewed: d.lastReviewed,
							author: d.author,
							id: entry.id,
							pageType: 'state',
						}}
					/>

					{
						allRelated.length > 0 && (
							<section class="answer-section" aria-labelledby="related">
								<h2 id="related">Questions that turn on {d.name} law or practice</h2>
								<div class="rows">
									{allRelated.map((question) => (
										<a class="row" href={`/questions/${question.id}`}
											data-event="related_question_opened"
											data-insurance-family={question.data.family}
											data-page-type="state">
											<div>
												<h3 class="row-title">{question.data.question}</h3>
												<p>{stripMarkers(question.data.shortAnswer).slice(0, 170)}</p>
												<div class="row-meta">
													<StatusChip kind={question.data.confidence} />
													<span class="meta">Reviewed {longDate(question.data.lastReviewed)}</span>
												</div>
											</div>
											<div class="row-tail"><ArrowRight size={16} aria-hidden="true" /></div>
										</a>
									))}
								</div>
							</section>
						)
					}
				</div>

				<aside class="answer-rail" aria-label="Page contents">
					<nav class="rail-block" aria-labelledby="on-this-page">
						<h2 id="on-this-page">On this page</h2>
						<ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}</ol>
					</nav>
					<div class="rail-block">
						<h2>Jurisdiction</h2>
						<dl>
							<div><dt>Code</dt><dd class="num">{d.code}</dd></div>
							<div><dt>Regulator</dt><dd>{d.regulator.name}</dd></div>
							<div><dt>Primary sources</dt><dd>{sources.filter((s) => s.data.primary).length} of {sources.length}</dd></div>
						</dl>
					</div>
					{
						relatedCoverages.length > 0 && (
							<nav class="rail-block" aria-labelledby="rail-coverages">
								<h2 id="rail-coverages">Lines with {d.code} variations</h2>
								<ul>{relatedCoverages.map((c) => <li><a href={`/insurance/${c.id}`}>{c.data.name}</a></li>)}</ul>
							</nav>
						)
					}
					<div class="rail-block no-print">
						<h2>Machine readable</h2>
						<ul>
							<li><a href={machinePath}>Page record (JSON)</a></li>
							<li><a href="/states">All jurisdictions</a></li>
							<li><a href="/tools"><Wrench size={12} aria-hidden="true" style="display:inline-block;vertical-align:-1px" /> Free tools</a></li>
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</article>
</BaseLayout>
