---
import { ArrowRight, Ban, BookOpen, ExternalLink, FileText, Landmark, LockKeyhole, MessageCircle, Phone, Scale, ShieldCheck } from '@lucide/astro';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import CorrectionControl from '../../components/CorrectionControl.astro';
import EvidenceBoundary from '../../components/EvidenceBoundary.astro';
import ProductContextBar from '../../components/ProductContextBar.astro';
import SourceLedger from '../../components/SourceLedger.astro';
import StatusChip from '../../components/StatusChip.astro';
import { createCiter, stripMarkers } from '../../lib/citations';
import { idsOf, ledgerFor, loadCorpus } from '../../lib/corpus';
import { longDate } from '../../lib/cite';
import { breadcrumbs, describedOrganization, graph, organization, techArticle, website } from '../../lib/schema';
import { TODAY } from '../../lib/today';
import { siteConfig } from '../../config/site';

import { excerpt, metaDescription } from '../../lib/excerpt';
export const getStaticPaths = (async () => {
	const corpus = await loadCorpus();
	return corpus.companies.map((entry) => ({ params: { slug: entry.id }, props: { entry, corpus } }));
}) satisfies GetStaticPaths;

const { entry, corpus } = Astro.props;
const d = entry.data;
const path = `/companies/${entry.id}`;
const machinePath = `${path}.json`;
const commonsHref = `${siteConfig.communityOrigin}/threads?subject=${encodeURIComponent(`company:${entry.id}`)}`;
const companyInitials = d.shortName.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || 'CO';
const officialHost = d.officialUrls[0]?.url ? new URL(d.officialUrls[0].url).hostname.replace(/^www\./, '') : 'Official domain not listed';

const sourceIds = idsOf(d.sourceIds);
const sources = ledgerFor(sourceIds, corpus.sourceById, `organization "${entry.id}"`);
const cite = createCiter(sourceIds, `organization "${entry.id}"`);

const relatedQuestions = d.relatedQuestions
	.map((ref) => corpus.questionBySlug.get(ref.id))
	.filter((q): q is NonNullable<typeof q> => Boolean(q));
const mentioning = corpus.questions.filter(
	(q) => q.data.companies.some((c) => c.id === entry.id) && !relatedQuestions.some((r) => r.id === q.id),
);
const allRelated = [...relatedQuestions, ...mentioning];
const relatedCoverageIds = [...new Set(allRelated.flatMap((question) => question.data.coverages.map((coverage) => coverage.id)))];
const relatedCoverages = relatedCoverageIds
	.map((id) => corpus.coverageBySlug.get(id))
	.filter((coverage): coverage is NonNullable<typeof coverage> => Boolean(coverage));

const description = metaDescription(stripMarkers(d.summary));

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Companies', path: '/companies' },
	{ name: d.shortName, path },
];

const ORG_TYPE_LABEL: Record<string, string> = {
	regulator: 'Insurance regulator',
	'standards-organization': 'Standards organization',
	'public-entity': 'Public entity',
	insurer: 'Insurer',
	'insurance-group': 'Insurance group',
	'residual-market': 'Residual market mechanism',
};

const pageMap = [
	{ number: '01', label: 'Documented identity', detail: 'The sourced organization record', href: '#identity' },
	{ number: '02', label: 'Coverage context', detail: 'Research links without a catalog verdict', href: '#coverage-context' },
	{ number: '03', label: 'Official website', detail: 'Channels and records to check', href: '#official' },
	{ number: '04', label: 'Financial context', detail: 'No Birch score or ranking', href: '#financial-context' },
	{ number: '05', label: 'Community lanes', detail: 'Forums, threads, and experiences', href: '#community' },
	...(d.filedForms.length ? [{ number: '06', label: 'Filed forms', detail: 'Source-linked documents only', href: '#filed-forms' }] : []),
];

const communityLanes = [
	{
		id: 'forums',
		label: 'Forums',
		status: 'Private preview',
		detail: 'A place for broad, company-specific questions once moderated discussion is open.',
		policy: false,
	},
	{
		id: 'threads',
		label: 'Threads',
		status: 'Private preview',
		detail: 'Conversation stays attributed to its author and remains separate from the sourced record.',
		policy: false,
	},
	{
		id: 'experiences',
		label: 'Experiences',
		status: 'Private preview',
		detail: 'Structured accounts can add context when they disclose what they know and how it was verified.',
		policy: false,
	},
	{
		id: 'official-responses',
		label: 'Official responses',
		status: 'Private preview',
		detail: 'A clearly labeled response lane may sit beside a conversation; it never edits the Research page.',
		policy: false,
	},
	{
		id: 'reviews',
		label: 'Reviews and ratings',
		status: 'Not a Birch lane',
		detail: 'Birch will not turn anecdotes into stars, rankings, complaint rates, or a reputation score.',
		policy: true,
	},
];

const sections = [
	{ id: 'identity', label: 'Documented identity' },
	{ id: 'coverage-context', label: 'Coverage context' },
	{ id: 'official', label: 'Official website and contact' },
	...(d.regulatorRecords.length ? [{ id: 'records', label: 'Records you can look up' }] : []),
	{ id: 'financial-context', label: 'Financial context' },
	...(d.statutoryBasis.length ? [{ id: 'statute', label: 'Statutory basis' }] : []),
	...(d.publications.length ? [{ id: 'publications', label: 'Publications' }] : []),
	...(d.filedForms.length ? [{ id: 'filed-forms', label: 'Filed forms' }] : []),
	{ id: 'notclaimed', label: 'What this page does not claim' },
	{ id: 'source-ledger', label: 'Source ledger' },
	{ id: 'community', label: 'Community lanes' },
	...(allRelated.length ? [{ id: 'related', label: 'Related Research' }] : []),
];

const jsonLd = graph(
	organization(),
	website(),
	breadcrumbs(trail),
	describedOrganization({
		legalName: d.legalName,
		path,
		description,
		url: d.officialUrls[0]?.url ?? '',
		orgType: d.orgType,
		sameAs: d.officialUrls.map((u) => u.url),
	}),
	techArticle({
		headline: d.legalName,
		path,
		description,
		datePublished: d.lastReviewed,
		dateModified: d.lastReviewed,
		author: d.author,
		reviewer: d.reviewer,
		sections: sections.map((s) => s.label),
		about: [d.orgType, ...d.jurisdictions],
		citations: sources.map((s) => ({ name: s.data.title, url: s.data.url, publisher: s.data.publisher })),
	}),
);
---

<BaseLayout title={d.legalName} description={description} jsonLd={jsonLd} pageType="company" machinePath={machinePath}>
	<article>
		<header class="band band-first band-paper answer-head">
			<div class="shell">
				<div style="margin-bottom: var(--s-4)"><Breadcrumbs trail={trail} /></div>
				<ProductContextBar active="companies" />
				<div class="answer-flags">
					<StatusChip kind={d.reviewState} />
					<span class="meta">{ORG_TYPE_LABEL[d.orgType] ?? d.orgType}</span>
					<span class="meta">{d.jurisdictions.join(', ')}</span>
				</div>
				<div class="company-brand-strip">
					<div class="company-brand-mark" aria-hidden="true">{companyInitials}</div>
					<div class="company-brand-name"><span class="eyebrow">Company profile</span><strong>{d.shortName}</strong><span>{officialHost}</span></div>
					<div class="company-brand-slot"><span class="eyebrow">Brand identity slot</span><span class="status status-plain">Planned enrichment</span><small>Logo, colors, and public statistics will come from verified brand or first-party records—not become a Birch rating.</small></div>
				</div>
				<h1>{d.legalName}</h1>
				<dl class="answer-dates">
					<div><dt>Last reviewed</dt><dd><time datetime={d.lastReviewed}>{longDate(d.lastReviewed)}</time></dd></div>
					<div><dt>Author</dt><dd>{d.author}</dd></div>
					<div><dt>Reviewer</dt><dd>{d.reviewer}</dd></div>
					{d.naic?.companyCode && <div><dt>NAIC company code</dt><dd class="num">{d.naic.companyCode}</dd></div>}
					{d.naic?.groupCode && <div><dt>NAIC group code</dt><dd class="num">{d.naic.groupCode}</dd></div>}
					<div><dt>Sources</dt><dd><a href="#source-ledger">{sources.length} records</a></dd></div>
				</dl>
				<div class="company-stat-strip" aria-label="Company record summary">
					<div><span>Source records</span><strong>{sources.length}</strong></div>
					<div><span>Research links</span><strong>{allRelated.length}</strong></div>
					<div><span>Coverage links</span><strong>{relatedCoverages.length}</strong></div>
					<div><span>Community</span><strong>{siteConfig.communityReady ? 'Open' : 'Preview'}</strong></div>
				</div>
			</div>
		</header>

		<section class="band band-tight company-dossier-band" aria-labelledby="company-dossier-overview-title">
			<div class="shell">
				<div class="company-dossier-overview">
					<aside class="company-dossier-identity-card" aria-labelledby="company-dossier-overview-title">
						<div class="company-dossier-card-kicker"><span class="company-dossier-neutral-mark" aria-hidden="true">{companyInitials}</span><span class="eyebrow">Company dossier</span></div>
						<h2 id="company-dossier-overview-title">{d.shortName}</h2>
						<p class="company-dossier-identity-type">{ORG_TYPE_LABEL[d.orgType] ?? d.orgType}</p>
						<a class="company-dossier-official" href={d.officialUrls[0]?.url ?? '#official'} rel="noopener nofollow" target={d.officialUrls[0]?.url ? '_blank' : undefined}>
							<ExternalLink size={14} aria-hidden="true" /> {officialHost}
						</a>
						<div class="company-dossier-actions">
							<a class="btn btn-primary btn-sm" href="/ask">Ask Birch <ArrowRight size={15} aria-hidden="true" /></a>
							<a class="company-dossier-source-link" href="#source-ledger">Read {sources.length} sources</a>
						</div>
					</aside>

					<section class="company-dossier-research-card" aria-labelledby="company-dossier-research-title">
						<div class="company-dossier-card-kicker"><span class="company-context-label"><BookOpen size={15} aria-hidden="true" /> Research lane</span><span class="company-dossier-state">Source-backed</span></div>
						<h2 id="company-dossier-research-title">What Birch can document</h2>
						<div class="company-dossier-summary"><p set:html={cite.inline(d.summary)} /></div>
						<div class="company-dossier-links" aria-label="Research shortcuts">
							<a href="#identity"><span><strong>Identity</strong><small>Regulator and organization record</small></span><ArrowRight size={15} aria-hidden="true" /></a>
							<a href="#coverage-context"><span><strong>Coverage context</strong><small>Declared Research relationships</small></span><ArrowRight size={15} aria-hidden="true" /></a>
							<a href="#official"><span><strong>Official channels</strong><small>Where to verify for yourself</small></span><ArrowRight size={15} aria-hidden="true" /></a>
						</div>
					</section>

					<aside class="company-dossier-community-card" aria-labelledby="company-dossier-community-title">
						<div class="company-dossier-card-kicker"><span class="company-context-label"><MessageCircle size={15} aria-hidden="true" /> Community context</span><span class="company-dossier-state">{siteConfig.communityReady ? 'Open' : 'Private preview'}</span></div>
						<h2 id="company-dossier-community-title">Find the conversation</h2>
						<p>Experiences and responses stay separate from the sourced record, with authorship and moderation visible.</p>
						<nav class="company-dossier-community-links" aria-label="Community lanes">
							<a href="#forums">Forums <ArrowRight size={14} aria-hidden="true" /></a>
							<a href="#threads">Threads <ArrowRight size={14} aria-hidden="true" /></a>
							<a href="#experiences">Experiences <ArrowRight size={14} aria-hidden="true" /></a>
						</nav>
						<p class="mono company-dossier-community-note">{siteConfig.communityReady ? 'Discussion is available through Commons.' : 'Discussion will open after the moderation and account gates are ready.'}</p>
					</aside>
				</div>
			</div>
		</section>

		<div class="band band-tight">
			<div class="shell answer-grid">
				<div>
					<section aria-labelledby="identity">
						<h2 id="identity" class="u-visually-hidden">Verified identity</h2>
						{
							d.regulatoryIdentity && (
								<section class="company-regulatory-snapshot" aria-labelledby="regulatory-snapshot-title">
									<div class="company-regulatory-heading">
										<div>
											<span class="company-context-label"><Landmark size={15} aria-hidden="true" /> Regulator snapshot</span>
											<h2 id="regulatory-snapshot-title">Identity fields from the source record</h2>
										</div>
										<a href={`/sources/${d.regulatoryIdentity.sourceId.id}`} class="company-regulatory-source">Read source <ArrowRight size={14} aria-hidden="true" /></a>
									</div>
									<dl class="company-regulatory-grid">
										<div><dt>California Company ID</dt><dd class="num">{d.regulatoryIdentity.regulatorCompanyId}</dd></div>
										<div><dt>Date authorized in California</dt><dd><time datetime={d.regulatoryIdentity.authorizedDate}>{d.regulatoryIdentity.authorizedDate}</time></dd></div>
										<div><dt>License status in profile</dt><dd>{d.regulatoryIdentity.licenseStatus}</dd></div>
										<div><dt>Company type</dt><dd>{d.regulatoryIdentity.companyType}</dd></div>
										<div><dt>State of domicile</dt><dd>{d.regulatoryIdentity.domicile}</dd></div>
										{d.regulatoryIdentity.agentForService && <div><dt>Agent for service</dt><dd>{d.regulatoryIdentity.agentForService.name}<br /><span class="meta">{d.regulatoryIdentity.agentForService.address}</span></dd></div>}
									</dl>
									<p class="mono company-regulatory-boundary">This is the regulator page as read on {d.lastReviewed}; it is not a live license check. Recheck the source before relying on status or authorized-line information.</p>
								</section>
							)
						}
					</section>

					<EvidenceBoundary
						says="This record makes the organization’s identity, published channels, and source-backed records visible and addressable."
						assumes="Official material, regulator records, and third-party experience remain separate, with dates and jurisdiction attached."
						cannotDecide="It cannot rate the organization or predict an outcome in a specific claim, policy, or interaction."
					/>

					<section class="company-page-map" aria-labelledby="company-page-map-title">
						<div class="company-page-map-heading">
							<span class="eyebrow">Company page map</span>
							<h2 id="company-page-map-title">One record, separate contexts</h2>
							<p>Use the lane that matches the question. Sourced facts, official material, and community conversation never share a status badge.</p>
						</div>
						<div class="company-page-map-grid">
							{pageMap.map((item) => (
								<a class="company-page-map-card" href={item.href}>
									<span class="company-page-map-number">{item.number}</span>
									<span><strong>{item.label}</strong><small>{item.detail}</small></span>
									<ArrowRight size={15} aria-hidden="true" />
								</a>
							))}
						</div>
					</section>

					<section class="answer-section company-context-section" aria-labelledby="coverage-context" data-company-lane="coverage">
						<h2 id="coverage-context">Coverage context</h2>
						<div class="company-context-grid">
							<div class="company-context-card">
								<div class="company-context-label"><BookOpen size={15} aria-hidden="true" /> Sourced scope</div>
								<p>The overview above is the place to read what the cited record says about this organization. This page does not turn that summary into a complete, current line-of-business catalog.</p>
								<div class="company-jurisdictions" aria-label="Jurisdictions in this record">
									<span class="company-context-label">Jurisdiction</span>
									{d.jurisdictions.map((jurisdiction) => <span class="company-jurisdiction">{jurisdiction}</span>)}
								</div>
							</div>
							<div class="company-context-card company-context-card-muted">
								<div class="company-context-label"><ShieldCheck size={15} aria-hidden="true" /> Boundary</div>
								<p>Coverage pages explain insurance concepts. They do not determine whether a person, property, policy, limit, deductible, or claim is covered.</p>
								<p class="mono">Use the official material and the policy actually issued when a decision depends on current terms.</p>
											</div>
									</div>
									<div class="company-coverage-research" data-company-lane="coverage-research" aria-labelledby="company-coverage-research-title">
										<div class="company-coverage-research-head">
											<div>
												<span class="company-context-label"><BookOpen size={15} aria-hidden="true" /> Linked research</span>
												<h3 id="company-coverage-research-title">Coverage research connected to this record</h3>
												<p>These links come only from coverage references declared on the published Research questions connected to this organization.</p>
											</div>
											<span class="company-coverage-count">{relatedCoverages.length} {relatedCoverages.length === 1 ? 'page' : 'pages'}</span>
										</div>
										{
											relatedCoverages.length > 0 ? (
												<div class="company-coverage-grid">
													{relatedCoverages.map((coverage) => (
														<a class="company-coverage-link" href={`/insurance/${coverage.id}`}>
															<span><strong>{coverage.data.name}</strong><small>{excerpt(stripMarkers(coverage.data.definition), 180)}</small></span>
															<ArrowRight size={15} aria-hidden="true" />
														</a>
													))}
												</div>
										) : (
											<div class="company-coverage-empty"><p>No coverage Research page is explicitly connected to this organization yet.</p></div>
										)
										}
						<p class="mono company-coverage-boundary">This is not a current product catalog, availability statement, policy comparison, or coverage determination. A missing link means only that Birch has not declared the relationship.</p>
					</div>
				</section>

					{
						d.filedForms.length > 0 && (
							<section class="answer-section company-filed-forms" id="filed-forms" aria-labelledby="filed-forms-title" data-company-lane="filed-forms">
								<h2 id="filed-forms-title">Filed forms in the source registry</h2>
								<p>These are source-linked documents, not a rehosted form library. Read the source page for the publisher, host, dates, document status, and the exact claims Birch records.</p>
								<div class="company-filed-form-grid">
									{d.filedForms.map((form) => (
										<a class="company-filed-form" href={`/sources/${form.sourceId.id}`}>
											<span><strong>{form.label}</strong><small>{form.note}</small></span>
											<ArrowRight size={15} aria-hidden="true" />
										</a>
									))}
								</div>
								<p class="mono company-filed-form-boundary">A filed form can explain what that document says. It does not establish a carrier's complete product offering, current availability, or the terms of a reader's policy.</p>
							</section>
						)
					}

					<section class="answer-section" aria-labelledby="official">
						<h2 id="official">Official website and contact</h2>
						<ul class="fact-list">
							{
								d.officialUrls.map((link) => (
									<li>
										<ExternalLink size={14} aria-hidden="true" />
										<p>
											<a href={link.url} rel="noopener nofollow" target="_blank">{link.label}</a>
											{link.note && <> - <span set:html={cite.inline(link.note)} /></>}
										</p>
									</li>
								))
							}
							{
								d.contactChannels.map((channel) => (
									<li>
										<Phone size={14} aria-hidden="true" />
										<p>
											<strong>{channel.label}:</strong> <span class="num">{channel.value}</span>
											{channel.note && <> - <span set:html={cite.inline(channel.note)} /></>}
										</p>
									</li>
								))
							}
						</ul>
						<p class="mono" style="margin-top: var(--s-3)">
							Contact details are copied from the organization's own published pages and re-checked on
							the dates in the source ledger. Confirm before you rely on one.
						</p>
					</section>

					{
						d.regulatorRecords.length > 0 && (
							<section class="answer-section" aria-labelledby="records">
								<h2 id="records">Records you can look up yourself</h2>
								<ul class="fact-list">
									{d.regulatorRecords.map((link) => (
										<li>
											<Landmark size={14} aria-hidden="true" />
											<p>
												<a href={link.url} rel="noopener nofollow" target="_blank">{link.label}</a>
												{link.note && <> - <span set:html={cite.inline(link.note)} /></>}
											</p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<section class="answer-section company-context-section" aria-labelledby="financial-context" data-company-lane="financial">
						<h2 id="financial-context">Financial context</h2>
						<div class="company-empty-state">
							<div class="company-empty-state-icon"><Scale size={18} aria-hidden="true" /></div>
							<div>
								<strong>No Birch financial score or conclusion</strong>
								<p>Birch does not calculate, summarize, or rank financial strength, solvency, claim-paying capacity, or reputation. When an official filing or rating-agency record is relevant, it belongs in the source ledger and should be read at the publisher.</p>
								<p class="mono">This empty state is intentional: unavailable or unverified information is not a reason to invent a placeholder number.</p>
							</div>
						</div>
					</section>

					{
						d.statutoryBasis.length > 0 && (
							<section class="answer-section" aria-labelledby="statute">
								<h2 id="statute">Statutory basis</h2>
								<ul class="fact-list">
									{d.statutoryBasis.map((link) => (
										<li>
											<Scale size={14} aria-hidden="true" />
											<p>
												<a href={link.url} rel="noopener nofollow" target="_blank">{link.label}</a>
												{link.note && <> - <span set:html={cite.inline(link.note)} /></>}
											</p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					{
						d.publications.length > 0 && (
							<section class="answer-section" aria-labelledby="publications">
								<h2 id="publications">Publications and guides</h2>
								<ul class="fact-list">
									{d.publications.map((link) => (
										<li>
											<FileText size={14} aria-hidden="true" />
											<p>
												<a href={link.url} rel="noopener nofollow" target="_blank">{link.label}</a>
												{link.note && <> - <span set:html={cite.inline(link.note)} /></>}
											</p>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<section class="answer-section" aria-labelledby="notclaimed">
						<h2 id="notclaimed">What this page does not claim</h2>
						<Callout tone="limit">
							<p>
								This is an identity and records page. It is not a rating, a recommendation, a
								comparison, or a statement about what this organization will do in a specific matter.
							</p>
						</Callout>
						<ul class="fact-list">
							{
								d.whatWeDoNotClaim.map((item) => (
									<li>
										<Ban size={14} aria-hidden="true" style="color: var(--rust)" />
										<p set:html={cite.inline(item)} />
									</li>
								))
							}
						</ul>
					</section>

					<SourceLedger sources={sources} today={TODAY} />

					<CorrectionControl path={path} title={d.legalName} pageType="company" />

					<CiteThisPage
						machinePath={machinePath}
						page={{
							title: d.legalName,
							path,
							published: d.lastReviewed,
							reviewed: d.lastReviewed,
							author: d.author,
							id: entry.id,
							pageType: 'organization',
						}}
					/>

					<section class="answer-section company-context-section" aria-labelledby="community" data-company-lane="community">
						<h2 id="community">Community lanes</h2>
						<p class="company-section-intro">These are separate conversation surfaces, not evidence rows. Every future post needs an author, a date, a subject, and moderation; none is published in this preview.</p>
						<div class="company-community-grid">
							{communityLanes.map((lane) => (
								<article class:list={["company-community-card", lane.policy && "company-community-card-policy"]} id={lane.id}>
									<div class="company-community-top">
										<span class="company-community-icon">{lane.policy ? <LockKeyhole size={16} aria-hidden="true" /> : <MessageCircle size={16} aria-hidden="true" />}</span>
										<span class:list={["company-lane-status", lane.policy && "company-lane-status-policy"]}>{lane.status}</span>
									</div>
									<h3>{lane.label}</h3>
									<p>{lane.detail}</p>
								</article>
							))}
						</div>
						{
							siteConfig.communityReady ? (
								<a class="btn btn-secondary btn-sm" href={commonsHref} rel="noopener">Open discussions about this subject <ArrowRight size={15} aria-hidden="true" /></a>
							) : (
								<Callout tone="privacy" label="Community availability">
									<p><strong>Commons is in private preview.</strong> The discussion layer will open after deployment, database, mail delivery, and moderation gates are ready.</p>
								</Callout>
							)
						}
					</section>

					{
						allRelated.length > 0 && (
							<section class="answer-section" aria-labelledby="related">
								<h2 id="related">Questions that reference this organization</h2>
								<div class="rows">
									{allRelated.map((question) => (
										<a class="row" href={`/questions/${question.id}`}
											data-event="related_question_opened"
											data-insurance-family={question.data.family}
											data-page-type="company">
											<div>
												<h3 class="row-title">{question.data.question}</h3>
												<p>{excerpt(stripMarkers(question.data.shortAnswer), 170)}</p>
												<div class="row-meta">
													<StatusChip kind={question.data.confidence} />
													<span class="meta">Reviewed {longDate(question.data.lastReviewed)}</span>
												</div>
											</div>
											<div class="row-tail"><ArrowRight size={16} aria-hidden="true" /></div>
										</a>
									))}
								</div>
							</section>
						)
					}
				</div>

				<aside class="answer-rail" aria-label="Page contents">
					<nav class="rail-block" aria-labelledby="on-this-page">
						<h2 id="on-this-page">On this page</h2>
						<ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}</ol>
					</nav>
					<div class="rail-block">
						<h2>Record</h2>
						<dl>
							<div><dt>Type</dt><dd>{ORG_TYPE_LABEL[d.orgType] ?? d.orgType}</dd></div>
							<div><dt>Jurisdictions</dt><dd>{d.jurisdictions.join(', ')}</dd></div>
							<div><dt>Primary sources</dt><dd>{sources.filter((s) => s.data.primary).length} of {sources.length}</dd></div>
						</dl>
					</div>
					<div class="rail-block no-print">
						<h2>Machine readable</h2>
						<ul>
							<li><a href={machinePath}>Page record (JSON)</a></li>
							<li><a href="/companies">All organizations</a></li>
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</article>
</BaseLayout>

