---
import { ArrowRight, BookOpen, Building2, MessageCircle, Search, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatusChip from '../../components/StatusChip.astro';
import { stripMarkers } from '../../lib/citations';
import { loadCorpus } from '../../lib/corpus';
import { longDate } from '../../lib/cite';
import { siteConfig } from '../../config/site';
import { breadcrumbs, collectionPage, graph, organization, website } from '../../lib/schema';

import { excerpt } from '../../lib/excerpt';
const corpus = await loadCorpus();
const companies = [...corpus.companies].sort((a, b) => a.data.legalName.localeCompare(b.data.legalName));
const companyCount = companies.length;
const coverageIdsByCompany = new Map<string, Set<string>>();
for (const question of corpus.questions) {
	for (const company of question.data.companies) {
		const coverageIds = coverageIdsByCompany.get(company.id) ?? new Set<string>();
		for (const coverage of question.data.coverages) coverageIds.add(coverage.id);
		coverageIdsByCompany.set(company.id, coverageIds);
	}
}

const ORG_TYPE_LABEL: Record<string, string> = {
	regulator: 'Insurance regulator',
	'standards-organization': 'Standards organization',
	'public-entity': 'Public entity',
	insurer: 'Insurer',
	'insurance-group': 'Insurance group',
	'residual-market': 'Residual market mechanism',
};

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Companies', path: '/companies' },
];

const jsonLd = graph(
	organization(),
	website(),
	breadcrumbs(trail),
	collectionPage({
		name: 'Companies, regulators, and public entities',
		path: '/companies',
		description: 'Verified identity, regulator records, and official channels for the organizations the library references.',
		items: companies.map((c) => ({ name: c.data.legalName, path: `/companies/${c.id}` })),
	}),
);
---

<BaseLayout
	title="Companies, regulators, and public entities"
	description="Verified identity, regulator records, and official channels for the organizations the library references. No ratings summaries and no appetite claims."
	jsonLd={jsonLd}
	pageType="company"
>
	<section class="band band-first band-paper company-directory-hero" aria-labelledby="company-directory-title">
		<div class="shell">
			<Breadcrumbs trail={trail} />
			<div class="company-directory-intro">
				<div>
					<span class="eyebrow">Birch company dossiers</span>
					<h1 id="company-directory-title">Find a company.</h1>
					<p class="lede">Company facts, coverage research, and the sources behind them.</p>
				</div>
				<div class="company-directory-model" aria-label="How a Birch company page is organized">
					<div><BookOpen size={17} aria-hidden="true" /><span><strong>Research</strong><small>Sourced facts and connected coverage</small></span></div>
					<div><ShieldCheck size={17} aria-hidden="true" /><span><strong>Official record</strong><small>Identity, filings, and channels</small></span></div>
					<div><MessageCircle size={17} aria-hidden="true" /><span><strong>Conversation</strong><small>Attributed context in private preview</small></span></div>
				</div>
			</div>

			<div class="company-filters" aria-label="Filter organizations">
				<div class="field company-search-field"><label for="company-search">Find an organization</label><div><Search size={17} aria-hidden="true" /><input id="company-search" type="search" placeholder="Search by name, regulator, or jurisdiction" autocomplete="off" /></div></div>
				<div class="field"><label for="company-type">Show</label><select id="company-type"><option value="all">All organizations</option><option value="insurer">Insurers</option><option value="regulator">Regulators</option><option value="public-entity">Public entities</option><option value="standards-organization">Standards organizations</option><option value="residual-market">Residual-market mechanisms</option></select></div>
			</div>
			<div class="company-directory-boundary"><Building2 size={17} aria-hidden="true" /><p><strong>These pages do not rank or rate anyone.</strong> Birch does not publish “best,” “cheapest,” reputation scores, or appetite claims. Every material record carries its publisher and date.</p><span class="company-filter-status" id="company-filter-status" role="status" aria-live="polite">Showing {companyCount} organizations.</span></div>
		</div>
	</section>

	<section class="band band-tight" aria-labelledby="company-results-title">
		<div class="shell">
			<div class="company-results-head"><h2 id="company-results-title">Explore organizations</h2><div class="company-result-actions"><button class="btn btn-quiet btn-sm" id="company-filter-reset" type="button" hidden>Clear filters</button><a class="text-link" href="/sources">Source registry <ArrowRight size={14} aria-hidden="true" /></a></div></div>
			<div class="company-record-grid" id="company-rows">
				{
					companies.map((company) => {
						const initials = company.data.shortName.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || 'CO';
						return (
							<a class="company-record-card" href={`/companies/${company.id}`} data-company-row data-company-type={company.data.orgType} data-company-search={`${company.data.legalName} ${company.data.shortName} ${company.data.jurisdictions.join(' ')}`}>
								<div class="company-record-card-top"><span class="company-record-mark" aria-hidden="true">{initials}</span><StatusChip kind={company.data.reviewState} /></div>
								<span class="company-record-type">{ORG_TYPE_LABEL[company.data.orgType] ?? company.data.orgType}</span>
								<h3>{company.data.legalName}</h3>
								<p>{excerpt(stripMarkers(company.data.summary), 180)}</p>
								<div class="company-record-facts">
									<span><strong>{company.data.sourceIds.length}</strong> source records</span>
									<span><strong>{coverageIdsByCompany.get(company.id)?.size ?? 0}</strong> coverage links</span>
									<span>{company.data.jurisdictions.join(', ')}</span>
								</div>
								<div class="company-row-signals" aria-label="Record signals">
									{company.data.regulatoryIdentity && <span class="company-signal company-signal-regulator">Regulator snapshot</span>}
									<span class="company-signal company-signal-community">{siteConfig.communityReady ? 'Community available' : 'Community private preview'}</span>
								</div>
									<div class="company-record-card-foot"><span>Record dated {longDate(company.data.lastReviewed)}</span><span>View company <ArrowRight size={15} aria-hidden="true" /></span></div>
							</a>
						);
					})
				}
			</div>
			<p class="company-filter-empty" id="company-filter-empty" hidden>No organization matches those filters. Try a broader name or choose all organizations.</p>

			<div class="company-next-step">
				<div>
					<span class="eyebrow">Add context</span>
					<strong>Have a California experience or a source correction?</strong>
					<p>Prepare it privately first. Public discussion opens through the separate, moderated Community.</p>
				</div>
				<a class="btn btn-secondary btn-sm" href="/contribute?type=experience">Prepare a contribution <ArrowRight size={15} aria-hidden="true" /></a>
			</div>
		</div>
	</section>

	<section class="band band-paper">
		<div class="shell">
			<span class="eyebrow">Inclusion policy</span>
			<h2>How an organization gets a page here</h2>
			<div class="prose">
				<p>
					An organization gets a page when the library already answers questions that depend on it and
					when its identity, official channels, and public records can be sourced and dated. That
					means the first entries are regulators, standards bodies, and statutory public entities,
					because those are the bodies whose records actually settle questions.
				</p>
				<p>
					Insurer pages are held to the same bar. Until an insurer page can carry sourced, current
					identity and product context plus links to the regulator records and rating agencies that
					publish the numbers, there is no page. A directory of thin insurer pages built from scraped
					marketing copy would add volume and subtract trust.
				</p>
				<p>
					Inclusion is never for sale, and neither is position in this list. See{' '}
					<a href="/editorial-policy">the editorial policy</a> for the full statement.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const search = document.getElementById('company-search') as HTMLInputElement | null;
	const type = document.getElementById('company-type') as HTMLSelectElement | null;
	const status = document.getElementById('company-filter-status');
	const empty = document.getElementById('company-filter-empty');
	const reset = document.getElementById('company-filter-reset');
	const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-company-row]'));

	function applyFilters() {
		const query = search?.value.trim().toLowerCase() ?? '';
		const selectedType = type?.value ?? 'all';
		let visible = 0;
		for (const row of rows) {
			const matchesQuery = !query || (row.dataset.companySearch ?? '').toLowerCase().includes(query);
			const matchesType = selectedType === 'all' || row.dataset.companyType === selectedType;
			row.hidden = !(matchesQuery && matchesType);
			if (!row.hidden) visible += 1;
		}
		if (status) status.textContent = `Showing ${visible} of ${rows.length} organizations.`;
		if (empty) empty.hidden = visible !== 0;
		if (reset) reset.hidden = !query && selectedType === 'all';
	}

	search?.addEventListener('input', applyFilters);
	type?.addEventListener('change', applyFilters);
	reset?.addEventListener('click', () => {
		if (search) search.value = '';
		if (type) type.value = 'all';
		applyFilters(); search?.focus();
	});
</script>

<style>
	.company-result-actions { display: flex; align-items: center; gap: 16px; }
	.company-result-actions [hidden] { display: none; }
	.company-directory-hero { padding-block: clamp(var(--s-6), 5vw, var(--s-10)) var(--s-6); }
	.company-directory-hero .crumbs { margin-bottom: var(--s-6); }
	.company-directory-intro { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .7fr); gap: clamp(var(--s-8), 6vw, var(--s-12)); align-items: end; }
	.company-directory-intro h1 { max-width: 20ch; margin: var(--s-3) 0 var(--s-4); font: 600 clamp(2.2rem, 4vw, 3.4rem)/1.08 var(--font-sans); letter-spacing: -.05em; }
	.company-directory-intro .lede { max-width: 58ch; margin: 0; color: var(--body); }
	.company-directory-model { display: grid; gap: 1px; border: 1px solid var(--line-strong); border-radius: var(--r-3); overflow: hidden; background: var(--line); box-shadow: var(--elev-1); }
	.company-directory-model > div { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: var(--s-3); align-items: center; padding: var(--s-3) var(--s-4); background: var(--paper); }
	.company-directory-model svg { color: var(--brand-blue-text); }
	.company-directory-model strong, .company-directory-model small { display: block; }
	.company-directory-model strong { color: var(--ink); font-size: var(--text-sm); }
	.company-directory-model small { margin-top: 2px; color: var(--muted); font-size: var(--text-xs); }
	.company-filters { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: var(--s-3); margin-top: var(--s-8); padding: var(--s-4); border: 1px solid var(--line-strong); background: var(--white); border-radius: var(--r-3); box-shadow: var(--elev-2); }
	.company-filters .field { margin: 0; }
	.company-search-field > div { position: relative; display: flex; align-items: center; }
	.company-search-field svg { position: absolute; left: 12px; color: var(--faint); pointer-events: none; }
	.company-search-field input { padding-left: 38px; }
	.company-directory-boundary { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--s-3); align-items: center; margin-top: var(--s-3); color: var(--muted); }
	.company-directory-boundary > svg { color: var(--brand-blue-text); }
	.company-directory-boundary p { margin: 0; font-size: var(--text-xs); line-height: var(--leading-snug); }
	.company-directory-boundary strong { color: var(--ink); }
	.company-filter-status { margin: 0; white-space: nowrap; color: var(--muted); font: var(--text-xs)/1.5 var(--font-mono); }
	.company-filter-empty { margin: var(--s-6) 0 0; padding: var(--s-5); border: 1px dashed var(--line-strong); color: var(--muted); background: var(--paper); }
	.company-results-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-5); }
	.company-results-head h2 { margin: 0; font: 600 var(--text-xl)/1.25 var(--font-sans); letter-spacing: -.025em; }
	.company-results-head .text-link { display: inline-flex; align-items: center; gap: 5px; color: var(--brand-blue-text); font-size: var(--text-sm); font-weight: 650; text-decoration: none; }
	.company-record-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); margin-top: var(--s-6); }
	.company-record-card { display: flex; min-height: 370px; flex-direction: column; padding: var(--s-5); border: 1px solid var(--line-strong); border-radius: var(--r-3); background: var(--paper); color: var(--body); text-decoration: none; transition: transform var(--dur-2) var(--ease-soft), border-color var(--dur-1) var(--ease), box-shadow var(--dur-2) var(--ease); }
	.company-record-card:hover, .company-record-card:focus-visible { transform: translateY(-3px); border-color: var(--brand-blue); box-shadow: var(--elev-2); }
	.company-record-card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
	.company-record-mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: var(--r-3); background: var(--brand-blue); color: var(--white); font-family: var(--font-display); font-size: var(--text-md); }
	.company-record-type { margin-top: var(--s-5); color: var(--brand-blue-text); font: var(--text-2xs)/1.3 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.company-record-card h3 { max-width: 28ch; margin: var(--s-2) 0 var(--s-3); font: 600 clamp(1.2rem, 2vw, 1.5rem)/1.3 var(--font-sans); letter-spacing: -.025em; }
	.company-record-card > p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.company-record-facts { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); margin-top: var(--s-5); color: var(--muted); font-size: var(--text-xs); }
	.company-record-facts strong { color: var(--ink); font-weight: 650; }
	.company-row-signals { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); margin-top: var(--s-2); }
	.company-signal { padding: 3px 7px; border: var(--bw-hair) solid var(--line); border-radius: 999px; background: var(--paper); color: var(--muted); font: var(--text-2xs)/1.3 var(--font-mono); }
	.company-signal-regulator { border-color: color-mix(in srgb, var(--brand-blue) 40%, var(--line)); background: var(--blue-wash); color: var(--brand-blue-text); }
	.company-signal-community { border-style: dashed; }
	.company-record-card-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: auto; padding-top: var(--s-5); border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-xs); }
	.company-record-card-foot span:last-child { display: inline-flex; align-items: center; gap: 5px; color: var(--brand-blue-text); font-weight: 650; }
	.company-next-step { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); margin-top: var(--s-6); padding: var(--s-5); border: 1px solid var(--line-strong); border-left: 3px solid var(--brand-blue); background: var(--paper); border-radius: var(--r-3); }
	.company-next-step strong { display: block; color: var(--ink); }
	.company-next-step p { margin: var(--s-1) 0 0; color: var(--muted); font-size: var(--text-sm); }
	@media (max-width: 820px) { .company-directory-intro, .company-record-grid { grid-template-columns: minmax(0, 1fr); } .company-directory-model { max-width: 620px; } .company-directory-boundary { grid-template-columns: auto minmax(0, 1fr); } .company-filter-status { grid-column: 2; white-space: normal; } }
	@media (max-width: 640px) { .company-directory-intro h1 { font-size: clamp(2.8rem, 14vw, 4rem); } .company-filters { grid-template-columns: minmax(0, 1fr); } .company-results-head, .company-next-step { align-items: flex-start; flex-direction: column; } .company-record-card { min-height: 0; } .company-next-step .btn { width: 100%; } }
	@media (prefers-reduced-motion: reduce) { .company-record-card { transition: none; } .company-record-card:hover, .company-record-card:focus-visible { transform: none; } }
</style>
