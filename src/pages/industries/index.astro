---
import { ArrowRight, Compass, FileText, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { loadCorpus } from '../../lib/corpus';
import { allIndustryHubs } from '../../lib/industry-hub';
import { breadcrumbs, collectionPage, graph, organization, website } from '../../lib/schema';
import { longDate } from '../../lib/cite';

const corpus = await loadCorpus();
const hubs = allIndustryHubs(corpus);
const published = hubs.filter((hub) => hub.hasSubstance);
const planned = hubs.filter((hub) => !hub.hasSubstance);

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Industries and situations', path: '/industries' },
];

const description = `Browse insurance research by the situation or industry a person is actually navigating. Birch gathers published coverage pages, answered questions, worked examples, organizations, and source records without turning a context page into a recommendation or ranking.`;

const jsonLd = graph(
	organization(),
	website(),
	breadcrumbs(trail),
	collectionPage({
		name: 'Insurance by industry and situation',
		path: '/industries',
		description,
		items: published.map((hub) => ({ name: hub.name, path: `/industries/${hub.id}` })),
	}),
);
---

<BaseLayout title="Insurance by industry and situation" description={description} jsonLd={jsonLd} pageType="editorial">
	<PageHeader
		eyebrow="Industries and situations"
		title="Start with the situation. Follow the evidence."
		lede={`${published.length} context hubs gather the insurance lines, questions, examples, organizations, and source records most relevant to a role or decision. Free to read, with no account required.`}
		trail={trail}
	/>

	<section class="band band-tight">
		<div class="shell">
			<Callout tone="limit" label="How to use a context hub">
				<p>
					A hub is a navigation index, not a coverage determination. It gathers existing Birch records so
					you can move from a broad situation to the exact coverage page, question, example, organization,
					and source that you need to inspect.
				</p>
				<p>
					<strong>Nothing here ranks an insurer or predicts what a carrier will write.</strong> Read the
					linked record for its assumptions, jurisdiction, review date, and source ledger.
				</p>
			</Callout>

			<div class="industry-grid" aria-label="Published industry and situation hubs">
				{
					published.map((hub) => (
						<a class="industry-card" href={`/industries/${hub.id}`}>
							<div class="industry-card-top">
								<span class="industry-icon" aria-hidden="true"><Compass size={20} stroke-width={1.7} /></span>
								<span class="industry-kicker">{hub.sourceIds.length} source records</span>
							</div>
							<h2>{hub.name}</h2>
							<p>{hub.descriptor}</p>
							<div class="industry-card-meta">
								<span>{hub.coverages.length} coverage pages</span>
								<span>{hub.questions.length} questions</span>
								<span>Last checked {longDate(hub.lastReviewed)}</span>
							</div>
							<div class="industry-card-foot"><span>Open context</span><ArrowRight size={15} aria-hidden="true" /></div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="band band-paper" aria-labelledby="context-model">
		<div class="shell">
			<span class="eyebrow">The context model</span>
			<h2 id="context-model">One starting point, four useful next steps</h2>
			<div class="context-model-grid">
				<div class="context-model-item">
					<ShieldCheck size={18} aria-hidden="true" />
					<strong>Coverage</strong>
					<span>Understand the line before trying to compare it.</span>
				</div>
				<div class="context-model-item">
					<FileText size={18} aria-hidden="true" />
					<strong>Questions</strong>
					<span>Read the edge cases people actually ask about.</span>
				</div>
				<div class="context-model-item">
					<Compass size={18} aria-hidden="true" />
					<strong>Sources</strong>
					<span>Open the record behind each published claim.</span>
				</div>
				<div class="context-model-item">
					<ArrowRight size={18} aria-hidden="true" />
					<strong>Discussion</strong>
					<span>Use Community later for clearly labelled human context.</span>
				</div>
			</div>
			<div class="industry-bottom-cta">
				<div>
					<span class="eyebrow">Not sure where to begin?</span>
					<strong>Ask Birch in plain language.</strong>
					<p>The lookup stays on your device and returns only published library material.</p>
				</div>
				<a class="btn btn-primary" href="/ask">Ask Birch <ArrowRight size={15} aria-hidden="true" /></a>
			</div>
		</div>
	</section>

	{
		planned.length > 0 && (
			<section class="band band-tight" aria-labelledby="planned-context">
				<div class="shell">
					<span class="eyebrow">Declared gaps</span>
					<h2 id="planned-context">Context we have named but not published yet</h2>
					<p class="lede">These situations stay out of the sitemap until the corpus has enough published material to make the page useful.</p>
					<ul class="planned-list">
						{planned.map((hub) => <li><span>{hub.name}</span><small>{hub.sourceIds.length} source records so far</small></li>)}
					</ul>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.industry-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: var(--s-8); border: 1px solid var(--line-strong); background: var(--line-strong); }
	.industry-card { display: grid; gap: var(--s-3); min-height: 250px; padding: var(--s-5); background: var(--paper); color: var(--ink); text-decoration: none; transition: background var(--dur-2) var(--ease), color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease-soft), box-shadow var(--dur-2) var(--ease); }
	.industry-card:hover, .industry-card:focus-visible { position: relative; z-index: 1; background: var(--brand-blue-wash); color: var(--brand-blue-deep); box-shadow: var(--elev-2); transform: translateY(-2px); }
	.industry-card-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
	.industry-icon { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--brand-blue-text); background: var(--cream); }
	.industry-kicker { color: var(--gold-text); font: var(--text-2xs)/1.3 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
	.industry-card h2 { margin: 0; color: inherit; font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: var(--leading-snug); }
	.industry-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.industry-card-meta { display: flex; flex-wrap: wrap; gap: 5px var(--s-3); color: var(--muted); font: var(--text-2xs)/1.3 var(--font-mono); }
	.industry-card-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: auto; padding-top: var(--s-3); border-top: 1px solid var(--line); color: var(--brand-blue-text); font-size: var(--text-xs); font-weight: 600; }
	.context-model-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: var(--s-5); border: 1px solid var(--line-strong); background: var(--line-strong); }
	.context-model-item { display: grid; align-content: start; gap: var(--s-2); min-height: 140px; padding: var(--s-4); background: var(--paper); }
	.context-model-item svg { color: var(--gold-text); }
	.context-model-item strong { font-size: var(--text-sm); }
	.context-model-item span { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.industry-bottom-cta { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); margin-top: var(--s-8); padding: var(--s-5); border: 1px solid var(--line-strong); border-left: 3px solid var(--brand-blue); background: var(--brand-blue-wash); border-radius: var(--r-3); }
	.industry-bottom-cta strong { display: block; color: var(--ink); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; }
	.industry-bottom-cta p { margin: var(--s-1) 0 0; color: var(--muted); font-size: var(--text-sm); }
	.planned-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: var(--s-5) 0 0; padding: 0; list-style: none; border: 1px solid var(--line); background: var(--line); }
	.planned-list li { display: grid; gap: 4px; padding: var(--s-3) var(--s-4); background: var(--paper); }
	.planned-list span { font-size: var(--text-sm); color: var(--ink-2); }
	.planned-list small { color: var(--muted); font: var(--text-2xs)/1.3 var(--font-mono); }
	@media (max-width: 720px) { .industry-grid, .context-model-grid, .planned-list { grid-template-columns: minmax(0, 1fr); } .industry-bottom-cta { align-items: flex-start; flex-direction: column; } .industry-bottom-cta .btn { width: 100%; justify-content: center; } }
</style>
