---
import { ArrowLeft, ArrowRight, Check, FileText, LockKeyhole, UserRound } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FocusPageHeader from '../components/FocusPageHeader.astro';
import { breadcrumbs, graph, organization, website } from '../lib/schema';

const kinds = [
  { value: 'experience', title: 'An experience', detail: 'What happened, in your own words.', icon: UserRound },
  { value: 'research', title: 'Research', detail: 'An explanation with sources.', icon: FileText },
  { value: 'correction', title: 'A correction', detail: 'Something that needs checking.', icon: Check },
];
const jsonLd = graph(organization(), website(), breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Contribute', path: '/contribute' }]));
---
<BaseLayout title="Contribute to Birch" description="Prepare a private insurance experience, research note, or source correction. Preview your words before any future submission." jsonLd={jsonLd} pageType="editorial">
  <section class="contribution-page shell">
    <FocusPageHeader eyebrow="Contribute to Birch" title="Share what you know." description="An experience, a sourced explanation, or a useful correction." />
    <div class="draft-notice"><LockKeyhole size={15} aria-hidden="true" /><p><strong>Private preview.</strong> Nothing is sent or saved. Text is lost when you leave or reload. Signup and posting stay closed.</p></div>
    <div class="contribution-workspace">
      <div class="contribution-surface">
        <div class="contribution-progress" aria-label="Contribution preview progress"><span id="write-step" aria-current="step">1. Write</span><ArrowRight size={13} aria-hidden="true" /><span id="preview-step">2. Preview</span><span class="contribution-local">This page only</span></div>
        <div id="draft-editor">
          <form id="contribution-form">
            <fieldset id="draft-fields" disabled>
              <legend class="u-visually-hidden">Prepare a private contribution</legend>
              <fieldset class="contribution-kind">
                <legend>What would you like to add?</legend>
                <div class="contribution-kind-options">
                  {kinds.map(({value,title,detail,icon: Icon},index) => <label><input type="radio" name="type" value={value} checked={index === 0} /><span class="kind-content"><Icon size={18} aria-hidden="true" /><strong>{title}</strong><small>{detail}</small></span></label>)}
                </div>
              </fieldset>
              <div class="field"><label for="contribution-title">Title</label><input id="contribution-title" type="text" placeholder="What should someone else understand?" maxlength="120" required /></div>
              <div class="field"><label for="contribution-line">Coverage</label><select id="contribution-line"><option>Homeowners</option><option>Auto</option><option>Wildfire</option><option>Earthquake</option><option>Renters</option><option>Workers compensation</option><option>Business insurance</option><option>Other / not sure</option></select></div>
              <div class="field"><label for="contribution-body" id="draft-body-label">Your experience</label><textarea id="contribution-body" rows="7" maxlength="12000" required aria-describedby="draft-guidance draft-privacy" placeholder="What happened? What did you ask? What would have helped you understand?"></textarea><span class="hint" id="draft-guidance">Separate what happened from what you think caused it. Do not decide whether a claim should have been paid.</span></div>
              <details class="draft-source-details" id="draft-source-details"><summary>Sources and context <span>Optional in this preview</span></summary><div class="field"><label for="contribution-sources">Source links or document titles</label><textarea id="contribution-sources" rows="3" maxlength="3000" placeholder="Link to a public source or name the document. Do not paste private correspondence."></textarea><span class="hint">Links stay as text in your private preview. Birch has not checked them.</span></div></details>
              <p class="draft-privacy" id="draft-privacy">Leave out names, addresses, policy and claim numbers, health details, and private documents. This preview does not detect or redact sensitive information.</p>
              <label class="check draft-confirmation"><input id="draft-private-check" type="checkbox" required /><span>I have checked my draft for personal and policy identifiers.</span></label>
              <div class="draft-actions"><button class="btn btn-primary" type="button" id="preview-draft">Preview contribution <ArrowRight size={16} aria-hidden="true" /></button><button class="btn btn-quiet" type="button" id="contribution-reset">Clear</button></div>
            </fieldset>
          </form>
          <noscript><p class="draft-privacy">JavaScript is required for this local-only draft preview. The fields are disabled so your draft cannot be submitted. You can still <a href="/editorial-policy">read the contribution rules</a>.</p></noscript>
        </div>
        <section id="draft-preview" hidden aria-labelledby="draft-preview-heading">
          <div class="preview-label"><span id="preview-kind">Experience</span><span id="preview-coverage"></span><span>Not submitted</span></div>
          <h2 id="draft-preview-heading" tabindex="-1"></h2>
          <p id="preview-body" class="preview-copy"></p>
          <div id="preview-source-block" hidden><h3>Sources supplied in this draft</h3><p id="preview-sources" class="preview-copy"></p><small>Not checked by Birch.</small></div>
          <div class="preview-next"><LockKeyhole size={18} aria-hidden="true" /><div><strong>Your words, before they go anywhere.</strong><p>This is a private preview, not a submission. Accounts, verification, and editorial review are required before future publication.</p></div></div>
          <div class="draft-actions"><button class="btn btn-secondary" type="button" id="edit-draft"><ArrowLeft size={15} aria-hidden="true" /> Keep editing</button><a class="text-link" href="/design/account-preview">See the account preview <ArrowRight size={15} aria-hidden="true" /></a></div>
        </section>
        <div id="clear-confirmation" class="draft-clear-confirmation" hidden><p>Clear this draft? It cannot be recovered.</p><button type="button" class="btn btn-secondary btn-sm" id="confirm-clear">Clear draft</button><button type="button" class="btn btn-quiet btn-sm" id="cancel-clear">Keep writing</button></div>
        <p id="contribution-status" class="live-status" role="status" aria-live="polite"></p>
      </div>
      <aside class="contribution-context">
        <span class="eyebrow">A useful contribution</span><h2 id="context-title">Start with what happened.</h2><p id="context-description">A first-person account helps another reader ask better questions. It stays labeled as an experience, separate from sourced research.</p>
        <div class="contribution-context-process"><h3>Before anything is public</h3><ol><li><strong>A real account</strong><span>Sign in and choose what is public.</span></li><li><strong>The right context</strong><span>Declare your role, affiliation, and sources.</span></li><li><strong>Human review</strong><span>Check privacy, scope, and any revisions.</span></li></ol></div>
        <a class="text-link" href="/editorial-policy">Contribution standards <ArrowRight size={14} aria-hidden="true" /></a>
        <a class="text-link" href="/professionals">For professionals <ArrowRight size={14} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contribution-form');
  const fields = document.querySelector<HTMLFieldSetElement>('#draft-fields');
  const editor = document.querySelector<HTMLElement>('#draft-editor');
  const preview = document.querySelector<HTMLElement>('#draft-preview');
  const title = document.querySelector<HTMLInputElement>('#contribution-title');
  const body = document.querySelector<HTMLTextAreaElement>('#contribution-body');
  const sources = document.querySelector<HTMLTextAreaElement>('#contribution-sources');
  const coverage = document.querySelector<HTMLSelectElement>('#contribution-line');
  const status = document.querySelector<HTMLElement>('#contribution-status');
  const clearConfirmation = document.querySelector<HTMLElement>('#clear-confirmation');
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="type"]')];
  const copy = {
    experience: { label: 'Your experience', title: 'Start with what happened.', description: 'A first-person account helps another reader ask better questions. It stays labeled as an experience, separate from sourced research.', guidance: 'Separate what happened from what you think caused it. Do not decide whether a claim should have been paid.', placeholder: 'What happened? What did you ask? What would have helped you understand?' },
    research: { label: 'Your explanation', title: 'Make the explanation checkable.', description: 'Write within your specialty. Attach original sources and disclose your role, jurisdiction, affiliation, and conflicts before publication.', guidance: 'State the question, explain what the sources support, and name the limitations. A professional credential is not editorial approval.', placeholder: 'What question are you answering? What do the original sources say? What remains uncertain?' },
    correction: { label: 'What needs checking?', title: 'Point to the exact claim.', description: 'Name the Birch page, the wording that needs attention, and the original source. A correction should be traceable, not just a different opinion.', guidance: 'Include the page or claim address, the relevant source and date, and why the current wording needs checking.', placeholder: 'Which page and sentence? What should be checked against the original document?' },
  } as const;
  type Kind = keyof typeof copy;
  const kind = (): Kind => {
    const value = radios.find(radio => radio.checked)?.value;
    return value === 'research' || value === 'correction' ? value : 'experience';
  };
  const write = (selector: string, value: string) => { const element = document.querySelector(selector); if (element) element.textContent = value; };
  function updateKind() {
    const current = kind();
    const text = copy[current];
    write('#draft-body-label', text.label); write('#draft-guidance', text.guidance);
    write('#context-title', text.title); write('#context-description', text.description);
    if (body) body.placeholder = text.placeholder;
    const detail = document.querySelector<HTMLDetailsElement>('#draft-source-details');
    if (detail) detail.open = current !== 'experience';
  }
  function showPreview(show: boolean) {
    if (!editor || !preview) return;
    editor.hidden = show; preview.hidden = !show;
    document.querySelector('#write-step')?.toggleAttribute('data-inactive', show);
    document.querySelector('#preview-step')?.toggleAttribute('data-active', show);
    document.querySelector('#write-step')?.setAttribute('aria-current', show ? 'false' : 'step');
    document.querySelector('#preview-step')?.setAttribute('aria-current', show ? 'step' : 'false');
    if (clearConfirmation) clearConfirmation.hidden = true;
    if (show) document.querySelector<HTMLElement>('#draft-preview-heading')?.focus();
    else body?.focus();
  }
  // Install the no-submit boundary before enabling any input. Draft prose has no
  // form field names, never enters a URL/storage, and is rendered as text only.
  form?.addEventListener('submit', event => event.preventDefault());
  radios.forEach(radio => radio.addEventListener('change', updateKind));
  const requested = new URLSearchParams(window.location.search).get('type');
  const chosen = radios.find(radio => radio.value === requested);
  if (chosen) chosen.checked = true;
  updateKind();
  document.querySelector('#preview-draft')?.addEventListener('click', () => {
    if (!form || !title || !body || !sources || !coverage) return;
    title.setCustomValidity(title.value.trim() ? '' : 'Add a title.');
    body.setCustomValidity(body.value.trim() ? '' : 'Add your draft.');
    if (!form.reportValidity()) return;
    write('#preview-kind', kind() === 'experience' ? 'First-person experience' : kind() === 'research' ? 'Research draft' : 'Correction draft');
    write('#preview-coverage', coverage.value);
    write('#draft-preview-heading', title.value.trim());
    write('#preview-body', body.value.trim());
    write('#preview-sources', sources.value.trim());
    const sourceBlock = document.querySelector<HTMLElement>('#preview-source-block');
    if (sourceBlock) sourceBlock.hidden = !sources.value.trim();
    if (status) status.textContent = 'Private preview ready. Nothing has been sent, saved, or submitted.';
    showPreview(true);
  });
  [title,body].forEach(field => field?.addEventListener('input', () => { field.setCustomValidity(''); if (status) status.textContent = ''; }));
  document.querySelector('#edit-draft')?.addEventListener('click', () => { showPreview(false); if (status) status.textContent = 'Editing your private draft.'; });
  document.querySelector('#contribution-reset')?.addEventListener('click', () => { if (clearConfirmation) clearConfirmation.hidden = false; document.querySelector<HTMLElement>('#cancel-clear')?.focus(); });
  document.querySelector('#cancel-clear')?.addEventListener('click', () => { if (clearConfirmation) clearConfirmation.hidden = true; document.querySelector<HTMLElement>('#contribution-reset')?.focus(); });
  document.querySelector('#confirm-clear')?.addEventListener('click', () => {
    form?.reset(); title?.setCustomValidity(''); body?.setCustomValidity(''); updateKind();
    ['#draft-preview-heading','#preview-body','#preview-sources'].forEach(selector => write(selector,''));
    showPreview(false); title?.focus(); if (status) status.textContent = 'Draft cleared.';
  });
  if (fields) fields.disabled = false;
</script>

<style>
  .contribution-page { padding-bottom: 64px; }
  .draft-notice { display: flex; align-items: flex-start; justify-content: center; gap: 8px; max-width: 760px; margin: 0 auto 32px; color: var(--muted); }
  .draft-notice svg { flex-shrink: 0; margin-top: 2px; }
  .draft-notice p { margin: 0; font-size: var(--text-xs); line-height: 1.6; }
  .contribution-workspace { display: grid; grid-template-columns: minmax(0,760px) minmax(220px,260px); justify-content: center; align-items: start; gap: 48px; }
  .contribution-surface { min-width: 0; border: 1px solid var(--line); background: var(--white); border-radius: var(--r-4); box-shadow: var(--elev-1); overflow: hidden; }
  .contribution-progress { display: flex; align-items: center; gap: 12px; padding: 16px 24px; border-bottom: 1px solid var(--line); font-size: var(--text-xs); color: var(--muted); background: var(--paper); }
  .contribution-progress [aria-current="step"] { color: var(--brand-blue-text); font-weight: 600; }
  .contribution-local { margin-left: auto; font-size: var(--text-2xs); }
  #draft-editor, #draft-preview { padding: 28px; }
  fieldset { min-width: 0; padding: 0; margin: 0; border: 0; }
  .contribution-kind { margin-bottom: 24px; }
  .contribution-kind legend { font-size: var(--text-sm); font-weight: 600; margin-bottom: 12px; }
  .contribution-kind-options { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8px; }
  .contribution-kind-options label { position: relative; cursor: pointer; }
  .contribution-kind-options input { position: absolute; right: 12px; top: 14px; width: 15px; height: 15px; margin: 0; accent-color: var(--brand-blue); }
  .kind-content { display: grid; gap: 9px; height: 100%; min-height: var(--tap); border: 1px solid var(--line); border-radius: var(--r-3); padding: 16px 12px; transition: background var(--dur-1), border-color var(--dur-1); }
  .kind-content svg { color: var(--brand-blue-text); }
  .kind-content strong { font: 500 var(--text-sm)/1.4 var(--font-sans); }
  .kind-content small { color: var(--muted); font-size: var(--text-2xs); line-height: 1.5; }
  .contribution-kind-options input:checked + span { border-color: var(--brand-blue); background: var(--brand-blue-wash); }
  .contribution-kind-options input:focus-visible + span { outline: 2px solid var(--brand-blue); outline-offset: 3px; }
  .contribution-kind-options label:hover .kind-content { border-color: var(--brand-blue); }
  .field { margin-bottom: 20px; } textarea { resize: vertical; }
  .draft-source-details { border-block: 1px solid var(--line); margin-bottom: 20px; }
  .draft-source-details summary { min-height: var(--tap); padding: 12px 0; font-size: var(--text-sm); cursor: pointer; }
  .draft-source-details summary span { margin-left: 8px; color: var(--muted); font-size: var(--text-2xs); }
  .draft-source-details .field { margin-top: 12px; }
  .draft-privacy { font-size: var(--text-xs); color: var(--muted); line-height: 1.65; }
  .draft-confirmation { align-items: flex-start; margin-top: 16px; font-size: var(--text-xs); line-height: 1.6; }
  .draft-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .contribution-context { padding-top: 8px; }
  .contribution-context h2 { font: 500 var(--text-xl)/1.35 var(--font-sans); letter-spacing: -.025em; margin: 12px 0; }
  .contribution-context p { font-size: var(--text-sm); color: var(--muted); line-height: 1.7; }
  .contribution-context-process { padding-block: 20px; border-top: 1px solid var(--line); margin-top: 24px; }
  .contribution-context h3 { font: 600 var(--text-xs)/1.4 var(--font-sans); }
  .contribution-context ol { padding-left: 20px; }
  .contribution-context li { padding-left: 5px; margin: 14px 0; color: var(--muted); font-size: var(--text-xs); }
  .contribution-context li strong, .contribution-context li span { display: block; line-height: 1.6; }
  .contribution-context li strong { color: var(--body); font-weight: 500; }
  .contribution-context > a { display: flex; min-height: var(--tap); font-size: var(--text-xs); }
  .preview-label { display: flex; flex-wrap: wrap; gap: 12px; font-size: var(--text-xs); color: var(--muted); }
  .preview-label span:first-child { color: var(--brand-blue-text); }
  #draft-preview h2 { margin: 24px 0; font: 600 var(--text-2xl)/1.3 var(--font-sans); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .preview-copy { white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--text-base); line-height: 1.75; }
  #preview-source-block { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  #preview-source-block h3 { font: 500 var(--text-sm)/1.4 var(--font-sans); }
  #preview-source-block small { color: var(--muted); }
  .preview-next { display: flex; gap: 12px; margin-top: 32px; padding: 20px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-3); }
  .preview-next svg { flex-shrink: 0; color: var(--brand-blue-text); }
  .preview-next strong { font-size: var(--text-sm); }
  .preview-next p { margin: 8px 0 0; font-size: var(--text-xs); color: var(--muted); line-height: 1.6; }
  .draft-clear-confirmation { padding: 20px 28px; border-top: 1px solid var(--line); }
  .draft-clear-confirmation p { font-size: var(--text-sm); }
  .live-status:empty { display: none; } .live-status { padding: 0 28px 20px; margin: 0; font-size: var(--text-xs); }
  @media (max-width: 900px) { .contribution-workspace { grid-template-columns: minmax(0,1fr); gap: 32px; } .contribution-context { max-width: 640px; } }
  @media (max-width: 520px) { #draft-editor, #draft-preview { padding: 20px; } .contribution-progress { padding-inline: 20px; } .contribution-kind-options { grid-template-columns: 1fr; } .kind-content { grid-template-columns: 22px 1fr; gap: 4px 10px; padding: 12px 36px 12px 12px; } .kind-content svg { grid-row: span 2; align-self: center; } .kind-content small { grid-column: 2; } .contribution-kind-options input { top: 23px; } .draft-actions .btn-primary { width: 100%; } .draft-notice { margin-bottom: 24px; } }
  @media (prefers-reduced-motion: reduce) { .kind-content { transition: none; } }
</style>
