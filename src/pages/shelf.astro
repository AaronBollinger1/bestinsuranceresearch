---
import { ArrowRight, BookOpen, Building2, FileText, LockKeyhole, MessageCircle, ShieldCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductContextBar from '../components/ProductContextBar.astro';
import { stripMarkers } from '../lib/citations';
import { loadCorpus } from '../lib/corpus';
import { longDate } from '../lib/cite';
import { excerpt } from '../lib/excerpt';
import { breadcrumbs, graph, organization, website } from '../lib/schema';

const corpus = await loadCorpus();
const savedQuestion = corpus.questions.find((item) => item.id === 'homeowners-earthquake-california') ?? corpus.questions[0];
const savedCompany = corpus.companies.find((item) => item.data.orgType === 'insurer') ?? corpus.companies[0];
const savedCoverage = corpus.coverages.find((item) => item.id === 'homeowners') ?? corpus.coverages[0];
if (!savedQuestion || !savedCompany || !savedCoverage) throw new Error('Birch Shelf requires a question, company, and coverage record.');

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Your Birch Shelf', path: '/shelf' },
];
const jsonLd = graph(organization(), website(), breadcrumbs(trail));

const shelfItems = [
	{
		type: 'Question',
		title: savedQuestion.data.question,
		detail: excerpt(stripMarkers(savedQuestion.data.shortAnswer), 142),
		meta: `${savedQuestion.data.sourceIds.length} source${savedQuestion.data.sourceIds.length === 1 ? '' : 's'}`,
		href: `/questions/${savedQuestion.id}`,
		icon: MessageCircle,
		className: 'question',
	},
	{
		type: 'Company',
		title: savedCompany.data.legalName,
		detail: 'Identity, official channels, and dated regulator context from the public record.',
		meta: `${savedCompany.data.sourceIds.length} source record${savedCompany.data.sourceIds.length === 1 ? '' : 's'}`,
		href: `/companies/${savedCompany.id}`,
		icon: Building2,
		className: 'company',
	},
	{
		type: 'Coverage',
		title: savedCoverage.data.name,
		detail: 'A plain-language overview of what this line is designed to address and where the form matters.',
		meta: `Reviewed ${longDate(savedCoverage.data.lastReviewed)}`,
		href: `/insurance/${savedCoverage.id}`,
		icon: BookOpen,
		className: 'coverage',
	},
];
---

<BaseLayout
	title="Your Birch Shelf"
	description="A private Birch Shelf product specimen for returning to questions, company records, and coverage research without requiring an account."
	noindex
	jsonLd={jsonLd}
	pageType="editorial"
>
	<section class="band band-tight band-first band-paper shelf-hero">
		<div class="shell">
			<Breadcrumbs trail={trail} />
			<ProductContextBar active="research" />
			<div class="shelf-hero-grid">
				<div class="shelf-hero-copy">
					<span class="eyebrow">Private research workspace</span>
					<h1>Keep a trail of what you’re learning.</h1>
					<p class="page-lede">Save questions, company records, and coverage notes in one place. Nothing becomes public unless you choose it.</p>
					<div class="shelf-hero-actions">
						<a class="btn btn-primary" href="#saved-research">Preview the shelf <ArrowRight size={15} aria-hidden="true" /></a>
						<a class="btn btn-secondary" href="/ask">Read without an account</a>
					</div>
				</div>
				<div class="shelf-compass" aria-hidden="true">
					<div class="shelf-compass-ring"><span>N</span><span>E</span><span>S</span><span>W</span><img src="/birch-bird-transparent.png" width="58" height="58" alt="" /></div>
					<span class="shelf-compass-caption">A clearer path through the record.</span>
				</div>
				<aside class="shelf-trust-card" aria-label="Shelf privacy promise">
					<div class="shelf-trust-icon"><LockKeyhole size={19} aria-hidden="true" /></div>
					<div>
						<span class="eyebrow">Privacy by default</span>
						<h2>Research stays yours until you share it.</h2>
						<p>The future Shelf is a private continuity layer. It is not a public profile, a lead form, or a recommendation feed.</p>
					</div>
					<ol class="shelf-privacy-steps">
						<li class="is-current"><span>1</span><div><strong>Keep it private</strong><small>Save your research on your shelf.</small></div></li>
						<li><span>2</span><div><strong>Review anything</strong><small>Take time to read and refine.</small></div></li>
						<li><span>3</span><div><strong>Share after review</strong><small>You choose what, if anything, to share.</small></div></li>
					</ol>
				</aside>
			</div>
		</div>
	</section>

	<section class="band band-tight" id="saved-research" aria-labelledby="saved-research-title">
		<div class="shell">
			<div class="shelf-tabs" role="navigation" aria-label="Shelf sections">
				<a class="is-active" href="#saved-research" aria-current="page">Your Birch Shelf</a>
				<a href="#saved-questions">Questions</a>
				<a href="#saved-companies">Companies</a>
				<a href="#saved-coverage">Coverage</a>
			</div>
			<div class="shelf-content-grid">
				<div class="shelf-main">
					<div class="shelf-section-heading">
						<div><span class="eyebrow">Saved research</span><h2 id="saved-research-title">The useful trail, in one place.</h2></div>
						<span class="status status-plain">Specimen state</span>
					</div>
					<p class="shelf-section-lede">These cards use real public Birch records to show the future shape of a private shelf. They are links, not saved activity.</p>
					<div class="shelf-card-grid">
						{ shelfItems.map((item) => {
							const Icon = item.icon;
							return (
								<a class={`shelf-card shelf-card-${item.className}`} href={item.href}>
									<div class="shelf-card-top"><span class="shelf-card-icon"><Icon size={17} aria-hidden="true" /></span><span class="shelf-card-type">{item.type}</span><ArrowRight class="shelf-card-arrow" size={16} aria-hidden="true" /></div>
									<h3>{item.title}</h3>
									<p>{item.detail}</p>
									<div class="shelf-card-foot"><span><FileText size={14} aria-hidden="true" />{item.meta}</span><span>Open record</span></div>
								</a>
							);
						}) }
					</div>
					<div class="shelf-note" id="saved-questions">
						<span class="shelf-note-icon"><ShieldCheck size={16} aria-hidden="true" /></span>
						<p><strong>What makes a saved item useful?</strong> A stable link back to the public record, the source ledger, and the date Birch last reviewed it.</p>
					</div>
					<div class="shelf-anchor" id="saved-companies" aria-hidden="true"></div>
					<div class="shelf-anchor" id="saved-coverage" aria-hidden="true"></div>
				</div>

				<aside class="shelf-gate-card" aria-labelledby="shelf-gate-title">
					<img src="/birch-bird-transparent.png" width="44" height="44" alt="" />
					<span class="eyebrow">Private preview</span>
					<h2 id="shelf-gate-title">Accounts are not enabled in this preview.</h2>
					<p>Your Birch Shelf is coming soon. Until then, every research page stays open to read, inspect, and cite without an account.</p>
					<button class="btn btn-secondary shelf-gate-button" type="button" disabled aria-describedby="shelf-gate-note">Request preview access</button>
					<p class="shelf-gate-note mono" id="shelf-gate-note">No email is collected here.</p>
					<div class="shelf-gate-divider"></div>
					<a class="text-link" href="/contribute">See how sharing will be reviewed <ArrowRight size={14} aria-hidden="true" /></a>
				</aside>
			</div>
		</div>
	</section>

	<section class="band band-tight band-ink" aria-labelledby="shelf-boundary-title">
		<div class="shell shelf-boundary">
			<div><span class="eyebrow">The boundary</span><h2 id="shelf-boundary-title">Private continuity, public accountability.</h2></div>
			<div class="shelf-boundary-copy"><p>The Shelf may help a reader remember what to revisit. It never changes a cited answer, turns a private note into a public claim, or replaces professional advice.</p><a class="btn btn-secondary" href="/methodology">Read the research method <ArrowRight size={15} aria-hidden="true" /></a></div>
		</div>
	</section>
</BaseLayout>

<style>
	.shelf-hero { overflow: hidden; }
	.shelf-hero .crumbs { margin-bottom: var(--s-4); }
	.shelf-hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(170px, .55fr) minmax(260px, .72fr); gap: clamp(var(--s-5), 5vw, var(--s-10)); align-items: center; margin-top: var(--s-8); }
	.shelf-hero-copy h1 { max-width: 12ch; margin: var(--s-2) 0 var(--s-4); font-size: clamp(2.8rem, 6vw, 5.5rem); letter-spacing: -.035em; }
	.shelf-hero-copy .page-lede { max-width: 46ch; }
	.shelf-hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }
	.shelf-compass { display: grid; justify-items: center; align-self: stretch; align-content: center; min-height: 280px; }
	.shelf-compass-ring { position: relative; display: grid; place-items: center; width: clamp(170px, 17vw, 230px); aspect-ratio: 1; border: 1px dashed color-mix(in srgb, var(--gold-edge) 55%, var(--line)); border-radius: 50%; color: var(--gold-text); font: var(--text-2xs)/1 var(--font-mono); }
	.shelf-compass-ring::before, .shelf-compass-ring::after { position: absolute; content: ''; background: var(--gold-edge); opacity: .55; }
	.shelf-compass-ring::before { width: 1px; height: 74%; }
	.shelf-compass-ring::after { width: 74%; height: 1px; }
	.shelf-compass-ring span { position: absolute; }
	.shelf-compass-ring span:nth-child(1) { top: 12%; }
	.shelf-compass-ring span:nth-child(2) { right: 12%; }
	.shelf-compass-ring span:nth-child(3) { bottom: 12%; }
	.shelf-compass-ring span:nth-child(4) { left: 12%; }
	.shelf-compass-ring img { position: relative; z-index: 1; width: 58px; height: 58px; object-fit: contain; filter: drop-shadow(0 10px 18px rgba(13, 42, 82, .14)); }
	.shelf-compass-caption { max-width: 17ch; margin-top: var(--s-4); color: var(--muted); font: var(--text-2xs)/1.4 var(--font-mono); letter-spacing: .06em; text-align: center; text-transform: uppercase; }
	.shelf-trust-card, .shelf-gate-card { padding: clamp(var(--s-5), 3vw, var(--s-8)); border: 1px solid var(--line-strong); border-radius: var(--r-4); background: var(--paper); box-shadow: var(--elev-2); }
	.shelf-trust-card { align-self: stretch; }
	.shelf-trust-icon { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: var(--s-4); border-radius: 50%; background: var(--gold-wash); color: var(--gold-text); }
	.shelf-trust-card h2 { margin: var(--s-2) 0; font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: var(--leading-snug); }
	.shelf-trust-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.shelf-privacy-steps { display: grid; gap: var(--s-4); padding: var(--s-5) 0 0; margin: var(--s-5) 0 0; border-top: 1px solid var(--line); list-style: none; }
	.shelf-privacy-steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: var(--s-3); align-items: center; position: relative; }
	.shelf-privacy-steps li + li::before { position: absolute; top: -18px; left: 13px; width: 1px; height: 14px; background: var(--line-strong); content: ''; }
	.shelf-privacy-steps li > span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--muted); font: var(--text-xs)/1 var(--font-mono); }
	.shelf-privacy-steps li.is-current > span { border-color: var(--brand-blue); background: var(--brand-blue); color: #fff; }
	.shelf-privacy-steps strong, .shelf-privacy-steps small { display: block; }
	.shelf-privacy-steps strong { color: var(--ink); font-size: var(--text-sm); }
	.shelf-privacy-steps small { margin-top: 2px; color: var(--muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
	.shelf-tabs { display: flex; flex-wrap: wrap; gap: var(--s-5); border-bottom: 1px solid var(--line-strong); }
	.shelf-tabs a { position: relative; padding: 0 0 var(--s-3); color: var(--muted); font-size: var(--text-sm); text-decoration: none; }
	.shelf-tabs a::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: transparent; content: ''; }
	.shelf-tabs a:hover, .shelf-tabs a:focus-visible, .shelf-tabs a.is-active { color: var(--ink); }
	.shelf-tabs a.is-active { font-weight: 600; }
	.shelf-tabs a.is-active::after { background: var(--brand-blue); }
	.shelf-content-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .32fr); gap: clamp(var(--s-6), 6vw, var(--s-10)); margin-top: var(--s-8); align-items: start; }
	.shelf-section-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--s-4); }
	.shelf-section-heading h2 { margin: var(--s-2) 0 0; font-size: clamp(1.8rem, 3vw, 2.7rem); }
	.shelf-section-lede { max-width: 58ch; margin: var(--s-3) 0 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.shelf-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); margin-top: var(--s-6); }
	.shelf-card { display: flex; min-height: 250px; flex-direction: column; padding: var(--s-4); border: 1px solid var(--line); border-top: 3px solid var(--line-strong); border-radius: var(--r-3); background: var(--paper); color: var(--ink); text-decoration: none; transition: transform var(--dur-2) var(--ease-soft), border-color var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease); }
	.shelf-card-question { border-top-color: var(--brand-blue); }
	.shelf-card-company { border-top-color: var(--green); }
	.shelf-card-coverage { border-top-color: var(--gold-edge); }
	.shelf-card:hover, .shelf-card:focus-visible { transform: translateY(-3px); border-color: var(--brand-blue); box-shadow: var(--elev-2); }
	.shelf-card-top { display: flex; align-items: center; gap: var(--s-2); }
	.shelf-card-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--r-2); background: var(--brand-blue-wash); color: var(--brand-blue-text); }
	.shelf-card-company .shelf-card-icon { background: var(--green-wash); color: var(--green-text); }
	.shelf-card-coverage .shelf-card-icon { background: var(--gold-wash); color: var(--gold-text); }
	.shelf-card-type { color: var(--muted); font: var(--text-2xs)/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
	.shelf-card-arrow { margin-left: auto; color: var(--faint); transition: transform var(--dur-1) var(--ease); }
	.shelf-card:hover .shelf-card-arrow, .shelf-card:focus-visible .shelf-card-arrow { transform: translateX(3px); color: var(--brand-blue); }
	.shelf-card h3 { margin: var(--s-6) 0 var(--s-2); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; line-height: var(--leading-snug); }
	.shelf-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.shelf-card-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2); padding-top: var(--s-4); margin-top: auto; border-top: 1px solid var(--line); color: var(--brand-blue-text); font: var(--text-2xs)/1.3 var(--font-mono); }
	.shelf-card-foot span:first-child { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); }
	.shelf-note { display: flex; align-items: flex-start; gap: var(--s-3); max-width: 62ch; padding: var(--s-4); margin-top: var(--s-5); border: 1px solid var(--line); border-radius: var(--r-3); background: var(--blue-wash); }
	.shelf-note-icon { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 auto; border-radius: 50%; background: var(--paper); color: var(--brand-blue-text); }
	.shelf-note p { margin: 0; color: var(--body); font-size: var(--text-sm); line-height: var(--leading-snug); }
	.shelf-note strong { color: var(--ink); }
	.shelf-anchor { scroll-margin-top: var(--s-6); }
	.shelf-gate-card { position: sticky; top: var(--s-5); }
	.shelf-gate-card img { display: block; margin-bottom: var(--s-4); }
	.shelf-gate-card h2 { max-width: 16ch; margin: var(--s-2) 0 var(--s-3); font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: var(--leading-snug); }
	.shelf-gate-card > p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-normal); }
	.shelf-gate-button { width: 100%; margin-top: var(--s-5); }
	.shelf-gate-note { margin-top: var(--s-3) !important; color: var(--faint) !important; font-size: var(--text-2xs) !important; }
	.shelf-gate-divider { height: 1px; margin: var(--s-5) 0; background: var(--line); }
	.shelf-gate-card .text-link { display: inline-flex; align-items: center; gap: 5px; color: var(--brand-blue-text); font-size: var(--text-sm); font-weight: 600; text-decoration: none; }
	.shelf-boundary { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: var(--s-8); align-items: center; }
	.shelf-boundary h2 { max-width: 16ch; margin: var(--s-2) 0 0; color: var(--paper); font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.3rem); font-weight: 400; line-height: var(--leading-tight); }
	.shelf-boundary-copy { max-width: 52ch; }
	.shelf-boundary-copy p { margin: 0 0 var(--s-5); color: var(--muted-ink); font-size: var(--text-lg); line-height: var(--leading-normal); }
	@media (max-width: 1080px) {
		.shelf-hero-grid { grid-template-columns: minmax(0, 1fr) minmax(250px, .65fr); }
		.shelf-compass { display: none; }
		.shelf-card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (max-width: 820px) {
		.shelf-hero-grid, .shelf-content-grid, .shelf-boundary { grid-template-columns: minmax(0, 1fr); }
		.shelf-trust-card { max-width: 620px; }
		.shelf-gate-card { position: static; max-width: 620px; }
		.shelf-card-grid { grid-template-columns: minmax(0, 1fr); }
		.shelf-card { min-height: 0; }
		.shelf-boundary { gap: var(--s-5); }
	}
	@media (max-width: 560px) {
		.shelf-hero-copy h1 { font-size: clamp(2.55rem, 13vw, 4rem); }
		.shelf-hero-actions, .shelf-hero-actions .btn { width: 100%; }
		.shelf-section-heading { align-items: flex-start; flex-direction: column; }
		.shelf-tabs { gap: var(--s-3); overflow-x: auto; flex-wrap: nowrap; }
		.shelf-tabs a { flex: 0 0 auto; }
	}
	@media (prefers-reduced-motion: reduce) {
		.shelf-card, .shelf-card-arrow { transition: none; }
	}
</style>
