---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { breadcrumbs, graph, organization, website } from '../lib/schema';
import { AUDITED_SURFACES, closedAdapter, gatesFromEnv, presentStatus, validateAdapter } from '../lib/release-candidate';

const trail = [
	{ name: 'Home', path: '/' },
	{ name: 'Service status', path: '/status' },
];

const gates = gatesFromEnv({
	PUBLIC_SITE_ENV: import.meta.env.PUBLIC_SITE_ENV,
	PUBLIC_COMMONS_READY: import.meta.env.PUBLIC_COMMONS_READY,
	PUBLIC_INDEXING_OPEN: import.meta.env.PUBLIC_INDEXING_OPEN,
});
const adapter = validateAdapter(closedAdapter());
const board = presentStatus(gates, adapter.ok);
const jsonLd = graph(organization(), website(), breadcrumbs(trail));
---

<BaseLayout
	title="Service status"
	description="Which Birch gates are open, and the rule that closing Commons does not hide reviewed research or publish a draft."
	jsonLd={jsonLd}
	pageType="editorial"
>
	<PageHeader
		eyebrow="Service status"
		title="What is open, and what stays closed"
		lede="Publication standards, corrections, and privacy already have pages. This page is the missing status surface. It names six separate gates and does not open any of them."
		trail={trail}
	/>
	<section class="band band-tight">
		<div class="shell prose status-board">
			<h2>Existing surfaces</h2>
			<ul>
				{AUDITED_SURFACES.map((item) => <li><a href={item.path}>{item.role}</a></li>)}
			</ul>
			<h2>Gates</h2>
			<div set:html={board} />
		</div>
	</section>
</BaseLayout>

<style>
	.status-board { min-width: 0; max-width: 100%; overflow-x: auto; }
	.status-board :global(table) { width: 100%; table-layout: fixed; }
	.status-board :global(td), .status-board :global(th) { word-break: break-word; }
</style>
