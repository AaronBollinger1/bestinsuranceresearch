---
import { ArrowRight, ChevronDown, Menu, Search, X } from '@lucide/astro';
import { primaryNav, siteConfig, isPreview } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const startLink = primaryNav.find((item) => item.label === 'Start here') ?? { href: '/start', label: 'Start here' };

const menuGroups = [
	{
		label: 'Research',
		kicker: 'Trace the answer',
		description: 'Start with a question, a coverage line, or the document behind the claim.',
		items: [
			{ label: 'Ask Birch', href: '/ask', description: 'Search the question library in plain language.' },
			{ label: 'Coverage library', href: '/insurance', description: 'Understand what each line is designed to do.' },
			{ label: 'Question library', href: '/questions', description: 'Read direct answers with assumptions attached.' },
			{ label: 'Source registry', href: '/sources', description: 'Open the records behind every published claim.' },
		],
	},
	{
		label: 'Explore',
		kicker: 'Find the context',
		description: 'Move from a single answer to the companies, jurisdictions, and tools around it.',
		items: [
			{ label: 'Find your context', href: '/explore', description: 'Browse by situation, line, state, and company.' },
			{ label: 'California launch desk', href: '/start', description: 'Begin with wildfire, earthquake, auto, and more.' },
			{ label: 'Companies and regulators', href: '/companies', description: 'Verify identity and find official channels.' },
			{ label: 'Free tools', href: '/tools', description: 'Map a requirement, renewal, or policy comparison.' },
			{ label: 'Recently reviewed', href: '/changed', description: 'See what changed and when it was checked.' },
		],
	},
	{
		label: 'Participate',
		kicker: 'Make the library better',
		description: 'Contribute a source, a correction, or a clearly labelled experience when the path is ready.',
		items: [
			{ label: 'Contribute', href: '/contribute', description: 'Draft an experience, research note, or correction.' },
			{ label: 'For professionals', href: '/professionals', description: 'See the rules for credentialed contributions.' },
			{ label: 'Methodology', href: '/methodology', description: 'Learn how Birch separates evidence from experience.' },
			{ label: 'Editorial policy', href: '/editorial-policy', description: 'Read the publication and correction standards.' },
			...(isPreview
				? [{ label: 'Review queue', href: '/review-queue', description: 'See what still needs one source-first review pass.' }]
				: []),
			...(siteConfig.communityReady
				? [{ label: 'Birch Commons', href: siteConfig.communityOrigin, description: 'Continue to the separately moderated discussion room.', external: true }]
				: []),
		],
	},
] as const;
---

<header class="site-header">
	<div class="shell header-bar">
		<a class="brand" href="/" aria-label="Birch home">
			<img src="/birch-bird-transparent.png" width="34" height="34" alt="" />
			<span class="brand-name">
				<strong>{siteConfig.brandName}</strong>
				<span>{siteConfig.brandDescriptor}</span>
			</span>
			<span class="u-visually-hidden">{siteConfig.name} home</span>
		</a>

		<nav class="header-nav" aria-label="Primary">
			<a
				class="header-nav-start"
				href={startLink.href}
				aria-current={isCurrent(startLink.href) ? 'page' : undefined}
			>
				{startLink.label}
			</a>
			{
				menuGroups.map((group, index) => (
					<div class="header-menu" data-header-menu>
						<button
							class="header-menu-trigger"
							type="button"
							aria-expanded="false"
							aria-controls={`header-menu-${index}`}
						>
							{group.label}
							<ChevronDown size={14} stroke-width={1.8} aria-hidden="true" />
						</button>
						<div class="header-menu-panel" id={`header-menu-${index}`} hidden>
							<div class="header-menu-intro">
								<span class="eyebrow">{group.kicker}</span>
								<p>{group.description}</p>
							</div>
							<div class="header-menu-grid">
								{
									group.items.map((item) => (
										<a
											class="header-menu-link"
											href={item.href}
											rel={'external' in item && item.external ? 'noopener' : undefined}
										>
											<span class="header-menu-link-title">
												<strong>{item.label}</strong>
												<ArrowRight size={14} aria-hidden="true" />
											</span>
											<span>{item.description}</span>
										</a>
									))
								}
							</div>
						</div>
					</div>
				))
			}
		</nav>

		<div class="header-tail">
			<form class="header-search" role="search" action="/ask" method="get">
				<Search class="search-glyph" size={15} stroke-width={2} aria-hidden="true" />
				<label class="u-visually-hidden" for="header-q">Search the research corpus</label>
				<input
					id="header-q"
					name="q"
					type="search"
					placeholder="Search questions and coverage"
					autocomplete="off"
					enterkeyhint="search"
				/>
			</form>
			<a class="btn btn-primary btn-sm header-ask-cta" href="/ask">Ask Birch <ArrowRight size={14} aria-hidden="true" /></a>
			<button class="icon-btn nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
				<span data-icon="open"><Menu size={20} aria-hidden="true" /></span>
				<span data-icon="close" hidden><X size={20} aria-hidden="true" /></span>
				<span class="u-visually-hidden">Menu</span>
			</button>
		</div>
	</div>
</header>

<div class="nav-panel" id="nav-panel" hidden>
	<div class="shell nav-panel-inner">
		<form role="search" action="/ask" method="get" class="field">
			<label class="u-visually-hidden" for="panel-q">Search the research corpus</label>
			<input id="panel-q" name="q" type="search" placeholder="Search questions and coverage" autocomplete="off" />
		</form>
		<nav aria-label="Site sections">
			<a href={startLink.href} aria-current={isCurrent(startLink.href) ? 'page' : undefined}>{startLink.label}</a>
			{
				menuGroups.map((group) => (
					<div class="nav-panel-group">
						<span class="nav-panel-label">{group.label}</span>
						{
							group.items.map((item) => (
								<a href={item.href} rel={'external' in item && item.external ? 'noopener' : undefined}>{item.label}</a>
							))
						}
					</div>
				))
			}
			<a href="/about">About Birch</a>
		</nav>
	</div>
</div>

<script>
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-panel');
	const openIcon = toggle?.querySelector<HTMLElement>('[data-icon="open"]');
	const closeIcon = toggle?.querySelector<HTMLElement>('[data-icon="close"]');

	function setOpen(open: boolean) {
		if (!toggle || !panel) return;
		toggle.setAttribute('aria-expanded', String(open));
		panel.hidden = !open;
		openIcon?.toggleAttribute('hidden', open);
		closeIcon?.toggleAttribute('hidden', !open);
	}

	toggle?.addEventListener('click', () => {
		setOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	const menus = Array.from(document.querySelectorAll<HTMLElement>('[data-header-menu]'));
	let closeTimer: number | undefined;
	function closeMenus(except?: HTMLElement) {
		menus.forEach((menu) => {
			if (menu === except) return;
			const button = menu.querySelector<HTMLButtonElement>('.header-menu-trigger');
			const menuPanel = menu.querySelector<HTMLElement>('.header-menu-panel');
			menu.classList.remove('is-open');
			button?.setAttribute('aria-expanded', 'false');
			if (menuPanel) menuPanel.hidden = true;
		});
	}
	function openMenu(menu: HTMLElement) {
		if (closeTimer) window.clearTimeout(closeTimer);
		closeMenus(menu);
		const button = menu.querySelector<HTMLButtonElement>('.header-menu-trigger');
		const menuPanel = menu.querySelector<HTMLElement>('.header-menu-panel');
		menu.classList.add('is-open');
		button?.setAttribute('aria-expanded', 'true');
		if (menuPanel) menuPanel.hidden = false;
	}
	function scheduleClose(menu: HTMLElement) {
		closeTimer = window.setTimeout(() => {
			const focusInside = menu.contains(document.activeElement);
			if (!focusInside) closeMenus();
		}, 110);
	}
	menus.forEach((menu) => {
		menu.addEventListener('mouseenter', () => openMenu(menu));
		menu.addEventListener('mouseleave', () => scheduleClose(menu));
		menu.querySelector('.header-menu-trigger')?.addEventListener('click', () => {
			const button = menu.querySelector<HTMLButtonElement>('.header-menu-trigger');
			if (button?.getAttribute('aria-expanded') === 'true') closeMenus();
			else openMenu(menu);
		});
		menu.addEventListener('focusin', () => openMenu(menu));
		menu.addEventListener('focusout', () => scheduleClose(menu));
	});
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Node) || !menus.some((menu) => menu.contains(target))) closeMenus();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			if (toggle?.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
			closeMenus();
		}
	});
</script>
