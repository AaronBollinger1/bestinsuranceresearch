---
/**
 * The brand mark resolving, for the `/ask` loading state.
 *
 * The mark is a funnel: a scattered field of dots that narrows and shrinks
 * into a solid arrowhead. `AMBITION.md` briefs the loading beat as that
 * convergence, because it is what the site does — many sources narrowing into
 * one answer — rather than atmosphere.
 *
 * Why this is CSS over the real asset rather than a generated clip: the mark is
 * 37 precisely placed dots on a tapering lattice, and two Seedance passes
 * conditioned on the master PNG both replaced that lattice with a random dot
 * cloud and neither returned to the artwork, so neither could loop. A diffusion
 * model cannot hold this geometry. Here the logo's own pixels are never
 * redrawn, traced or recoloured: `icon-master-black-transparent.png` is the
 * file `favicon.ico` derives from, and the only thing that moves is a mask
 * across it. Nothing can drift.
 *
 * The sweep runs along the funnel axis, so dots surface at the open edge first
 * and the arrowhead lands last, then the whole mark holds before the next
 * pass. No gold: see the note at the foot of the style block.
 */
interface Props {
	/** Rendered size in px. The master is square, so one number is enough. */
	size?: number;
	/** Accessible label. Set to null when an adjacent live region already says it. */
	label?: string | null;
}

const { size = 96, label = 'Resolving your question against the library' } = Astro.props;
---

<div
	class="mark-resolving"
	style={`--mr-size: ${size}px`}
	role={label ? 'img' : undefined}
	aria-label={label ?? undefined}
	aria-hidden={label ? undefined : 'true'}
>
	<div class="mark-resolving-art"></div>
</div>

<style>
	.mark-resolving {
		position: relative;
		width: var(--mr-size);
		height: var(--mr-size);
		flex: none;
	}

	/*
	 * The artwork. The real master ships in public/ and is not modified: only a
	 * mask moves across it, so the geometry cannot drift.
	 *
	 * At rest the whole mark is visible. That is also exactly what a reader who
	 * has asked for less motion gets, and it is why the animation is additive
	 * rather than something the static case has to opt out of.
	 */
	.mark-resolving-art {
		position: absolute;
		inset: 0;
		background: no-repeat center / contain url('/icon-master-black-transparent.png');
	}

	@media (prefers-reduced-motion: no-preference) {
		.mark-resolving-art {
			/*
			 * Opaque on the left, falling away to the right, and three times the
			 * width of the element. Sliding it leftward uncovers the mark from its
			 * open edge toward the point, so the arrowhead is the last thing to
			 * land. Masking rather than fading keeps every uncovered dot at full
			 * ink density, so the mark never looks washed out mid-sweep.
			 *
			 * The opaque core is 120% of the element, wider than the element
			 * itself, which is what lets the end of the sweep cover the mark
			 * completely and hold there.
			 */
			-webkit-mask-image: linear-gradient(90deg, #000 0%, #000 40%, transparent 70%);
			mask-image: linear-gradient(90deg, #000 0%, #000 40%, transparent 70%);
			-webkit-mask-size: 300% 100%;
			mask-size: 300% 100%;
			-webkit-mask-repeat: no-repeat;
			mask-repeat: no-repeat;
			animation: mark-sweep 2400ms cubic-bezier(0.33, 0, 0.2, 1) infinite;
		}
	}

	/*
	 * 62% is the position at which the opaque core has just reached the element,
	 * so the sweep starts from a sliver rather than from nothing: a loading
	 * indicator that is blank for part of its cycle reads as a broken image.
	 * The hold from 58% is what makes each pass end on the resolved mark rather
	 * than on a shimmer.
	 */
	@keyframes mark-sweep {
		0% {
			-webkit-mask-position: 62% 0;
			mask-position: 62% 0;
		}
		58% {
			-webkit-mask-position: 0% 0;
			mask-position: 0% 0;
		}
		100% {
			-webkit-mask-position: 0% 0;
			mask-position: 0% 0;
		}
	}

	/*
	 * Deliberately no gold, and deliberately no prefers-color-scheme branch.
	 *
	 * Gold: a first pass put a hairline gold edge on the reveal front. It could
	 * not be kept in sync with the mask and ended up louder than the mark
	 * itself, which makes it decoration. DIRECTION.md: if gold appears and
	 * means nothing, remove it. The arrowhead landing is the resolution and
	 * does not need a highlighter.
	 *
	 * Colour scheme: this site is light-only. There is no data-theme anywhere
	 * and no dark block in tokens.css, so the page renders on cream whatever
	 * the reader's OS says. Keying the mark off prefers-color-scheme painted
	 * the white master onto that cream ground for every visitor with a dark OS,
	 * which is invisible. When dark mode ships,
	 * icon-master-white-transparent.png is already in public/ and this is where
	 * it swaps in, behind the theme stamp rather than behind a media query.
	 */
</style>
