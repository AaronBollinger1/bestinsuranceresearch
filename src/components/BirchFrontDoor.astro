---
import { ArrowRight, ArrowUpRight, BookOpen, Building2, FileText, Home, MapPin, MessageCircle, PenLine, Search, ShieldCheck, UserRound } from '@lucide/astro';
import { productDesign } from '../config/product-design';
interface Props { variant?: 'focus' | 'editorial' | 'explore'; }
const { variant = productDesign.direction } = Astro.props;
const starters = [
  { icon: Home, label: 'My home', question: 'Does homeowners insurance cover earthquake damage in California?' },
  { icon: Building2, label: 'My business', question: 'What is a claims-made retroactive date?' },
  { icon: ShieldCheck, label: 'My coverage', question: 'What is the difference between replacement cost and market value?' },
];
---
<section class:list={['front-door', `front-door-${variant}`]} data-design-direction={variant} aria-labelledby="home-title">
  <div class="front-door-intro">
    <span class="front-door-kicker">A clearer view of insurance</span>
    <h1 id="home-title">Understand your<br /><em>insurance.</em></h1>
    {variant === 'editorial' && <p class="front-door-description">Answers you can trace. Experiences you can learn from.</p>}
  </div>
  <div class="front-door-branch-intro">
    <span class="front-door-kicker">Choose your starting point</span>
    <p>Follow a question to its sources, or see how professional knowledge can become attributable work.</p>
  </div>
  <div class="front-door-branches">
    <article class="front-door-branch front-door-branch-question" id="question-path">
      <div class="front-door-branch-head">
        <span class="eyebrow">For a person with a question</span>
        <h2>I have a question.</h2>
        <p>Start with a general question. Birch leads you to a sourced answer you can check for yourself.</p>
      </div>
      <div class="front-door-action">
        <form action="/ask" method="get" role="search" data-question-form class="question-composer">
          <label class="u-visually-hidden" for="home-q">Ask an insurance question</label>
          <div class="question-composer-input"><Search size={22} aria-hidden="true" /><input id="home-q" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder="What would you like to understand?" aria-describedby="home-q-hint" /></div>
          <div class="question-composer-actions">
            <label class="question-location"><MapPin size={14} aria-hidden="true" /><span class="u-visually-hidden">Question jurisdiction</span><select name="state" aria-label="Question jurisdiction"><option value="CA">California</option><option value="any">All locations</option><option value="TX">Texas</option><option value="FL">Florida</option></select></label>
            <button class="btn btn-primary" type="submit">Ask Birch <ArrowUpRight size={17} aria-hidden="true" /></button>
          </div>
        </form>
        <div class="question-starters" aria-label="Choose an example question">
          {starters.map(({icon: Icon, label, question}) => <button type="button" data-starter={question}><Icon size={15} aria-hidden="true" />{label}<ArrowUpRight size={13} aria-hidden="true" /></button>)}
        </div>
        <p class="front-door-promise">Free to read. Sources included.</p>
        <p class="front-door-privacy" id="home-q-hint">Use a general question. Leave out personal and policy details.</p>
        {variant === 'explore' && <nav class="front-door-topics" aria-label="Explore insurance"><a href="/insurance">Coverage guides <ArrowUpRight size={15} /></a><a href="/companies">Insurance companies <ArrowUpRight size={15} /></a><a href="/tools">Free tools <ArrowUpRight size={15} /></a><a href="/industries">Industries & situations <ArrowUpRight size={15} /></a></nav>}
      </div>
      <ol class="front-door-flow" aria-label="Question path">
        <li><a href="/ask"><span class="front-door-flow-index">01</span><span class="front-door-flow-copy"><strong>Question</strong><small>Ask in your own words.</small></span><ArrowRight size={15} aria-hidden="true" /></a></li>
        <li><a href="/sources"><span class="front-door-flow-index">02</span><span class="front-door-flow-copy"><strong>Sources</strong><small>Open the documents behind the record.</small></span><FileText size={15} aria-hidden="true" /></a></li>
        <li><a href="/questions/replacement-cost-vs-market-value"><span class="front-door-flow-index">03</span><span class="front-door-flow-copy"><strong>Answer</strong><small>Read the conditions and limitations.</small></span><BookOpen size={15} aria-hidden="true" /></a></li>
        <li><a href="/design/commons-preview"><span class="front-door-flow-index">04</span><span class="front-door-flow-copy"><strong>Discussion</strong><small>Community context is a separate private preview.</small></span><MessageCircle size={15} aria-hidden="true" /></a></li>
      </ol>
    </article>

    <article class="front-door-branch front-door-branch-expertise" id="expertise-path">
      <div class="front-door-branch-head">
        <span class="eyebrow">For insurance and financial professionals</span>
        <h2>I share financial expertise.</h2>
        <p>See the path from a private contribution draft to source-linked work and a discoverable author profile.</p>
      </div>
      <div class="front-door-expert-actions">
        <a class="btn btn-primary" href="/professionals">Explore publishing <ArrowRight size={16} aria-hidden="true" /></a>
        <a class="btn btn-quiet" href="/contribute?type=research">Prepare a private draft <PenLine size={15} aria-hidden="true" /></a>
      </div>
      <ol class="front-door-flow" aria-label="Professional contribution path">
        <li><a href="/contribute?type=research"><span class="front-door-flow-index">01</span><span class="front-door-flow-copy"><strong>Contribution</strong><small>Prepare original research or a correction.</small></span><PenLine size={15} aria-hidden="true" /></a></li>
        <li><a href="/professionals#professional-standard-title"><span class="front-door-flow-index">02</span><span class="front-door-flow-copy"><strong>Review</strong><small>Editorial review is required before publication.</small></span><ShieldCheck size={15} aria-hidden="true" /></a></li>
        <li><a href="/questions/replacement-cost-vs-market-value"><span class="front-door-flow-index">03</span><span class="front-door-flow-copy"><strong>Byline</strong><small>Published work can carry attribution and sources.</small></span><FileText size={15} aria-hidden="true" /></a></li>
        <li><a href="/authors/aaron-bollinger"><span class="front-door-flow-index">04</span><span class="front-door-flow-copy"><strong>Author profile</strong><small>Discover authored records and review context.</small></span><UserRound size={15} aria-hidden="true" /></a></li>
      </ol>
      <div class="front-door-future-note"><span class="status status-plain">Future discussion</span><p>Moderated discussion or commenting is a separate Community surface. It is not open in this preview.</p></div>
    </article>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.front-door').forEach((door) => {
    const input = door.querySelector<HTMLInputElement>('input[name="q"]');
    door.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((button) => button.addEventListener('click', () => {
      if (!input) return;
      input.value = button.dataset.starter || '';
      input.focus();
    }));
  });
</script>
<style>
  .front-door { width: 100%; max-width: 1100px; margin: auto; padding: 64px 0 48px; text-align: center; box-sizing: border-box; }
  .front-door-kicker { color: var(--brand-blue-text); font-size: var(--text-xs); font-weight: 600; letter-spacing: .02em; }
  .front-door h1 { margin: 20px 0 32px; color: var(--ink); font-family: var(--font-sans); font-size: clamp(2.8rem, 5.5vw, 4.65rem); font-weight: 600; letter-spacing: -.065em; line-height: 1.04; }
  .front-door h1 em { font-family: var(--font-display); font-weight: 400; color: var(--brand-blue-deep); letter-spacing: -.045em; }
  .front-door-branch-intro { max-width: 52ch; margin: 0 auto 24px; }
  .front-door-branch-intro p { margin: 8px 0 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .front-door-branches { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(300px, .88fr); gap: 16px; margin-top: 24px; text-align: left; }
  .front-door-branch { min-width: 0; padding: 24px; border: 1px solid var(--line-strong); border-radius: var(--r-4); background: var(--white); box-shadow: var(--elev-2); box-sizing: border-box; }
  .front-door-branch-question { border-top: 3px solid var(--brand-blue); }
  .front-door-branch-expertise { background: var(--slate-wash); }
  .front-door-branch-head .eyebrow { margin-bottom: 10px; }
  .front-door-branch-head h2 { margin: 0 0 10px; color: var(--ink); font: 500 clamp(1.5rem, 2.8vw, 2rem)/1.12 var(--font-sans); letter-spacing: -.04em; }
  .front-door-branch-head p { max-width: 52ch; margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.65; }
  .front-door-action { width: 100%; max-width: 660px; margin: 24px auto 0; }
  .question-composer { width: 100%; max-width: 100%; padding: 12px; border: 1px solid var(--line-strong); border-radius: var(--r-4); background: var(--white); box-shadow: var(--elev-2); text-align: left; transition: border-color var(--dur-2), box-shadow var(--dur-2); box-sizing: border-box; }
  .question-composer:focus-within { border-color: var(--brand-blue); box-shadow: 0 0 0 3px var(--brand-blue-wash), var(--elev-2); }
  .question-composer-input { display: flex; align-items: center; gap: 12px; padding: 8px 8px 20px; color: var(--faint); }
  .question-composer-input input { width: 100%; min-width: 0; min-height: var(--tap); padding: 0; border: 0; background: transparent; box-shadow: none; outline: none; color: var(--ink); font-size: var(--text-md); }
  .question-composer-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .question-location { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); padding-left: 8px; }
  .question-location select { width: auto; min-height: var(--tap); border: 0; padding: 6px; background: transparent; color: var(--body); font-size: var(--text-xs); }
  .question-starters { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .question-starters button { display: inline-flex; align-items: center; gap: 8px; min-height: var(--tap); padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--r-3); background: var(--paper); color: var(--body); font: 500 var(--text-xs)/1.2 var(--font-sans); cursor: pointer; transition: background var(--dur-1), border-color var(--dur-1); }
  .question-starters button:hover { background: var(--brand-blue-wash); border-color: var(--brand-blue); }
  .question-starters button > svg:last-child { color: var(--faint); }
  .front-door-promise { margin: 18px 0 0; color: var(--muted); font-size: var(--text-xs); }
  .front-door-privacy { margin: 5px 0 0; color: var(--muted); font-size: var(--text-2xs); }
  .front-door-expert-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .front-door-expert-actions .btn { min-height: var(--tap); }
  .front-door-flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .front-door-flow li { min-width: 0; }
  .front-door-flow a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 9px; min-height: var(--tap); padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--body); text-decoration: none; }
  .front-door-flow a:hover, .front-door-flow a:focus-visible { color: var(--brand-blue-text); }
  .front-door-flow a:hover > svg, .front-door-flow a:focus-visible > svg { transform: translateX(3px); }
  .front-door-flow-index { color: var(--faint); font: var(--text-2xs)/1 var(--font-mono); }
  .front-door-flow-copy { min-width: 0; }
  .front-door-flow-copy strong, .front-door-flow-copy small { display: block; overflow-wrap: anywhere; }
  .front-door-flow-copy strong { color: inherit; font-size: var(--text-xs); font-weight: 650; }
  .front-door-flow-copy small { margin-top: 3px; color: var(--muted); font-size: var(--text-2xs); line-height: 1.45; }
  .front-door-flow a > svg { flex-shrink: 0; color: var(--brand-blue-text); transition: transform var(--dur-2) var(--ease-soft); }
  .front-door-future-note { display: flex; align-items: flex-start; gap: 9px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
  .front-door-future-note .status { flex-shrink: 0; margin-top: 1px; }
  .front-door-future-note p { margin: 0; color: var(--muted); font-size: var(--text-2xs); line-height: 1.55; }
  .front-door-description { max-width: 32ch; color: var(--muted); font-size: var(--text-lg); }
  .front-door-editorial { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 56px; text-align: left; padding-block: 96px; }
  .front-door-editorial h1 { font-size: clamp(2.7rem, 4.8vw, 4rem); }
  .front-door-editorial .question-starters { justify-content: flex-start; }
  .front-door-explore { padding-top: 40px; }
  .front-door-explore h1 br { display: none; }
  .front-door-explore h1 { font-size: clamp(2.8rem, 4.5vw, 3.8rem); }
  .front-door-topics { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 28px; text-align: left; }
  .front-door-topics a { display: flex; justify-content: space-between; gap: 8px; padding: 14px; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-3); text-decoration: none; color: var(--body); font-size: var(--text-sm); }
  @media (max-width: 900px) { .front-door-branches { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .front-door { padding-block: 40px 32px; } .front-door-editorial { display: block; text-align: center; } .front-door-description { margin: 0 auto 24px; } .front-door-editorial .question-starters { justify-content: center; } }
  @media (max-width: 440px) { .front-door h1 { font-size: 2.85rem; margin-block: 16px 24px; } .front-door-branch { padding: 20px; } .question-composer-input { padding-inline: 0; gap: 8px; } .question-composer-input input { font-size: var(--text-sm); } .question-starters { gap: 6px; } .question-starters button { padding-inline: 9px; } .question-starters button > svg:last-child { display: none; } .front-door-topics { grid-template-columns: 1fr; } .front-door-flow { grid-template-columns: minmax(0, 1fr); gap: 0; } .front-door-expert-actions { align-items: stretch; flex-direction: column; } .front-door-expert-actions .btn { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .question-composer, .question-starters button, .front-door-flow a > svg { transition: none; } .front-door-flow a:hover > svg, .front-door-flow a:focus-visible > svg { transform: none; } }
</style>
