---
import { ArrowRight } from '@lucide/astro';

const layers = ['Coverage', 'Prevention', 'Documentation', 'Contracts', 'Planning', 'Mitigation', 'Recovery'];
const scopes = [
  'Insurance and carriers',
  'Claims and adjusting',
  'Financial planning',
  'Tax',
  'Legal',
  'Real estate and mortgage',
  'Employee benefits',
  'Business finance',
];
---
<section class="asset-manifesto" id="asset-protection" aria-labelledby="manifesto-title" data-asset-manifesto>
  <p class="asset-manifesto-kicker">Evidence-first asset protection</p>
  <p class="asset-manifesto-from">Insure your assets.</p>
  <h2 id="manifesto-title">Ensure your assets are <em>protected.</em></h2>
  <p class="asset-manifesto-stage" aria-hidden="true" data-manifesto-stage hidden>Ensure your assets are protected.</p>
  <p class="asset-manifesto-lead">Coverage is one layer. Prevention, documentation, contracts, planning, mitigation, and recovery sit beside it. Birch publishes sourced evidence so those decisions can be checked. Insurance is the launch wedge; the category is asset protection, risk and loss mitigation, and financial-decision education.</p>
  <ul class="asset-manifesto-layers">
    {layers.map((layer) => <li>{layer}</li>)}
  </ul>
  <div class="asset-manifesto-scopes">
    <h3>Reviewed contribution scopes</h3>
    <p>Qualified professionals can prepare work within a documented specialty. Editorial review is required before anything publishes. Scope labels stay visible. This is not individualized advice, a fiduciary or attorney-client relationship, a credential badge, or a live directory.</p>
    <ul>
      {scopes.map((scope) => <li><span class="asset-manifesto-scope-label">{scope}</span></li>)}
    </ul>
  </div>
  <div class="asset-manifesto-future">
    <span class="status status-plain">Future discussion</span>
    <p>Moderated discussion remains a separate Community preview. It is not open here, and this page does not collect or deliver leads.</p>
  </div>
  <div class="asset-manifesto-actions">
    <a class="btn btn-primary" href="/ask">Ask a question <ArrowRight size={16} aria-hidden="true" /></a>
    <a class="btn btn-quiet" href="/professionals">Explore contributing <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
</section>
<style>
  .asset-manifesto { width: 100%; max-width: 1100px; margin: 8px auto 0; padding: 28px 28px 24px; border: 1px solid var(--line-strong); border-radius: var(--r-4); background: var(--white); box-sizing: border-box; text-align: left; scroll-margin-top: calc(var(--header-h) + 16px); }
  .asset-manifesto-kicker { margin: 0; color: var(--brand-blue-text); font: var(--text-2xs)/1.3 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .asset-manifesto-from { margin: 12px 0 0; color: var(--muted); font: 500 var(--text-lg)/1.3 var(--font-sans); letter-spacing: -.02em; }
  .asset-manifesto h2 { margin: 4px 0 0; color: var(--ink); font: 600 clamp(1.85rem, 4vw, 3.1rem)/1.08 var(--font-sans); letter-spacing: -.05em; }
  .asset-manifesto h2 em { font-family: var(--font-display); font-weight: 400; color: var(--brand-blue-deep); letter-spacing: -.04em; }
  .asset-manifesto-stage { display: none; }
  .asset-manifesto-lead { max-width: 68ch; margin: 16px 0 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.65; }
  .asset-manifesto-layers { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .asset-manifesto-layers li { min-height: var(--tap); display: inline-flex; align-items: center; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--r-2); background: var(--paper); color: var(--body); font-size: var(--text-2xs); font-weight: 650; }
  .asset-manifesto-scopes { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  .asset-manifesto-scopes h3 { margin: 0; color: var(--ink); font: 650 var(--text-xs)/1.3 var(--font-sans); letter-spacing: .01em; }
  .asset-manifesto-scopes p { max-width: 72ch; margin: 8px 0 0; color: var(--muted); font-size: var(--text-2xs); line-height: 1.55; }
  .asset-manifesto-scopes ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .asset-manifesto-scope-label { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 12px; border: 1px solid var(--line-strong); border-radius: var(--r-2); background: var(--white); color: var(--body); font-size: var(--text-2xs); font-weight: 650; }
  .asset-manifesto-future { display: flex; align-items: flex-start; gap: 9px; margin-top: 18px; }
  .asset-manifesto-future .status { flex-shrink: 0; margin-top: 1px; }
  .asset-manifesto-future p { margin: 0; color: var(--muted); font-size: var(--text-2xs); line-height: 1.55; }
  .asset-manifesto-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .asset-manifesto-actions .btn { min-height: var(--tap); }
  @media (max-width: 560px) {
    .asset-manifesto { padding: 20px 16px 18px; }
    .asset-manifesto h2 { font-size: 1.7rem; }
    .asset-manifesto-actions { align-items: stretch; flex-direction: column; }
    .asset-manifesto-actions .btn { width: 100%; }
  }
</style>
