---
import { ArrowRight, Bookmark, Building2, FileText, LockKeyhole, Bell, UserRound, Undo2 } from '@lucide/astro';
import PreviewTabs from '../PreviewTabs.astro';
import type { Corpus } from '../../lib/corpus';
interface Props { kind: string; corpus: Corpus; }
const { kind, corpus }=Astro.props;
const savedExamples=['replacement-cost-vs-market-value','homeowners-earthquake-california','nonrenewal-after-wildfire-moratorium-california'].map(id=>corpus.questionBySlug.get(id)!);
---
<div class="template-columns">
 <div class="template-surface">
  {kind==='contributor'&&<>
   <div class="template-pad"><div class="profile-identity"><div class="profile-avatar"><UserRound size={32} aria-hidden="true"/></div><div><span class="template-kicker">Illustrative profile · not a real person</span><h2>Your name</h2><p class="template-muted">Your specialty and jurisdiction, in your own words.</p><span class="template-pill">No credentials verified</span></div></div><div class="template-actions"><a class="btn btn-primary" href="/contribute?type=research">Prepare a contribution <ArrowRight size={16} aria-hidden="true"/></a><a class="btn btn-quiet" href="/professionals">How contribution works</a></div></div>
   <PreviewTabs id="profile" label="Contributor profile" tabs={[{id:'work',label:'Published work'},{id:'expertise',label:'Expertise'},{id:'disclosures',label:'Disclosures'}]}>
    <section id="profile-work" data-preview-panel><div class="template-empty"><FileText size={30} aria-hidden="true"/><h2>Good work starts with one contribution.</h2><p>Approved research will appear here with its sources, revision history, and author attribution. Nothing has been published for this example profile.</p><a class="btn btn-quiet" href="/contribute?type=research">Preview a research draft</a></div></section>
    <section id="profile-expertise" data-preview-panel class="template-pad"><h2>Show the scope, not just a badge.</h2><dl class="template-facts"><div><dt>Identity</dt><dd>Not checked</dd></div><div><dt>Professional credential</dt><dd>Not submitted</dd></div><div><dt>Jurisdiction and permitted role</dt><dd>Not established</dd></div><div><dt>Last verification date</dt><dd>None</dd></div></dl><p class="template-muted">A real profile will link the issuing authority and credential status, when legally appropriate. A license does not endorse every statement its holder publishes.</p></section>
    <section id="profile-disclosures" data-preview-panel class="template-pad"><h2>Make relationships visible.</h2><p class="template-muted">Employment, company representation, compensation, and other material interests belong beside the contribution. No relationships have been supplied for this illustrative profile.</p><a class="template-context-link" href="/methodology">Read the research standards <ArrowRight size={15} aria-hidden="true"/></a></section>
   </PreviewTabs>
  </>}
  {kind==='saved'&&<PreviewTabs id="library" label="Your library" tabs={[{id:'saved',label:'Saved research'},{id:'following',label:'Following'},{id:'preferences',label:'Preferences'}]}>
   <section id="library-saved" data-preview-panel class="template-pad" data-saved-example><div class="template-section-head"><h2>For later</h2><span class="template-pill">Example collection</span></div><p class="template-muted">Try removing an item. Changes last only while this page is open; nothing is saved to an account.</p>
    {savedExamples.map(q=><div class="template-row" data-saved-row><Bookmark size={18} aria-hidden="true"/><div><h3><a href={`/questions/${q.id}`}>{q.data.question}</a></h3><div class="template-meta"><span>Research</span><span>{q.data.sourceIds.length} source records</span></div></div><button class="btn btn-quiet btn-sm" type="button" data-remove-save aria-label={`Remove ${q.data.question}`}>Remove</button></div>)}
    <div class="template-empty" data-library-empty hidden><Bookmark size={28} aria-hidden="true"/><h2>A little space for what matters.</h2><p>Save useful research as you read. It will be easier to find when the next question comes up.</p><a class="btn btn-quiet" href="/questions">Explore questions</a></div><div class="template-actions"><p class="template-status" role="status" data-saved-status></p><button class="btn btn-quiet btn-sm" type="button" data-undo-save hidden><Undo2 size={15} aria-hidden="true"/>Undo last removal</button></div>
   </section>
   <section id="library-following" data-preview-panel><div class="template-empty"><Bell size={28} aria-hidden="true"/><h2>Follow what you care about.</h2><p>Companies and topics you choose would live here. Following will not automatically enroll you in emails.</p><a class="btn btn-quiet" href="/companies">Browse companies</a></div></section>
   <section id="library-preferences" data-preview-panel class="template-pad"><h2>Quiet by default.</h2><p class="template-muted">Preference specimen only. No email address is collected and no messages are sent.</p><label class="template-choice"><input type="checkbox" data-preference/><span>Research updates<small>A future digest for topics you explicitly follow.</small></span></label><label class="template-choice"><input type="checkbox" data-preference/><span>Replies to your contributions<small>Updates about conversations you take part in.</small></span></label><p class="template-status" role="status" data-preference-status>Both email categories are off in this example.</p></section>
  </PreviewTabs>}
  {kind==='your-coverage'&&<div class="template-pad" data-coverage-flow>
   <div class="template-steps" aria-label="Coverage connection preview"><span data-coverage-progress="start" aria-current="step">1. Understand</span><span data-coverage-progress="consent">2. Choose fields</span><span data-coverage-progress="review">3. Review</span></div>
   <section class="template-step-panel" data-coverage-panel="start"><div class="template-empty"><LockKeyhole size={34} aria-hidden="true"/><h2>A private starting point.</h2><p>A future connection could help organize policy details for your own understanding. Nothing would be posted to a company page automatically.</p><button class="btn btn-primary" type="button" data-coverage-next="consent">Preview shared fields <ArrowRight size={16} aria-hidden="true"/></button></div><div class="template-notice"><LockKeyhole size={18} aria-hidden="true"/><p>No provider is connected. Do not enter policy numbers, credentials, or documents here. This walkthrough collects none of them.</p></div></section>
   <section class="template-step-panel" data-coverage-panel="consent" hidden><h2>Choose what the preview includes.</h2><p class="template-muted">These checkboxes demonstrate the intended consent pattern, not Canopy’s implemented permissions. Everything starts off.</p><label class="template-choice"><input type="checkbox" data-coverage-field value="Company and coverage type"/><span>Company and coverage type<small>Organize the policy under the correct subject.</small></span></label><label class="template-choice"><input type="checkbox" data-coverage-field value="Limits and deductibles"/><span>Limits and deductibles<small>Build a private worksheet for questions to ask a professional.</small></span></label><label class="template-choice"><input type="checkbox" data-coverage-field value="Policy term"/><span>Policy term<small>Put the worksheet in its time context.</small></span></label><p class="template-muted">Public contribution is a separate choice. No names, addresses, policy numbers, or documents appear in this preview.</p><div class="template-actions"><button class="btn btn-primary" type="button" data-coverage-next="review">Review selection <ArrowRight size={16} aria-hidden="true"/></button><button class="btn btn-quiet" type="button" data-coverage-next="cancelled">Cancel</button></div></section>
   <section class="template-step-panel" data-coverage-panel="review" hidden><h2>Only what you chose.</h2><p class="template-muted">Selected categories in this local preview:</p><ul class="template-muted" data-coverage-summary></ul><div class="template-notice"><LockKeyhole size={18} aria-hidden="true"/><p>No policy has been connected. Provider authorization, revocation, deletion, and document-redaction review must be verified before real intake is enabled.</p></div><div class="template-actions"><button class="btn btn-quiet" type="button" data-coverage-next="consent">Edit selection</button><button class="btn btn-quiet" type="button" data-coverage-next="cancelled">Cancel and clear</button></div></section>
   <section class="template-step-panel" data-coverage-panel="cancelled" hidden><div class="template-empty"><LockKeyhole size={30} aria-hidden="true"/><h2>Nothing connected.</h2><p>Your example choices have been cleared. There is no account or policy data to delete.</p><button class="btn btn-quiet" type="button" data-coverage-next="start">Start the preview again</button></div></section>
   <noscript><p class="template-muted">This local walkthrough needs JavaScript. No data is collected without it.</p></noscript>
  </div>}
  {kind==='company-partner'&&<>
   <div class="template-pad"><div class="profile-identity"><div class="profile-avatar"><Building2 size={30} aria-hidden="true"/></div><div><span class="template-kicker">For authorized representatives</span><h2>Be part of the conversation.</h2><p class="template-muted">Add official context without controlling someone else’s experience.</p></div></div></div>
   <PreviewTabs id="partner" label="Company participation" tabs={[{id:'participate',label:'Participation'},{id:'verify',label:'Authorization'},{id:'access',label:'Request access'}]}>
    <section id="partner-participate" data-preview-panel class="template-pad"><h2>A response, with a clear role.</h2><div class="template-mini-grid"><div class="template-mini-card"><h3>Add context</h3><p>Link official forms, explain public processes, and acknowledge what needs a private channel.</p></div><div class="template-mini-card"><h3>Keep accounts independent</h3><p>Representatives cannot edit a customer’s words or decide whether that person’s experience was resolved.</p></div></div><div class="template-notice"><LockKeyhole size={18} aria-hidden="true"/><p>Public replies must not disclose private policy or claims information, even if a customer has shared part of their account.</p></div></section>
    <section id="partner-verify" data-preview-panel class="template-pad"><h2>Verify the permission, not just the email.</h2><dl class="template-facts"><div><dt>Person</dt><dd>Identity and a secured account</dd></div><div><dt>Organization</dt><dd>Exact legal entity and public brand relationship</dd></div><div><dt>Authority</dt><dd>Documented authorization to represent that organization</dd></div><div><dt>Scope</dt><dd>Permitted subjects, expiration, and revocation</dd></div></dl><p class="template-muted">A company badge identifies a role. It is not an endorsement of the company or its response.</p></section>
    <section id="partner-access" data-preview-panel><div class="template-empty"><Building2 size={30} aria-hidden="true"/><h2>Representative access is not open yet.</h2><p>No contact details are collected in this preview. You can inspect the company and response patterns while authorization is being developed.</p><a class="btn btn-primary" href="/companies/farmers-insurance-exchange">View a company page <ArrowRight size={16} aria-hidden="true"/></a><a class="template-context-link" href="/design/thread-preview">See the response template</a></div></section>
   </PreviewTabs>
  </>}
 </div>
 <aside class="template-context" aria-label="Account context"><section><h2>{kind==='your-coverage'?'Private is the starting point.':'Credibility is specific.'}</h2><p>{kind==='your-coverage'?'Connecting a policy, requesting professional help, and publishing an experience are three separate actions. None implies consent to the others.':'Email access, professional licensure, company authority, and a policy relationship are different checks. Show only the role and status actually established.'}</p></section><section><h2>Useful before you join.</h2><p>Research and its citations should be available without signing up once public access launches. Accounts add participation and personal organization.</p><a class="template-context-link" href="/design/account-preview">Preview the account flow <ArrowRight size={15} aria-hidden="true"/></a></section><section><h2>Control stays with you.</h2><p>Future account tools need export, consent history, withdrawal, and deletion paths. This page does not store personal information.</p><a class="template-context-link" href="/privacy">Privacy policy</a></section></aside>
</div>
<script>
 const library=document.querySelector<HTMLElement>('[data-saved-example]');
 if(library){const rows=[...library.querySelectorAll<HTMLElement>('[data-saved-row]')];const removed:HTMLElement[]=[];const undo=library.querySelector<HTMLButtonElement>('[data-undo-save]')!;const update=()=>{library.querySelector<HTMLElement>('[data-library-empty]')!.hidden=rows.some(row=>!row.hidden);undo.hidden=!removed.length;};rows.forEach(row=>row.querySelector('[data-remove-save]')?.addEventListener('click',()=>{row.hidden=true;removed.push(row);update();library.querySelector('[data-saved-status]')!.textContent='Removed from the example collection. No account was changed.';undo.focus();}));undo.addEventListener('click',()=>{const row=removed.pop();if(row){row.hidden=false;row.querySelector<HTMLButtonElement>('button')?.focus();}update();library.querySelector('[data-saved-status]')!.textContent='Restored to the example collection.';});}
 document.querySelectorAll<HTMLInputElement>('[data-preference]').forEach(input=>input.addEventListener('change',()=>{const count=document.querySelectorAll('[data-preference]:checked').length;document.querySelector('[data-preference-status]')!.textContent=`${count} categories selected locally. Preferences are not saved; no email will be sent.`;}));
 const flow=document.querySelector<HTMLElement>('[data-coverage-flow]');
 if(flow){const fields=[...flow.querySelectorAll<HTMLInputElement>('[data-coverage-field]')];const panels=[...flow.querySelectorAll<HTMLElement>('[data-coverage-panel]')];flow.querySelectorAll<HTMLButtonElement>('[data-coverage-next]').forEach(button=>button.addEventListener('click',()=>{const next=button.dataset.coverageNext;if(next==='cancelled')fields.forEach(field=>field.checked=false);if(next==='review'){const selected=fields.filter(field=>field.checked).map(field=>field.value);const list=flow.querySelector('[data-coverage-summary]')!;list.replaceChildren(...(selected.length?selected:['No categories selected.']).map(value=>{const li=document.createElement('li');li.textContent=value;return li;}));}panels.forEach(panel=>panel.hidden=panel.dataset.coveragePanel!==next);flow.querySelectorAll<HTMLElement>('[data-coverage-progress]').forEach(step=>{if(step.dataset.coverageProgress===next)step.setAttribute('aria-current','step');else step.removeAttribute('aria-current');});const heading=panels.find(panel=>!panel.hidden)?.querySelector<HTMLElement>('h2');heading?.setAttribute('tabindex','-1');heading?.focus();}));}
</script>
<style>.profile-identity { display:flex; align-items:center; gap:20px; } .profile-avatar { width:72px; height:72px; flex-shrink:0; display:grid; place-items:center; background:var(--brand-blue-wash); border-radius:var(--r-4); color:var(--brand-blue-text); } .profile-identity h2 { margin:8px 0 0; } .profile-identity p { margin:8px 0 12px; } @media(max-width:640px){.profile-identity { align-items:flex-start; } .profile-avatar { width:48px;height:48px; } [data-saved-row] { flex-wrap:wrap; } [data-saved-row] > div { flex-basis:calc(100% - 40px); } [data-saved-row] > button { margin-left:34px; }}</style>
