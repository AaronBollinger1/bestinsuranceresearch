---
import { FileText, Quote } from '@lucide/astro';
interface Props { sections: { id: string; label: string }[]; sourceCount?: number; }
const { sections,sourceCount } = Astro.props;
---
<div class="record-navigation" data-record-navigation>
  <div class="shell record-navigation-inner"><nav aria-label="Record sections">{sections.map(section=><a href={`#${section.id}`} data-record-section={section.id}>{section.label}</a>)}</nav>
  <div class="record-actions">{sourceCount!==undefined&&<button class="btn btn-quiet btn-sm" type="button" data-open-sources="1" hidden><FileText size={15} aria-hidden="true" />Sources <span>{sourceCount}</span></button>}<a class="btn btn-quiet btn-sm" href="#cite-this-page" data-open-citation><Quote size={15} aria-hidden="true" />Cite</a></div></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-record-navigation]').forEach(navigation=>{
    const links=[...navigation.querySelectorAll<HTMLAnchorElement>('[data-record-section]')];
    const mark=(id:string)=>links.forEach(link=>{if(link.dataset.recordSection===id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current');});
    const fromHash=()=>{const hash=location.hash.slice(1);if(links.some(link=>link.dataset.recordSection===hash)) mark(hash);};
    if(links[0]) mark(links[0].dataset.recordSection||'');
    fromHash(); window.addEventListener('hashchange',fromHash);
    const targets=links.map(link=>document.getElementById(link.dataset.recordSection||'')).filter((item): item is HTMLElement=>Boolean(item));
    if('IntersectionObserver' in window){
      const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(visible[0]) mark(visible[0].target.id);},{rootMargin:'-130px 0px -55% 0px',threshold:0});
      targets.forEach(target=>observer.observe(target));
    }
    navigation.querySelector('[data-open-citation]')?.addEventListener('click',()=>{
      const disclosure=document.getElementById('cite-this-page'); if(disclosure instanceof HTMLDetailsElement) disclosure.open=true;
    });
  });
</script>
<style>
 .record-navigation { position: sticky; top: var(--header-h); z-index: 25; border-block: 1px solid var(--line); background: var(--paper); }
 .record-navigation-inner { display:flex; align-items:center; gap:20px; }
 .record-navigation nav { display:flex; gap:24px; min-width:0; overflow-x:auto; scrollbar-width:thin; }
 .record-navigation nav a { display:inline-flex; align-items:center; min-height:56px; border-bottom:2px solid transparent; color:var(--muted); font-size:var(--text-sm); text-decoration:none; white-space:nowrap; }
 .record-navigation nav a:hover,.record-navigation nav a[aria-current] { color:var(--brand-blue-text); border-color:var(--brand-blue); }
 .record-actions { margin-left:auto; display:flex; flex-shrink:0; gap:4px; }
 .record-actions [hidden] { display:none; }
 .record-actions .btn { color:var(--muted); }
 .record-actions span { color:var(--faint); font-size:var(--text-xs); }
 @media(max-width:640px) { .record-navigation-inner { flex-wrap:wrap; gap:0; } .record-navigation nav { width:100%; gap:20px; } .record-navigation nav a { min-height:48px; font-size:var(--text-xs); } .record-actions { display:none; } }
 @media print { .record-navigation { display:none; } }
</style>
