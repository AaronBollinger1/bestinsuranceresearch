---
interface Props { title: string; eyebrow: string; description?: string; }
const { title, eyebrow, description } = Astro.props;
---
<header class="focus-page-header">
  <span class="focus-page-eyebrow">{eyebrow}</span>
  <h1>{title}</h1>
  {description && <p>{description}</p>}
  {Astro.slots.has('default') && <div class="focus-page-actions"><slot /></div>}
</header>
<style>
  .focus-page-header { max-width: 760px; margin: auto; padding: 44px 0 36px; text-align: center; }
  .focus-page-eyebrow { color: var(--brand-blue-text); font-size: var(--text-xs); font-weight: 600; }
  h1 { margin: 16px 0; font: 600 clamp(2.3rem, 4.6vw, 3.5rem)/1.09 var(--font-sans); letter-spacing: -.055em; text-wrap: balance; }
  p { max-width: 52ch; margin: 0 auto; color: var(--muted); font-size: var(--text-md); line-height: var(--leading-prose); text-wrap: pretty; }
  .focus-page-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 640px) { .focus-page-header { padding-block: 28px; } h1 { font-size: 2.3rem; } p { font-size: var(--text-sm); } }
</style>
