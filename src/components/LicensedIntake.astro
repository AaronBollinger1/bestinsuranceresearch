---
import { Mail, Phone } from '@lucide/astro';
import { siteConfig } from '../config/site';
import { handoffActions } from '../lib/handoff';

interface Props {
	pageType?: string;
	/** One named nav per page. Extra placements stay in the parent landmark. */
	landmark?: string;
}

const { pageType = 'editorial', landmark } = Astro.props;
const actions = handoffActions({ sourcePath: Astro.url.pathname, family: 'general' });
const track = {
	'data-event': 'bollinsure_handoff_clicked',
	'data-insurance-family': 'general',
	'data-page-type': pageType,
};
const Tag = landmark ? 'nav' : 'div';
---

<Tag class="licensed-intake" aria-label={landmark}>
	<a href={actions.call} {...track}>
		<Phone size={15} aria-hidden="true" /> Call {siteConfig.contact.phoneDisplay}
	</a>
	<a href={actions.quote} {...track}>Request a quote</a>
	<a href={actions.email} {...track}>
		<Mail size={15} aria-hidden="true" /> Email
	</a>
</Tag>
