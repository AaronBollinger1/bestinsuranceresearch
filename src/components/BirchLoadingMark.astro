---
/**
 * Birch's loading mark for the local research lookup.
 *
 * The approved bird asset is intentionally used as-is. The orbit is interface
 * chrome around the mark, not a redraw of it: the bird stays still enough to
 * read while the moving point communicates that source resolution is active.
 */
interface Props {
	size?: number;
	label?: string | null;
}

const { size = 96, label = 'Checking sources' } = Astro.props;
---

<div
	class="birch-loading-mark"
	style={`--birch-mark-size: ${size}px`}
	role={label ? 'img' : undefined}
	aria-label={label ?? undefined}
	aria-hidden={label ? undefined : 'true'}
>
	<span class="birch-loading-orbit" aria-hidden="true">
		<span class="birch-loading-orbit-dot"></span>
		<img src="/birch-bird-transparent.png" width={size} height={size} alt="" />
	</span>
</div>

<style>
	.birch-loading-mark {
		display: grid;
		place-items: center;
		width: var(--birch-mark-size);
		height: var(--birch-mark-size);
		flex: none;
	}

	.birch-loading-orbit {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--birch-mark-size);
		height: var(--birch-mark-size);
		border: 1px solid color-mix(in srgb, var(--brand-blue) 24%, var(--line-strong));
		border-radius: 50%;
	}

	.birch-loading-orbit::before {
		position: absolute;
		inset: 10%;
		border: 1px dashed color-mix(in srgb, var(--brand-blue) 52%, transparent);
		border-radius: 50%;
		content: '';
	}

	.birch-loading-orbit-dot {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--brand-blue);
		transform: translate(-50%, -50%) rotate(0deg) translateX(calc(var(--birch-mark-size) * .45));
	}

	.birch-loading-mark img {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		max-width: 64%;
		max-height: 64%;
		object-fit: contain;
		filter: drop-shadow(0 8px 16px rgba(13, 42, 82, .12));
	}

	@media (prefers-reduced-motion: no-preference) {
		.birch-loading-orbit-dot {
			animation: birch-source-orbit 1.6s cubic-bezier(.4, 0, .2, 1) infinite;
		}
	}

	@keyframes birch-source-orbit {
		from { transform: translate(-50%, -50%) rotate(0deg) translateX(calc(var(--birch-mark-size) * .45)); }
		to { transform: translate(-50%, -50%) rotate(360deg) translateX(calc(var(--birch-mark-size) * .45)); }
	}
</style>
