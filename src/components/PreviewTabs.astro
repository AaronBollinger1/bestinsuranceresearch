---
interface Props { id: string; label: string; tabs: Array<{ id: string; label: string }>; }
const { id, label, tabs } = Astro.props;
---
<div class="preview-tabs" data-preview-tabs={id}>
  <nav class="template-tabs" aria-label={label}>{tabs.map(tab => <a id={`${id}-tab-${tab.id}`} href={`#${id}-${tab.id}`} data-preview-tab={tab.id}>{tab.label}</a>)}</nav>
  <slot />
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-preview-tabs]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-preview-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > [data-preview-panel]')];
    if (!tabs.length || panels.length !== tabs.length || tabs.some(tab => !panels.some(panel => panel.id === tab.hash.slice(1)))) return;
    root.querySelector('nav')?.setAttribute('role','tablist');
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex = i===index ? 0 : -1; });
      panels.forEach(panel => { panel.hidden = panel.id !== tabs[index].hash.slice(1); });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab,index) => {
      tab.setAttribute('role','tab'); tab.setAttribute('aria-controls',tab.hash.slice(1));
      const panel = panels.find(panel => panel.id === tab.hash.slice(1))!;
      panel.setAttribute('role','tabpanel'); panel.setAttribute('aria-labelledby',tab.id); panel.tabIndex=0;
      tab.addEventListener('click',event => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); activate(index); });
      tab.addEventListener('keydown',event => { const target = event.key==='ArrowRight'?(index+1)%tabs.length:event.key==='ArrowLeft'?(index+tabs.length-1)%tabs.length:event.key==='Home'?0:event.key==='End'?tabs.length-1:-1; if(target<0) return; event.preventDefault(); activate(target,true); });
    });
    const initial = tabs.findIndex(tab => tab.hash === window.location.hash);
    activate(initial < 0 ? 0 : initial);
  });
</script>
