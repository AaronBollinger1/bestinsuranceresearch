---
import { Info, Lock, ScrollText, TriangleAlert } from '@lucide/astro';

interface Props {
	tone?: 'note' | 'limit' | 'warn' | 'privacy';
	label?: string;
}

const { tone = 'note', label } = Astro.props;
const icon = { size: 18, 'stroke-width': 2, 'aria-hidden': 'true' } as const;
const defaultLabel = {
	note: 'Note',
	limit: 'What this does not do',
	warn: 'Read this before you rely on it',
	privacy: 'Privacy',
}[tone];
---

{/*
	role="note", not <aside>. A named <aside> is a complementary landmark, so
	every inline caveat was being announced as a region of the page: a reader
	pulling up the landmark list got "Privacy", "Read this before you rely on
	it", "Privacy" again, rather than the handful of regions the page actually
	has. These are parenthetical notes sitting in the prose, which is what
	role="note" describes. The name still carries, so the note announces what
	kind of note it is; it just no longer claims to be a landmark.
*/}
<div class={`callout callout-${tone}`} role="note" aria-label={label ?? defaultLabel}>
	{tone === 'note' && <Info {...icon} />}
	{tone === 'limit' && <ScrollText {...icon} />}
	{tone === 'warn' && <TriangleAlert {...icon} />}
	{tone === 'privacy' && <Lock {...icon} />}
	<div>
		<slot />
	</div>
</div>
