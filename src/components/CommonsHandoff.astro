---
import { ArrowRight } from '@lucide/astro';
import Callout from './Callout.astro';
import { siteConfig } from '../config/site';

interface Props {
	href: string;
}

const { href } = Astro.props;
---

<!--
	`id="commons"` is the target the record navigation and the on-page contents
	both link to. Without it those two entries were links to nowhere, and the
	scroll-spy in RecordNavigation dropped the section entirely, because it
	resolves each nav item with getElementById and filters out the misses.
-->
<section id="commons" class="answer-section commons-handoff" aria-labelledby="commons-handoff-title">
	<h2 id="commons-handoff-title">Continue the conversation in Community</h2>
	<Callout tone="note">
		<p>
			Research is the citable record. Community is where people can add a clearly labeled experience or
			question about this subject. Posts are moderated and do not change the research answer.
		</p>
		{
			siteConfig.communityReady ? (
				<a class="btn btn-secondary btn-sm" href={href} rel="noopener">
					Open discussions about this subject <ArrowRight size={15} aria-hidden="true" />
				</a>
			) : (
				<p class="commons-handoff-status">
					<strong>Community is in private preview.</strong> The discussion layer will open after its
					deployment, database, mail delivery, and moderation gate are ready.
				</p>
			)
		}
	</Callout>
</section>
